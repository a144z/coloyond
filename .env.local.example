# Template for the gitignored `.env.local` at the repository root, read by
# tools/rebalancing/env.mjs. Copy over `.env.local`, keep the keypair out of
# the commit, and fill it in with a Devnet-funded signer. A value already
# present in the real environment wins over the file.
RPC_NODES=https://api.devnet.solana.com,https://api.mainnet-beta.solana.com
RPC_DEVNET=https://api.devnet.solana.com
RPC_MAINNET=https://api.mainnet-beta.solna.com
PROGRAM_ID=FN7uGX34qyijmVX69gqEkMugWjE5Sjso8Pe7gWU6B2N6
VAULT=
KEYPAIR_JSON=
MAX_ROUNDS=1
INTERVAL_MS=85
