{
  "name": "coloyond",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "coloyond · private autonomous vault on Solana devnet (mobile-first React app)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:price": "node --test scripts/price-availability.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "gen:keys": "node scripts/generate-demo-keys.mjs",
    "bootstrap:reserve": "node scripts/bootstrap-reserve.mjs",
    "deploy:execution": "node scripts/deploy-execution-program.mjs",
    "bootstrap:execution-reserve": "node scripts/bootstrap-execution-reserve.mjs",
    "bootstrap:devnet-test-usd": "node scripts/bootstrap-devnet-test-usd.mjs",
    "bootstrap:standard-rebalance-vault": "node scripts/bootstrap-standard-rebalance-vault.mjs",
    "canary:standard-ata": "node scripts/canary-read-standard-ata.mjs",
    "schedule:standard-vault": "node scripts/schedule-standard-vault.mjs",
    "smoke:closed-loop": "node scripts/smoke-closed-loop.mjs",
    "smoke:closed-loop:self-check": "node scripts/smoke-closed-loop.mjs --self-check",
    "crank:standard-vault": "node scripts/run-standard-vault-cranker.mjs",
    "crank:vaults": "node scripts/run-vault-cranker.mjs",
    "crank:vaults:self-check": "node scripts/run-vault-cranker.mjs --self-check",
    "crank:service": "node scripts/run-hydra-cranker-fleet.mjs",
    "crank:service:self-check": "node scripts/run-hydra-cranker-fleet.mjs --self-check",
    "crank:service:test": "node --test scripts/run-hydra-cranker-fleet.test.mjs",
    "crank:service:validate-config": "node scripts/run-hydra-cranker-fleet.mjs --validate-config",
    "crank:service:install-agent": "node scripts/install-cranker-launch-agent.mjs",
    "crank:service:agent:self-check": "node scripts/install-cranker-launch-agent.mjs --self-check",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@magicblock-labs/ephemeral-rollups-sdk": "^0.16.2",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
