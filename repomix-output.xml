            { kind: "swap", protocol: "Curve Pool", fromChainId: 1, toChainId: 10, fromSymbol: "crvUSD", toSymbol: "USDC", etaSeconds: 30, feeUsd: 0 },
          ],
          outputAmount: "1847200000",
