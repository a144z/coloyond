                <span class="proof-bounds">Delta: USDC -0.18% / JUP +0.18%</span>
                <span class="proof-verdict">
                  <span class="status-swatch swatch-petrol" aria-hidden="true"></span>
                  State: Verified
                </span>
              </li>
              <!-- Item 3 -->
              <li class="proof-entry">
                <span class="proof-slot">Slot 2983501</span>
                <span class="proof-hash" title="Click to inspect proof receipt">0x99A8...B21F</span>
                <span class="proof-bounds">Delta: SOL +0.30% / USDC -0.30%</span>
                <span class="proof-verdict">
                  <span class="status-swatch swatch-petrol" aria-hidden="true"></span>
                  State: Verified
                </span>
              </li>
            </ul>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- UNIFIED SYSTEM FOOTER -->
  <footer class="coloyond-footer" role="contentinfo">
    <div class="footer-inner">
      <div>
        <strong>coloyond</strong> // Solana Ephemeral Rollup Engine. One Owner. No Third Parties.
      </div>
      <div>
        Status: Strict Autonomous Equivalence — All Actions Owner-Signed
      </div>
    </div>
  </footer>

  <!-- MINIMAL COMPONENT LOGIC -->
  <script>
    (function () {
      'use strict';

      // Spine Item Active Tracking on Scroll
      const navLinks = document.querySelectorAll('.spine-item');
      const sections = ['section-01', 'section-02', 'section-03', 'section-04'].map(id => document.getElementById(id));

      window.addEventListener('scroll', () => {
        let currentSectionId = '';
        sections.forEach(sec => {
          if (!sec) return;
          const rect = sec.getBoundingClientRect();
          if (rect.top <= 140 && rect.bottom >= 140) {
            currentSectionId = sec.id;
          }
        });

        if (currentSectionId) {
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === '#' + currentSectionId) {
              link.classList.add('is-active');
            } else {
              link.classList.remove('is-active');
            }
          });
        }
      }, { passive: true });

      // Target Weight Sliders Normalization Feedback
      const rangeSol = document.getElementById('range-sol');
      const rangeJup = document.getElementById('range-jup');
      const rangeUsdc = document.getElementById('range-usdc');
      const valSol = document.getElementById('val-sol');
      const valJup = document.getElementById('val-jup');
      const valUsdc = document.getElementById('val-usdc');
      const sumIndicator = document.getElementById('weight-sum-indicator');
      const saveBtn = document.getElementById('save-weights-btn');

      function updateSums() {
        const s = parseInt(rangeSol.value, 10);
        const j = parseInt(rangeJup.value, 10);
        const u = parseInt(rangeUsdc.value, 10);
        
        valSol.textContent = s + '%';
        valJup.textContent = j + '%';
        valUsdc.textContent = u + '%';

        const total = s + j + u;
        sumIndicator.textContent = 'Assigned Sum: ' + total + '%';

        if (total === 100) {
          sumIndicator.style.color = 'var(--lacquer-ink)';
          saveBtn.disabled = false;
          saveBtn.style.opacity = '1';
        } else {
          sumIndicator.style.color = 'var(--lacquer-amber)';
          saveBtn.disabled = true;
          saveBtn.style.opacity = '0.7';
        }
      }

      [rangeSol, rangeJup, rangeUsdc].forEach(input => {
        input.addEventListener('input', updateSums);
      });

      // Simulation: Trigger Bounded Crank
      const crankBtn = document.getElementById('trigger-crank-btn');
      const proofList = document.getElementById('proof-log-list');

      crankBtn.addEventListener('click', () => {
        crankBtn.disabled = true;
        crankBtn.textContent = 'EXECUTING ROLLUP...';

        setTimeout(() => {
          const newSlot = 2984102 + Math.floor(Math.random() * 50) + 1;
          const hashHex = '0x' + Array.from({length: 4}, () => Math.floor(Math.random() * 16).toString(16).toUpperCase()).join('') + '...' +
                          Array.from({length: 4}, () => Math.floor(Math.random() * 16).toString(16).toUpperCase()).join('');

          const li = document.createElement('li');
          li.className = 'proof-entry';
          li.innerHTML = `
            <span class="proof-slot">Slot ${newSlot}</span>
            <span class="proof-hash" title="Click to inspect proof receipt">${hashHex}</span>
            <span class="proof-bounds">Delta: JUP +0.12% / SOL -0.12%</span>
            <span class="proof-verdict">
              <span class="status-swatch swatch-petrol" aria-hidden="true"></span>
              State: Verified
            </span>
          `;
          proofList.insertBefore(li, proofList.firstChild);

          crankBtn.disabled = false;
          crankBtn.innerHTML = '<span>RUN BOUNDED CRANK</span> <span aria-hidden="true">→</span>';
        }, 750);
      });

      // Simulation: Revocation Interaction
      const revokeBtn = document.getElementById('revoke-btn');
      revokeBtn.addEventListener('click', () => {
        const confirmRevoke = confirm('REVOKE CRANK DELEGATION?\n\nThis will immediately strip the Ephemeral Rollup crank of signing bounds and return all execution authority exclusively to manual owner keys.');
        if (confirmRevoke) {
          revokeBtn.textContent = 'DELEGATION REVOKED';
          revokeBtn.style.borderColor = 'var(--lacquer-amber)';
          revokeBtn.disabled = true;
        }
      });

      // Simulation: Sign New Weights
      saveBtn.addEventListener('click', () => {
        saveBtn.textContent = 'TRANSACTION COMMITTED ✓';
        setTimeout(() => {
          saveBtn.innerHTML = '<span>SIGN NEW WEIGHT VECTOR</span> <span aria-hidden="true">✓</span>';
        }, 2000);
      });
    })();
  </script>
</body>
</html>
