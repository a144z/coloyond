<file path="coloyond-beta/src/lib/solana/coinbase.ts">
/**
 * The Coinbase universe: asset discovery and batched pricing from the
 * public, CORS-open Coinbase Exchange API (no key, devnet-friendly).
 *
 * Two calls drive the extended asset registry:
 *   GET /currencies  — every listed currency (id, name, status, type)
 *   GET /products    — every trading pair (used to require a live USD market)
 *
 * One call prices the whole universe:
 *   GET /products/stats — 24h stats per pair; `stats_24hour.last` is a
 *   full-precision USD mid, keyed 'DOGE-USD' style, ~400 USD pairs in one
 *   response.
 */

/** A Coinbase-listed asset, normalized for the registry. `id` is the lowercase currency code. */
export interface UniverseAsset {
  id: string;
  symbol: string;
  name: string;
}

/**
 * Coinbase assets already represented by the demo's core stand-ins: picking
 * "Bitcoin" uses the tBTC rails, "Solana" wraps into WSOL, the demo dollar
 * covers USDC/USDT/DAI. Kept out of the extended list so the picker never
 * offers two assets with the same price and the same mint.
 */
export const ALIASED_COINBASE_IDS: readonly string[] = ['sol', 'btc', 'eth', 'usdc', 'usdt', 'dai'];

interface CoinbaseCurrency {
  id: string;
  name: string;
  display_name?: string | null;
  status?: string;
  details?: { type?: string } | null;
}

interface CoinbaseProduct {
  id: string;
  base_currency?: string;
  quote_currency?: string;
  status?: string;
}

/** Every online Coinbase crypto asset with an active USD market, sorted by symbol. */
export async function fetchCoinbaseUniverse(): Promise<UniverseAsset[]> {
  const [currencies, products] = await Promise.all([
    fetchJson<CoinbaseCurrency[]>('https://api.exchange.coinbase.com/currencies'),
    fetchJson<CoinbaseProduct[]>('https://api.exchange.coinbase.com/products'),
  ]);

  const usdBases = new Set(
    products
      .filter((p) => p.status === 'online' && p.quote_currency === 'USD')
      .map((p) => (p.base_currency ?? p.id.split('-')[0]).toLowerCase()),
  );

  const universe: UniverseAsset[] = [];
  for (const c of currencies) {
    if (c.status !== 'online') continue;
    if (c.details?.type !== 'crypto') continue;
    const id = c.id.toLowerCase();
    if (!usdBases.has(id) || ALIASED_COINBASE_IDS.includes(id)) continue;
    universe.push({ id, symbol: (c.display_name || c.id).toUpperCase(), name: c.name });
  }
  universe.sort((a, b) => a.symbol.localeCompare(b.symbol));
  return universe;
}

/** One batched call: USD mid per pair for the whole universe, or null when the feed is down. */
export async function fetchCoinbaseStats(): Promise<Record<string, number> | null> {
  try {
    const res = await fetch('https://api.exchange.coinbase.com/products/stats', { cache: 'no-store' });
    if (!res.ok) return null;
    const json = (await res.json()) as Record<string, { stats_24hour?: { last?: string } } | undefined>;
    const out: Record<string, number> = {};
    for (const [pair, s] of Object.entries(json)) {
      if (!pair.endsWith('-USD')) continue;
      const last = Number(s?.stats_24hour?.last);
      if (Number.isFinite(last) && last > 0) out[pair] = last;
    }
    return Object.keys(out).length > 0 ? out : null;
  } catch {
    return null;
  }
}

async function fetchJson<T>(url: string): Promise<T> {
  const res = await fetch(url, { cache: 'no-store' });
  if (!res.ok) throw new Error(`coinbase ${url.split('/').pop()} returned ${res.status}`);
  return (await res.json()) as T;
}
</file>

<file path="coloyond-beta/src/lib/solana/derivation.ts">
import { hmac } from '@noble/hashes/hmac.js';
import { sha512 } from '@noble/hashes/sha2.js';

/**
 * SLIP-0010 hierarchical derivation for ed25519 (the scheme behind
 * Solana's m/44'/501'/0'/0' paths used by Phantom and Solflare).
 * Implemented directly so it runs in the browser with no node polyfills.
 */

const ED25519_CURVE = new TextEncoder().encode('ed25519 seed');
const HARDENED_OFFSET = 0x80000000;

export const SOLANA_DERIVATION_PATH = "m/44'/501'/0'/0'";

export function deriveEd25519Path(seed: Uint8Array, path: string): Uint8Array {
  const segments = path.split('/');
  if (segments[0] !== 'm' || segments.length < 2) {
    throw new Error('invalid derivation path');
  }

  let i = hmac(sha512, ED25519_CURVE, seed);
  let key = i.slice(0, 32);
  let chainCode = i.slice(32);

  for (const segment of segments.slice(1)) {
    if (!segment.endsWith("'")) {
      throw new Error('ed25519 derivation requires hardened segments');
    }
    const index = Number.parseInt(segment.slice(0, -1), 10);
    if (!Number.isInteger(index) || index < 0 || index >= HARDENED_OFFSET) {
      throw new Error(`invalid derivation segment: ${segment}`);
    }

    const data = new Uint8Array(1 + 32 + 4);
    data[0] = 0x00;
    data.set(key, 1);
    new DataView(data.buffer).setUint32(33, HARDENED_OFFSET + index, false);

    i = hmac(sha512, chainCode, data);
    key = i.slice(0, 32);
    chainCode = i.slice(32);
  }

  return key;
}
</file>

<file path="coloyond-beta/src/lib/solana/reserve-quote.ts">
import type { Balances } from './wallet';
import { CURVE_BASE_PCT, CURVE_CAP_PCT, CURVE_DEPTH_FRACTION, RESERVE_SPREAD_PCT } from './config';
import { assetList, assetSpec, type AssetId } from './assets';

export interface SwapQuote {
  inAsset: AssetId;
  outAsset: AssetId;
  inRaw: number;
  outRaw: number;
  inUsd: number;
  outUsd: number;
  effectivePrice: number;
  spreadPct: number;
  curvePct: number;
  totalFeePct: number;
  reserveInRaw: number;
  reserveOutRaw: number;
}

export class ReserveInventoryError extends Error {
  constructor(needed: string, available: string) {
    super(`reserve inventory insufficient: needs ${needed}, holds ${available}`);
    this.name = 'ReserveInventoryError';
  }
}

export function reserveDepthUsd(reserve: Balances, prices: Record<string, number>): number {
  return assetList().reduce((depth, spec) => {
    const price = prices[spec.id];
    return depth + (price ? ((reserve.tokens[spec.id] ?? 0) / 10 ** spec.decimals) * price : 0);
  }, 0);
}

export function quoteSwap(params: {
  inAsset: AssetId;
  outAsset: AssetId;
  inRaw: number;
  prices: Record<string, number>;
  reserve: Balances;
}): SwapQuote {
  const { inAsset, outAsset, inRaw, prices, reserve } = params;
  if (inAsset === outAsset) throw new Error('cannot swap an asset into itself');
  if (inRaw <= 0) throw new Error('swap amount must be positive');
  const input = assetSpec(inAsset);
  const output = assetSpec(outAsset);
  const inPrice = prices[inAsset];
  const outPrice = prices[outAsset];
  if (!inPrice || !outPrice) throw new Error(`missing live price for ${input.symbol} or ${output.symbol}`);
  const inUsd = (inRaw / 10 ** input.decimals) * inPrice;
  const depth = reserveDepthUsd(reserve, prices);
  const curvePct = depth > 0 ? Math.min(CURVE_CAP_PCT, (CURVE_BASE_PCT * inUsd) / (depth * CURVE_DEPTH_FRACTION)) : CURVE_CAP_PCT;
  const totalFeePct = RESERVE_SPREAD_PCT + curvePct;
  const outUsd = inUsd * (1 - totalFeePct / 100);
  const outRaw = Math.floor((outUsd / outPrice) * 10 ** output.decimals);
  const reserveOutRaw = reserve.tokens[outAsset] ?? 0;
  if (outRaw > reserveOutRaw) {
    throw new ReserveInventoryError(
      `${(outRaw / 10 ** output.decimals).toFixed(output.decimals === 6 ? 2 : 6)} ${output.symbol}`,
      `${(reserveOutRaw / 10 ** output.decimals).toFixed(output.decimals === 6 ? 2 : 6)} ${output.symbol}`,
    );
  }
  const inUnits = inRaw / 10 ** input.decimals;
  return {
    inAsset, outAsset, inRaw, outRaw, inUsd, outUsd,
    effectivePrice: inUnits > 0 ? outRaw / 10 ** output.decimals / inUnits : 0,
    spreadPct: RESERVE_SPREAD_PCT, curvePct, totalFeePct,
    reserveInRaw: reserve.tokens[inAsset] ?? 0, reserveOutRaw,
  };
}
</file>

