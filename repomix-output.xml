                    )
                    gross_custody_floor = exact_curve_max_output(
                        balance_in, balance_out, weight_in, weight_out, amount_in, 0
                    )
                    yield (
                        balance_in,
                        balance_out,
                        weight_in,
                        weight_out,
                        amount_in,
                        fee_bps,
