"""Matched-USD-notional three-asset mark-move sensitivity; synthetic only."""

from __future__ import annotations

import csv
from decimal import Decimal, ROUND_HALF_EVEN, localcontext
from itertools import product
from pathlib import Path

from three_asset_sensitivity import quote_weighted_exact_in

PRECISION = 50
BPS = Decimal(10_000)
ASSETS = ("SOL", "BTC", "USDC")
RESERVES = (Decimal("400"), Decimal("0.8"), Decimal("20000"))
PRICES_USD = (Decimal("100"), Decimal("50000"), Decimal("1"))
WEIGHTS_BPS = (4000, 4000, 2000)
INITIAL_NAV_USD = Decimal("100000")
TRADE_NOTIONAL_NAV_BPS = (10, 25, 50, 100, 200, 500)
FEES_BPS = (5, 30, 100)
MOVES_BPS = (10, 100, 500)
DIRECTIONS = ("output_appreciates", "input_depreciates")
MAX_INPUT_RESERVE_BPS = 3000
OUTPUT = Path(__file__).with_name("weighted_matched_notional_mark_move_results.csv")


def scenario(
    input_index: int,
    output_index: int,
    notional_nav_bps: int,
    fee_bps: int,
    relative_move_bps: int,
    direction: str,
) -> dict[str, Decimal]:
    if type(input_index) is not int or type(output_index) is not int or not (
        0 <= input_index < 3 and 0 <= output_index < 3 and input_index != output_index
    ):
        raise ValueError("input and output indexes must be distinct values from 0 through 2")
    if type(notional_nav_bps) is not int or notional_nav_bps not in TRADE_NOTIONAL_NAV_BPS:
        raise ValueError("notional_nav_bps must be one of the configured finite sizes")
    if type(fee_bps) is not int or fee_bps not in FEES_BPS:
        raise ValueError("fee_bps must be one of the configured candidate fees")
    if type(relative_move_bps) is not int or relative_move_bps not in MOVES_BPS:
        raise ValueError("relative_move_bps must be one of the configured finite moves")
    if direction not in DIRECTIONS:
        raise ValueError("direction must be output_appreciates or input_depreciates")

    with localcontext() as ctx:
        ctx.prec = PRECISION
        ctx.rounding = ROUND_HALF_EVEN
        notional_usd = INITIAL_NAV_USD * Decimal(notional_nav_bps) / BPS
        amount_in = notional_usd / PRICES_USD[input_index]
        input_reserve_bps = amount_in * BPS / RESERVES[input_index]
        if input_reserve_bps > MAX_INPUT_RESERVE_BPS:
            raise ValueError("matched notional exceeds the candidate 30% input-reserve cap")

        amount_out = quote_weighted_exact_in(
            RESERVES, WEIGHTS_BPS, input_index, output_index, amount_in, fee_bps
        )
        fee_amount = amount_in * Decimal(fee_bps) / BPS
        marked_prices = list(PRICES_USD)
        move = Decimal(relative_move_bps) / BPS
        shocked_index = output_index if direction == "output_appreciates" else input_index
        marked_prices[shocked_index] *= (
            Decimal(1) + move if direction == "output_appreciates" else Decimal(1) - move
        )

        input_value_after_shock = amount_in * marked_prices[input_index]
        output_value_after_shock = amount_out * marked_prices[output_index]
        fee_value_after_shock = fee_amount * marked_prices[input_index]
        return {
            "notional_usd_before_shock": +notional_usd,
            "amount_in": +amount_in,
            "amount_out": +amount_out,
            "input_reserve_bps": +input_reserve_bps,
            "fee_amount_input_token": +fee_amount,
            "input_price_usd_after_shock": +marked_prices[input_index],
            "fee_value_usd_after_shock": +fee_value_after_shock,
            "input_value_usd_after_shock": +input_value_after_shock,
            "output_value_usd_after_shock": +output_value_after_shock,
            "trader_mark_pnl_usd": +(output_value_after_shock - input_value_after_shock),
            "pool_swap_leg_mark_change_usd": +(input_value_after_shock - output_value_after_shock),
        }


def sensitivity_rows() -> list[dict[str, str]]:
    rows = []
    with localcontext() as ctx:
        ctx.prec = PRECISION
        ctx.rounding = ROUND_HALF_EVEN
        for input_index, output_index, notional, fee, move, direction in product(
            range(3), range(3), TRADE_NOTIONAL_NAV_BPS, FEES_BPS, MOVES_BPS, DIRECTIONS
        ):
            if input_index == output_index:
                continue
            result = scenario(input_index, output_index, notional, fee, move, direction)
            rows.append({
                "input_asset": ASSETS[input_index],
                "output_asset": ASSETS[output_index],
                "trade_notional_nav_bps": str(notional),
                "fee_bps": str(fee),
                "relative_move_bps": str(move),
                "direction": direction,
                **{key: format(value, "f") for key, value in result.items()},
            })
    return rows


def write_results(path: Path, rows: list[dict[str, str]]) -> None:
    with path.open("w", newline="") as stream:
        writer = csv.DictWriter(stream, fieldnames=list(rows[0]), lineterminator="\n")
        writer.writeheader()
        writer.writerows(rows)


def main() -> None:
    rows = sensitivity_rows()
    write_results(OUTPUT, rows)
    print(f"wrote {len(rows)} hypothetical matched-notional rows to {OUTPUT.name}")


if __name__ == "__main__":
    main()
</file>

<file path="tools/rebalancing/etf-economics/withdrawal_floor_sensitivity.py">
"""Cross price-mark shocks with integer-base-unit pro-rata withdrawals.

This finite model uses synthetic classic-SPL reserves and integer share units.
It is accounting sensitivity only; no oracle policy, transfer fee, Anchor/CPI
behavior, or production mint configuration is implied.
"""

from __future__ import annotations

import csv
from decimal import Decimal, localcontext
from fractions import Fraction
from itertools import product
from pathlib import Path

from in_kind_floor_sensitivity import (
    ASSETS,
    REDEEMED_SHARE_UNITS,
    RESERVE_SCENARIOS,
    TOTAL_SHARE_UNITS,
    U64_MAX,
)


BPS = 10_000
ASSET_PRICES_USD = (1, 50_000, 100)  # USDC, BTC, SOL
SHOCKS_BPS = (-5_000, -1_000, 1_000, 5_000)
FULL_EXIT_SHARE_UNITS = TOTAL_SHARE_UNITS
OUTPUT = Path(__file__).with_name("withdrawal_floor_sensitivity_results.csv")


def _validate(
    reserve_units: tuple[int, int, int],
    decimals: tuple[int, int, int],
    prices_usd: tuple[int, int, int],
    total_share_units: int,
    burned_share_units: int,
    shocked_asset_index: int,
    shock_bps: int,
) -> None:
    if len(reserve_units) != 3 or any(
        type(value) is not int or not 0 <= value <= U64_MAX for value in reserve_units
    ):
        raise ValueError("reserve_units must contain three u64 values")
    if decimals != tuple(places for _, places in ASSETS):
        raise ValueError("decimals must match USDC/BTC/SOL asset order (6/8/9)")
    if len(prices_usd) != 3 or any(type(value) is not int or value <= 0 for value in prices_usd):
        raise ValueError("prices_usd must contain three positive integer marks")
    if type(total_share_units) is not int or not 0 < total_share_units <= U64_MAX:
        raise ValueError("total_share_units must be a positive u64")
    if type(burned_share_units) is not int or not 0 < burned_share_units <= total_share_units:
        raise ValueError("burned_share_units must be in (0, total_share_units]")
    if type(shocked_asset_index) is not int or not 0 <= shocked_asset_index < 3:
        raise ValueError("shocked_asset_index must be an integer from 0 through 2")
    if type(shock_bps) is not int or not -9_000 <= shock_bps <= 10_000:
        raise ValueError("shock_bps must be an integer in [-9000, 10000]")


def _decimal_text(value: Fraction | None) -> str:
    if value is None:
        return "n/a"
    with localcontext() as context:
        context.prec = 100
        decimal = Decimal(value.numerator) / Decimal(value.denominator)
        rendered = format(decimal, "f")
    if "." in rendered:
        rendered = rendered.rstrip("0").rstrip(".")
    return rendered or "0"


def withdrawal_scenario(
    reserve_units: tuple[int, int, int],
    decimals: tuple[int, int, int],
    prices_usd: tuple[int, int, int],
    total_share_units: int,
    burned_share_units: int,
    shocked_asset_index: int,
    shock_bps: int,
) -> dict[str, object]:
    """Apply one independent asset mark shock, then floor each token payout.

    A final full-supply burn returns every remaining base unit. Partial burns
    use the exact integer floor independently for each asset.
    """
    _validate(
        reserve_units, decimals, prices_usd, total_share_units,
        burned_share_units, shocked_asset_index, shock_bps,
    )
    marked_prices = [Fraction(price) for price in prices_usd]
    marked_prices[shocked_asset_index] *= Fraction(BPS + shock_bps, BPS)

    payouts: list[int] = []
    remainders: list[int] = []
    remaining: list[int] = []
    for reserve in reserve_units:
        if burned_share_units == total_share_units:
            payout, remainder = reserve, 0
        else:
            payout, remainder = divmod(reserve * burned_share_units, total_share_units)
        payouts.append(payout)
        remainders.append(remainder)
        remaining.append(reserve - payout)

    def value_usd(units: tuple[int, ...] | list[int]) -> Fraction:
        return sum(
            (
                Fraction(amount, 10**places) * price
                for amount, (_, places), price in zip(units, ASSETS, marked_prices)
            ),
            Fraction(0),
        )

    pre_nav = value_usd(reserve_units)
    payout_value = value_usd(payouts)
    remaining_nav = value_usd(remaining)
    dust_value = sum(
        (
            Fraction(remainder, total_share_units * 10**places) * price
            for remainder, (_, places), price in zip(remainders, ASSETS, marked_prices)
        ),
        Fraction(0),
    )
    remaining_shares = total_share_units - burned_share_units

    result: dict[str, object] = {
        "pre_redemption_nav_usd": pre_nav,
        "payout_value_usd": payout_value,
        "remaining_nav_usd": remaining_nav,
        "floor_dust_value_usd": dust_value,
        "nav_per_share_unit_before_usd": pre_nav / total_share_units,
        "nav_per_share_unit_after_usd": (
            remaining_nav / remaining_shares if remaining_shares else None
        ),
        "remaining_share_units": remaining_shares,
        "accounting_residual_usd": pre_nav - payout_value - remaining_nav,
        "exact_full_exit": burned_share_units == total_share_units,
        "marked_prices_usd": tuple(marked_prices),
        "payout_units": tuple(payouts),
        "remaining_units": tuple(remaining),
        "dust_numerators": tuple(remainders),
        "dust_denominator": total_share_units,
    }
    for index, (asset, places) in enumerate(ASSETS):
        result[f"{asset.lower()}_payout_units"] = payouts[index]
        result[f"{asset.lower()}_remaining_units"] = remaining[index]
        result[f"{asset.lower()}_dust_numerator"] = remainders[index]
        result[f"{asset.lower()}_dust_usd"] = (
            Fraction(remainders[index], total_share_units * 10**places)
            * marked_prices[index]
        )
    return result


def sensitivity_rows() -> list[dict[str, str]]:
    """Build 216 rows: 3 reserve profiles × 3 shocks × 4 marks × 6 burns."""
    burns = (*REDEEMED_SHARE_UNITS, FULL_EXIT_SHARE_UNITS)
    decimals = tuple(places for _, places in ASSETS)
    rows: list[dict[str, str]] = []
    for scenario, reserves in enumerate(RESERVE_SCENARIOS):
        for asset_index, shock_bps, burned in product(range(3), SHOCKS_BPS, burns):
            result = withdrawal_scenario(
                reserves,
                decimals,
                ASSET_PRICES_USD,
                TOTAL_SHARE_UNITS,
                burned,
                asset_index,
                shock_bps,
            )
            row = {
                "reserve_scenario": str(scenario),
                "shocked_asset": ASSETS[asset_index][0],
                "shock_bps": str(shock_bps),
                "burned_share_units": str(burned),
                "total_share_units": str(TOTAL_SHARE_UNITS),
                "exact_full_exit": str(result["exact_full_exit"]).lower(),
                "remaining_share_units": str(result["remaining_share_units"]),
            }
            for field in (
                "pre_redemption_nav_usd",
                "payout_value_usd",
                "remaining_nav_usd",
                "floor_dust_value_usd",
                "nav_per_share_unit_before_usd",
                "nav_per_share_unit_after_usd",
                "accounting_residual_usd",
            ):
                row[field] = _decimal_text(result[field])  # type: ignore[arg-type]
            for index, (asset, _) in enumerate(ASSETS):
                row[f"{asset.lower()}_reserve_units"] = str(reserves[index])
                row[f"{asset.lower()}_payout_units"] = str(result["payout_units"][index])  # type: ignore[index]
                row[f"{asset.lower()}_remaining_units"] = str(result["remaining_units"][index])  # type: ignore[index]
                row[f"{asset.lower()}_dust_numerator"] = str(result["dust_numerators"][index])  # type: ignore[index]
                row[f"{asset.lower()}_dust_denominator"] = str(result["dust_denominator"])
                row[f"{asset.lower()}_dust_usd"] = _decimal_text(result[f"{asset.lower()}_dust_usd"])  # type: ignore[arg-type]
            rows.append(row)
    return rows


def write_report(path: Path = OUTPUT) -> str:
    rows = sensitivity_rows()
    with path.open("w", newline="", encoding="utf-8") as stream:
        writer = csv.DictWriter(stream, fieldnames=tuple(rows[0]), lineterminator="\n")
        writer.writeheader()
        writer.writerows(rows)
    return str(path)


if __name__ == "__main__":
    output = write_report()
    print(f"wrote {len(sensitivity_rows())} synthetic shocked integer-withdrawal cases to {output}")
</file>

<file path="tools/rebalancing/etf-economics/withdrawal_sensitivity.py">
"""Finite synthetic accounting sensitivity for pro-rata in-kind redemptions."""

from __future__ import annotations

from decimal import Decimal, ROUND_HALF_EVEN, localcontext
from itertools import product

PRECISION = 50
BPS = Decimal(10_000)
ASSETS = ("SOL", "BTC", "USDC")
RESERVES = (Decimal("400"), Decimal("0.8"), Decimal("20000"))
PRICES_USD = (Decimal("100"), Decimal("50000"), Decimal("1"))
TOTAL_SHARES = Decimal("10000")
REDEMPTION_FRACTIONS_BPS = (100, 1000, 5000, 9000)
SHOCKS_BPS = (-5000, -1000, 1000, 5000)


def _validate(
    reserves: tuple[Decimal, ...],
    prices_usd: tuple[Decimal, ...],
    total_shares: Decimal,
    shock_asset_index: int,
    shock_bps: int,
    redemption_fraction_bps: int,
) -> None:
    for values, name in ((reserves, "reserves"), (prices_usd, "prices_usd")):
        if len(values) != 3 or any(
            not isinstance(value, Decimal) or not value.is_finite() or value <= 0
            for value in values
        ):
            raise ValueError(f"{name} must contain exactly three finite positive Decimal values")
    if not isinstance(total_shares, Decimal) or not total_shares.is_finite() or total_shares <= 0:
        raise ValueError("total_shares must be a finite positive Decimal")
    if type(shock_asset_index) is not int or not 0 <= shock_asset_index < 3:
        raise ValueError("shock_asset_index must be an integer from 0 through 2")
    if type(shock_bps) is not int or not -9000 <= shock_bps <= 10_000:
        raise ValueError("shock_bps must be an integer in [-9000, 10000]")
    if type(redemption_fraction_bps) is not int or not 1 <= redemption_fraction_bps <= 9999:
        raise ValueError("redemption_fraction_bps must be an integer in [1, 9999]")


def redemption_scenario(
    reserves: tuple[Decimal, Decimal, Decimal],
    prices_usd: tuple[Decimal, Decimal, Decimal],
    total_shares: Decimal,
    shock_asset_index: int,
    shock_bps: int,
    redemption_fraction_bps: int,
) -> dict[str, Decimal]:
    """Shock one mark, then redeem that fraction of shares and every reserve pro rata.

    Fractional token quantities are allowed so the result isolates accounting
    from token-decimal rounding, transfer fees, and execution effects.
    """
    _validate(
        reserves, prices_usd, total_shares, shock_asset_index,
        shock_bps, redemption_fraction_bps,
    )
    with localcontext() as ctx:
        ctx.prec = PRECISION
        ctx.rounding = ROUND_HALF_EVEN
        fraction = Decimal(redemption_fraction_bps) / BPS
        marked_prices = list(prices_usd)
        marked_prices[shock_asset_index] *= Decimal(1) + Decimal(shock_bps) / BPS
        pre_redemption_nav = sum(
            (balance * price for balance, price in zip(reserves, marked_prices)), Decimal(0)
        )
        redeemed_shares = total_shares * fraction
        remaining_shares = total_shares - redeemed_shares
        nav_per_share_before = pre_redemption_nav / total_shares
        redemption_value = redeemed_shares * nav_per_share_before
        remaining_nav = pre_redemption_nav * (Decimal(1) - fraction)
        nav_per_share_after = remaining_nav / remaining_shares
        result = {
            "pre_redemption_nav_usd": +pre_redemption_nav,
            "redeemed_shares": +redeemed_shares,
            "remaining_shares": +remaining_shares,
            "holder_redemption_value_usd": +redemption_value,
            "remaining_pool_nav_usd": +remaining_nav,
            "nav_per_share_before_usd": +nav_per_share_before,
            "nav_per_share_after_usd": +nav_per_share_after,
            "accounting_residual_usd": +(pre_redemption_nav - redemption_value - remaining_nav),
        }
        for asset, reserve in zip(ASSETS, reserves):
            redeemed_amount = reserve * fraction
            result[f"redeemed_{asset}_amount"] = +redeemed_amount
            result[f"remaining_{asset}_amount"] = +(reserve - redeemed_amount)
        return result


def sensitivity_rows() -> list[dict[str, str]]:
    """Return a reproducible grid over each asset, shock direction, and fraction."""
    rows = []
    for asset_index, shock_bps, fraction_bps in product(
        range(3), SHOCKS_BPS, REDEMPTION_FRACTIONS_BPS
    ):
        result = redemption_scenario(
            RESERVES, PRICES_USD, TOTAL_SHARES, asset_index, shock_bps, fraction_bps
        )
        rows.append({
            "shock_asset": ASSETS[asset_index],
            "shock_bps": str(shock_bps),
            "redemption_fraction_bps": str(fraction_bps),
            **{key: format(value, "f") for key, value in result.items()},
        })
    return rows
