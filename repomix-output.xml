  padding: 9px 11px;
  flex: 1;
  min-width: 150px;
}

.diagram-node.bridge {
  border-color: rgba(59, 130, 246, 0.4);
}

.diagram-node.swap {
  border-color: rgba(153, 69, 255, 0.4);
}

.node-kind {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
  font-weight: 800;
}

.diagram-node.bridge .node-kind {
  color: var(--blue);
}

.diagram-node.swap .node-kind {
  color: var(--accent2);
}

.node-proto {
  font-weight: 700;
  font-size: 13.5px;
  margin: 3px 0 2px;
}

.node-route {
  font-size: 13px;
}

.node-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 7px;
}

.chip {
  font-size: 11px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  border-radius: 6px;
