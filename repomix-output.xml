      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--lacquer-slate);
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--rule-hairline);
      background: rgba(20, 23, 26, 0.02);
