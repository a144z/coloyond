}

.badge-none {
  background: rgba(142, 142, 163, 0.12);
  color: var(--muted);
}

.dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-full {
  background: var(--green);
  box-shadow: 0 0 8px rgba(46, 204, 113, 0.7);
}

.dot-partial {
  background: var(--yellow);
  box-shadow: 0 0 8px rgba(240, 180, 41, 0.7);
}

.dot-intent {
  background: var(--orange);
  box-shadow: 0 0 8px rgba(255, 138, 61, 0.7);
}

.provider {
  font-weight: 700;
  font-size: 15px;
}

.diagram {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 6px;
  padding: 12px;
  background: var(--panel-2);
