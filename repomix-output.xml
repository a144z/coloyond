import base64
import hashlib
import struct
import unittest

from probe import (
    DEVNET_GENESIS_HASH,
    base58_encode,
    CRON_PROGRAM_ID,
    decode_config,
    decode_programdata_account,
    decode_programdata_address,
    decode_task,
    decode_task_queue,
    discriminator,
    validate_devnet_genesis,
    validate_executable_program_account,
    UPGRADEABLE_LOADER,
)


def queue_account(bitmap=b"\x05", capacity=8, padding=b""):
    return b"".join(
        (
            discriminator("TaskQueueV0"),
            bytes(range(32)),
            struct.pack("<I", 7),
            bytes(range(32, 64)),
            bytes(32),
            struct.pack("<QQHqqB", 2_000_000, 5, capacity, 100, 200, 9),
            struct.pack("<I", len(bitmap)),
            bitmap,
            struct.pack("<I", 5),
            b"queue",
            struct.pack("<I", 1),
            bytes([99]) * 32,
            struct.pack("<HI", 2, 300),
            padding,
        )
    )


def borsh_bytes(value):
    return struct.pack("<I", len(value)) + value


def compiled_transaction(program_index=1, account_index=0, signer_seed=b"seed"):
    return b"".join(
        (
            b"\x00",  # TransactionSourceV0::CompiledV0
            bytes((1, 0, 1)),  # writable signers, readonly signers, writable accounts
            struct.pack("<I", 2),
            bytes(range(64)),  # two account pubkeys
            struct.pack("<I", 1),  # one instruction
            bytes((program_index,)),
            borsh_bytes(bytes((account_index,))),
            borsh_bytes(b"ix"),
            struct.pack("<I", 1),  # signer groups
            struct.pack("<I", 1),  # seeds in group
            borsh_bytes(signer_seed),
        )
    )


def remote_transaction(url="https://example.invalid/tx"):
    return b"\x01" + borsh_bytes(url.encode()) + bytes(range(32))


def task_account(transaction, trigger_tag=0, trigger_time=0, padding=b"", description="probe"):
    trigger = bytes((trigger_tag,))
    if trigger_tag == 1:
        trigger += struct.pack("<q", trigger_time)
    return b"".join(
        (
            discriminator("TaskV0"),
            bytes(range(32)),  # queue pubkey
            struct.pack("<QQH", 123_456, 7_000, 0),
            trigger,
            bytes(range(32, 64)),  # rent refund
            transaction,
            struct.pack("<qBB", 500, 1, 0),
            borsh_bytes(description.encode()),
            padding,
        )
    )


class TukTukProbeTests(unittest.TestCase):
    def test_cron_program_identity_is_the_maintained_candidate(self):
        self.assertEqual(CRON_PROGRAM_ID, "cronAjRZnJn3MTP3B9kE62NWDrjSuAPVXf9c4hu4grM")

    def test_program_account_validation_requires_executable_upgradeable_program(self):
        account = {
            "executable": True,
            "owner": UPGRADEABLE_LOADER,
            "space": 36,
            "lamports": 1_000_000,
        }
        self.assertEqual(
            validate_executable_program_account(account, CRON_PROGRAM_ID),
            account,
        )
        for invalid in (
            None,
            {**account, "executable": False},
            {**account, "owner": "11111111111111111111111111111111"},
        ):
            with self.subTest(account=invalid), self.assertRaises(RuntimeError):
                validate_executable_program_account(invalid, CRON_PROGRAM_ID)

    def test_program_account_points_to_loader_programdata(self):
        address_bytes = bytes(range(32))
        account = {
            "data": [base64.b64encode(struct.pack("<I", 2) + address_bytes).decode(), "base64"]
        }
        self.assertEqual(
            decode_programdata_address(account, CRON_PROGRAM_ID),
            base58_encode(address_bytes),
        )
        for invalid in (
            {"data": [base64.b64encode(bytes(36)).decode(), "base64"]},
            {"data": ["%%%", "base64"]},
            {"data": [base64.b64encode(bytes(36)).decode(), "base58"]},
