        <div class="ledger-panel" style="margin-top: 1.5rem;">
          <div class="ledger-top-stripe">
            <span>Rollup Proof Attestations</span>
            <span>State: Engine Verified</span>
          </div>

          <div class="ledger-body">
            <ul class="proof-log-list" id="proof-log-list">
