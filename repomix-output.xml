              <span>State: 0.038 SOL Remaining</span>
            </div>
          </div>
          <div class="limit-box">
            <span class="limit-label">Max Drift Excursion</span>
            <div class="limit-value">± 1.25 %</div>
            <div class="limit-state">
              <span class="status-swatch swatch-slate" aria-hidden="true"></span>
              <span>State: Hard Rebalance Trigger</span>
            </div>
          </div>
          <div class="limit-box">
            <span class="limit-label">Session Loss Cap</span>
            <div class="limit-value">0.20 SOL</div>
            <div class="limit-state">
              <span class="status-swatch swatch-amber" aria-hidden="true"></span>
              <span>State: Execution Circuit Breaker</span>
            </div>
          </div>
        </div>

        <div class="delegation-bar">
          <div class="delegation-meta-text">
            <strong>Revocable Crank Delegation</strong>: Authorization valid for current epoch. Revocation broadcasts an immediate instruction resetting the Ephemeral Rollup context to on-chain cold storage.
          </div>
          <div class="delegation-actions">
            <button class="btn-secondary interactive-hit" id="revoke-btn" aria-label="Revoke Crank Delegation instantly">
              REVOKE DELEGATION
            </button>
            <button class="btn-secondary interactive-hit" id="refresh-budget-btn" aria-label="Replenish gas budget">
              TOP UP GAS BUDGET
            </button>
          </div>
        </div>
      </section>

      <!-- SECTION 04: ON-CHAIN PROOFS & EPHEMERAL ROLLUP LOG -->
      <section id="section-04">
        <div class="section-spine-heading">
          <div class="spine-large-num">04</div>
          <div class="section-title-wrap">
            <h2>Verifiable Execution Receipts</h2>
            <p class="section-subtext">Every automated run executes inside owner parameters and commits cryptographic proofs on Solana.</p>
          </div>
