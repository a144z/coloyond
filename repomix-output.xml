    main.canvas-layout {
      max-width: 1520px;
      width: 100%;
      margin: 0 auto;
      padding: 3rem 2.5rem 6rem;
      display: grid;
      grid-template-columns: 460px 1fr;
      gap: 3.5rem;
      align-items: start;
    }

    /* LEFT COMPOSITION: MONUMENTAL STENCIL LACQUER ART & OWNER CARD */
    .monument-column {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .lacquer-canvas-card {
      background: var(--pulp-shade);
      border: 2px solid var(--rule-hairline);
      padding: 2.25rem;
      position: relative;
      box-shadow: 6px 6px 0px rgba(20, 23, 26, 0.12);
