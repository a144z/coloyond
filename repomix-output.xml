<file path="apps/android/app/src/main/java/com/coloyond/platform/CardStorage.kt">
package com.coloyond.platform

import android.content.Context
import com.coloyond.strategy.StrategyRecords
import com.coloyond.strategy.ValidatedRecord
import com.coloyond.strategy.asObject
import com.coloyond.strategy.asString
import com.coloyond.strategy.field
import java.io.File
import java.io.FileOutputStream
import java.security.MessageDigest

/** An immutable expression, its separately stored strategy, and its local PNG. */
data class SavedCard(
    val strategy: ValidatedRecord,
    val expression: ValidatedRecord,
    val png: ByteArray,
    val pngSha256: String,
    val viewOnly: Boolean,
)

/** App-private, content-addressed card storage. It never persists wallet/model credentials. */
class CardStorage(private val root: File) {
    constructor(context: Context) : this(File(context.filesDir, "cards-v1"))

    private val strategies = File(root, "strategies")
    private val expressions = File(root, "expressions")
    private val images = File(root, "png")
    private val imageDigests = File(root, "png-digests")
    private val drafts = File(root, "drafts")

    /** Persists only the explicit nonexecutable AllocationDraftV1 record. */
    fun saveDraft(strategy: ValidatedRecord): ValidatedRecord = synchronized(processLock) {
        val checked = StrategyRecords.validateStrategy(strategy.value)
        require(checked.id == strategy.id && checked.id.startsWith("cbd1:")) { "Only a validated allocation draft can be saved" }
        require(checked.value.asObject("draft").field("kind").asString("kind") == "allocation-draft")
        writeImmutable(File(drafts, fileName(checked.id, ".json")), checked.canonicalJson.toByteArray(Charsets.UTF_8))
        checked
    }

    fun loadDraft(id: String): ValidatedRecord? {
        if (!draftIdPattern.matches(id)) return null
        val file = File(drafts, fileName(id, ".json"))
        if (!file.isFile || file.length() > StrategyRecords.MAX_IMPORT_BYTES) return null
        return runCatching {
            val checked = StrategyRecords.validateStrategy(StrategyRecords.parse(file.readText(Charsets.UTF_8)))
            checked.takeIf { it.id == id && it.id.startsWith("cbd1:") }
        }.getOrNull()
    }

    fun listDrafts(): List<ValidatedRecord> = drafts.listFiles()
        .orEmpty()
        .asSequence()
        .filter { it.isFile && it.name.endsWith(".json") }
        .mapNotNull { file -> loadDraft(file.name.removeSuffix(".json").replace('_', ':')) }
        .sortedBy { it.id }
        .toList()

    /**
     * Saves each content object once. The expression is written last, so it is
     * also the commit marker used by [list] if the process stops mid-save.
     */
    fun save(strategy: ValidatedRecord, expression: ValidatedRecord, png: ByteArray): SavedCard = synchronized(processLock) {
        val checkedStrategy = StrategyRecords.validateStrategy(strategy.value)
        require(checkedStrategy.id == strategy.id) { "Strategy identity changed" }
        val strategyId = expression.value.asObject("expression").field("strategyId").asString("strategyId")
        require(strategyId == checkedStrategy.id) { "Expression belongs to another strategy" }
        val checkedExpression = StrategyRecords.validateExpression(expression.value, coloyond = strategyId.startsWith("cb3:"))
        require(checkedExpression.id == expression.id) { "Expression identity changed" }
        require(expressionIdPattern.matches(checkedExpression.id)) { "Unsupported expression identity" }
        require(strategyIdPattern.matches(checkedStrategy.id)) { "Unsupported strategy identity" }
        require(png.size <= MAX_PNG_BYTES) { "Card PNG exceeds the local storage limit" }
        require(isCardPng(png)) { "PNG must be a 1080 × 1350 card image" }

        writeImmutable(File(strategies, fileName(checkedStrategy.id, ".json")), checkedStrategy.canonicalJson.toByteArray(Charsets.UTF_8))
        writeImmutable(File(images, fileName(checkedExpression.id, ".png")), png)
        writeImmutable(File(imageDigests, fileName(checkedExpression.id, ".sha256")), sha256(png).toByteArray(Charsets.US_ASCII))
        writeImmutable(File(expressions, fileName(checkedExpression.id, ".json")), checkedExpression.canonicalJson.toByteArray(Charsets.UTF_8))
        SavedCard(checkedStrategy, checkedExpression, png.copyOf(), sha256(png), checkedStrategy.viewOnly || checkedExpression.viewOnly)
    }

    /** Returns a fully revalidated card, or null when the expression is absent/incomplete. */
    fun load(expressionId: String): SavedCard? {
        if (!expressionIdPattern.matches(expressionId)) return null
        val expressionFile = File(expressions, fileName(expressionId, ".json"))
        if (!expressionFile.isFile || expressionFile.length() > StrategyRecords.MAX_IMPORT_BYTES) return null
        val expressionBytes = expressionFile.readBytes()
        val expression = runCatching {
            StrategyRecords.validateExpression(
                StrategyRecords.parse(expressionBytes.toString(Charsets.UTF_8)),
                coloyond = expressionId.startsWith("cbe2:"),
            )
        }.getOrNull() ?: return null
        if (expression.id != expressionId) return null
        val strategyId = expression.value.asObject("expression").field("strategyId").asString("strategyId")
        if (!strategyIdPattern.matches(strategyId)) return null
        val strategyFile = File(strategies, fileName(strategyId, ".json"))
        if (!strategyFile.isFile || strategyFile.length() > StrategyRecords.MAX_IMPORT_BYTES) return null
        val strategyBytes = strategyFile.readBytes()
        val strategy = runCatching { StrategyRecords.validateStrategy(StrategyRecords.parse(strategyBytes.toString(Charsets.UTF_8))) }.getOrNull()
            ?: return null
        if (strategy.id != strategyId) return null
        val pngFile = File(images, fileName(expressionId, ".png"))
        if (!pngFile.isFile || pngFile.length() > MAX_PNG_BYTES) return null
        val png = pngFile.readBytes()
        if (!isCardPng(png)) return null
        val digestFile = File(imageDigests, fileName(expressionId, ".sha256"))
        if (!digestFile.isFile || digestFile.length() != 64L || digestFile.readText(Charsets.US_ASCII) != sha256(png)) return null
        return SavedCard(strategy, expression, png, sha256(png), strategy.viewOnly || expression.viewOnly)
    }

    /** Lists only expression files whose strategy and image objects are complete and valid. */
    fun list(): List<SavedCard> = expressions.listFiles()
        .orEmpty()
        .asSequence()
        .filter { it.isFile && it.name.endsWith(".json") }
        .mapNotNull { file -> load(file.name.removeSuffix(".json").replace('_', ':')) }
        .sortedBy { it.expression.id }
        .toList()

    private fun writeImmutable(destination: File, bytes: ByteArray) {
        destination.parentFile?.let { parent -> check(parent.isDirectory || parent.mkdirs()) { "Could not create card storage" } }
        if (destination.exists()) {
            val existing = destination.readBytes()
            if (!existing.contentEquals(bytes)) throw CardStorageConflictException("Immutable card content already exists")
            return
        }
        val temporary = File.createTempFile("card-", ".tmp", destination.parentFile)
        try {
            FileOutputStream(temporary).use { stream ->
                stream.write(bytes)
                stream.fd.sync()
            }
            if (!temporary.renameTo(destination)) {
                if (destination.isFile && destination.readBytes().contentEquals(bytes)) return
                throw CardStorageConflictException("Could not commit immutable card content")
            }
        } finally {
            temporary.delete()
        }
    }

    private fun fileName(id: String, suffix: String): String = id.replace(':', '_') + suffix

    private fun isCardPng(bytes: ByteArray): Boolean {
        if (bytes.size < 24) return false
        val signature = byteArrayOf(0x89.toByte(), 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a)
        if (!bytes.copyOfRange(0, 8).contentEquals(signature)) return false
        fun u32(offset: Int): Long = (0..3).fold(0L) { value, index -> (value shl 8) or (bytes[offset + index].toLong() and 0xff) }
        return u32(8) == 13L && bytes.copyOfRange(12, 16).contentEquals(byteArrayOf(0x49, 0x48, 0x44, 0x52)) &&
            u32(16) == CardLayoutV1.WIDTH.toLong() && u32(20) == CardLayoutV1.HEIGHT.toLong()
    }

    private fun sha256(bytes: ByteArray): String = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }

    companion object {
        private val processLock = Any()
        private val strategyIdPattern = Regex("(?:cb1|cb2|cb3|cbd1):[0-9a-f]{64}")
        private val draftIdPattern = Regex("cbd1:[0-9a-f]{64}")
        private val expressionIdPattern = Regex("cbe[12]:[0-9a-f]{64}")
        private const val MAX_PNG_BYTES = 16 * 1024 * 1024L
    }
}

class CardStorageConflictException(message: String) : IllegalStateException(message)
</file>

<file path="apps/android/app/src/main/java/com/coloyond/platform/ImportIntents.kt">
package com.coloyond.platform

import android.content.ContentResolver
import android.content.Intent
import android.net.Uri
import android.os.Build
import com.coloyond.strategy.CardExchange
import com.coloyond.strategy.ValidatedRecord
import java.io.IOException
import java.io.InputStream

/** Bounded Activity intent ingress. Call [readValidated] before exposing imported records to UI code. */
sealed interface ImportProbeResult {
    data class Link(val payloadChars: Int, val encodedPayload: String) : ImportProbeResult
    data class File(val uri: Uri, val mime: String?, val bytes: ByteArray) : ImportProbeResult
    data class Rejected(val reason: String) : ImportProbeResult
}

sealed interface ValidatedImport {
    data class StrategyOnly(val strategy: ValidatedRecord) : ValidatedImport
    data class CardFile(val card: CardExchange.PortableCard) : ValidatedImport
    data class Rejected(val reason: String) : ValidatedImport
}

object ImportIntents {
    const val SCHEME = "coloyond"
    const val HOST = "import"
    const val MAX_LINK_CHARS = CardExchange.MAX_LINK_CHARS
    const val MAX_IMPORT_BYTES = 256 * 1024

    /** Returns null when [intent] is not an import (for example, the launcher intent). */
    fun read(intent: Intent, resolver: ContentResolver): ImportProbeResult? {
        val data = intent.data
        return when {
            intent.action == Intent.ACTION_VIEW && data?.scheme == SCHEME -> readLink(data)
            intent.action == Intent.ACTION_VIEW && data?.scheme == ContentResolver.SCHEME_CONTENT ->
                readContent(data, intent.type, resolver)
            intent.action == Intent.ACTION_SEND -> {
                val uri = intent.streamUri() ?: return ImportProbeResult.Rejected("share had no file")
                if (uri.scheme != ContentResolver.SCHEME_CONTENT) return ImportProbeResult.Rejected("not a content URI")
                readContent(uri, intent.type, resolver)
            }
            else -> null
        }
    }

    /** Validates a cold/warm activity import before the UI receives strategy data. */
    fun readValidated(intent: Intent, resolver: ContentResolver): ValidatedImport? {
        if (intent.action == Intent.ACTION_SEND_MULTIPLE) return readMultiple(intent, resolver)
        return when (val raw = read(intent, resolver)) {
            null -> null
            is ImportProbeResult.Rejected -> ValidatedImport.Rejected(raw.reason)
            is ImportProbeResult.Link -> try {
                ValidatedImport.StrategyOnly(CardExchange.parseStrategyLink("$LINK_PREFIX${raw.encodedPayload}"))
            } catch (error: IllegalArgumentException) {
                ValidatedImport.Rejected(error.message ?: "Strategy link is invalid")
            }
            is ImportProbeResult.File -> try {
                ValidatedImport.CardFile(CardExchange.parseExport(raw.bytes))
            } catch (error: IllegalArgumentException) {
                ValidatedImport.Rejected(error.message ?: "Strategy file is invalid")
            }
        }
    }

    private fun readMultiple(intent: Intent, resolver: ContentResolver): ValidatedImport {
        val uris = intent.streamUris()
        if (uris.isEmpty() || uris.size > MAX_SHARED_URIS) return ValidatedImport.Rejected("share must contain one or two files")
        val valid = uris.mapNotNull { uri ->
            if (uri.scheme != ContentResolver.SCHEME_CONTENT) return@mapNotNull null
            val file = readContent(uri, intent.type, resolver) as? ImportProbeResult.File
                ?: return@mapNotNull null
            runCatching { CardExchange.parseExport(file.bytes) }.getOrNull()
        }
        return when (valid.size) {
            1 -> ValidatedImport.CardFile(valid.single())
            0 -> ValidatedImport.Rejected("share contains no valid .coloyond.json strategy")
            else -> ValidatedImport.Rejected("share contains multiple strategy files")
        }
    }

    private fun readLink(uri: Uri): ImportProbeResult {
        val whole = uri.toString()
        if (whole.length >= MAX_LINK_CHARS) return ImportProbeResult.Rejected("link is ${whole.length} characters")
        if (uri.host != HOST || uri.userInfo != null || uri.port != -1 || !uri.path.isNullOrEmpty() || uri.query != null) {
            return ImportProbeResult.Rejected("unknown or malformed link address")
        }
        val fragment = uri.encodedFragment ?: return ImportProbeResult.Rejected("link has no payload")
        return ImportProbeResult.Link(fragment.length, fragment)
    }

    private fun readContent(uri: Uri, mime: String?, resolver: ContentResolver): ImportProbeResult {
        val resolvedMime = mime ?: try {
            resolver.getType(uri)
        } catch (_: RuntimeException) {
            null
        }
        val stream = try {
            resolver.openInputStream(uri)
        } catch (e: SecurityException) {
            return ImportProbeResult.Rejected("no read permission")
        } catch (e: java.io.FileNotFoundException) {
            return ImportProbeResult.Rejected("file not found")
        } catch (_: IOException) {
            return ImportProbeResult.Rejected("file could not be opened")
        } catch (_: RuntimeException) {
            return ImportProbeResult.Rejected("file could not be opened")
        } ?: return ImportProbeResult.Rejected("file could not be opened")
        val bytes = (try {
            stream.use { it.readBounded(MAX_IMPORT_BYTES) }
        } catch (e: SecurityException) {
            return ImportProbeResult.Rejected("no read permission")
        } catch (e: java.io.FileNotFoundException) {
            return ImportProbeResult.Rejected("file not found")
        } catch (_: IOException) {
            return ImportProbeResult.Rejected("file could not be read")
        } catch (_: RuntimeException) {
            return ImportProbeResult.Rejected("file could not be read")
        }) ?: return ImportProbeResult.Rejected("file is larger than ${MAX_IMPORT_BYTES / 1024} KiB")
        return ImportProbeResult.File(uri, resolvedMime, bytes)
    }

    /** Reads at most [limit] bytes; returns null when the stream is longer. */
    internal fun InputStream.readBounded(limit: Int): ByteArray? {
        require(limit in 0 until Int.MAX_VALUE) { "Import limit is invalid" }
        val buffer = ByteArray(limit + 1)
        var total = 0
        while (total <= limit) {
            val n = read(buffer, total, buffer.size - total)
            if (n < 0) break
            if (n == 0) {
                // A few provider streams return zero for a non-empty read; force progress.
                val next = read()
                if (next < 0) break
                buffer[total++] = next.toByte()
            } else {
                total += n
            }
        }
        return if (total > limit) null else buffer.copyOf(total)
    }

    @Suppress("DEPRECATION")
    private fun Intent.streamUri(): Uri? = try {
        if (Build.VERSION.SDK_INT >= 33) getParcelableExtra(Intent.EXTRA_STREAM, Uri::class.java)
        else getParcelableExtra(Intent.EXTRA_STREAM)
    } catch (_: RuntimeException) {
        null
    }

    @Suppress("DEPRECATION")
    private fun Intent.streamUris(): List<Uri> = try {
        if (Build.VERSION.SDK_INT >= 33) getParcelableArrayListExtra(Intent.EXTRA_STREAM, Uri::class.java).orEmpty()
        else getParcelableArrayListExtra<Uri>(Intent.EXTRA_STREAM).orEmpty()
    } catch (_: RuntimeException) {
        emptyList()
    }

    private const val MAX_SHARED_URIS = 2
    private const val LINK_PREFIX = CardExchange.LINK_PREFIX
}
