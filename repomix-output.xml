<file path="src/ui/rebalancing/RebalanceActivity.module.css">
.root {
  --activity-line: #cbc6b8;
  --activity-rule: #d9d3c3;
  --activity-paper: #f1ecdd;
  --activity-ink: #171715;
  --activity-muted: #66645b;
  --activity-blue: #1249ed;
  color: var(--activity-ink);
  display: grid;
  gap: 18px;
  min-width: 0;
  font-family: Arial, Helvetica, sans-serif;
  font-variant-numeric: tabular-nums;
}

.root * { box-sizing: border-box; }

.header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 24px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--activity-line);
}

.kicker, .index, .sourceBadge, .sourceFacts dt, .panelHeading > span,
.activityFacts dt, .stateBadge {
  font: 10px/1.5 monospace;
  letter-spacing: .7px;
  text-transform: uppercase;
}

.kicker { margin: 0 0 12px; color: var(--activity-blue); }
.header h2 {
  margin: 0;
  font-size: clamp(31px, 4vw, 48px);
  line-height: 1;
  letter-spacing: -.065em;
}
.lede { max-width: 570px; margin: 12px 0 0; color: var(--activity-muted); font-size: 12px; line-height: 1.55; }
.sourceBadge { flex: none; padding: 8px 11px; border: 1px solid #8f8b7e; white-space: nowrap; }
.rpcBadge { color: #285842; border-color: #7e9d87; background: #e5eee6; }
.fixtureBadge { color: #5c4710; border-color: #b6a976; background: #fff3c7; }
.fixtureNotice { margin: 0; padding: 13px 16px; border: 1px solid #a78212; background: #fff3c7; color: #5c4710; font: 10px/1.55 monospace; letter-spacing: .35px; }

.sourceFacts {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: 0;
  border-top: 1px solid var(--activity-line);
  border-bottom: 1px solid var(--activity-line);
}
.sourceFacts > div { min-width: 0; display: grid; align-content: start; gap: 7px; padding: 13px 14px; border-right: 1px solid var(--activity-line); }
.sourceFacts > div:first-child { padding-left: 0; }
.sourceFacts > div:last-child { border-right: 0; }
.sourceFacts dt, .activityFacts dt { color: var(--activity-muted); }
.sourceFacts dd, .activityFacts dd { min-width: 0; margin: 0; font-size: 12px; overflow-wrap: anywhere; }

.statePanel, .auctionPanel, .transitionPanel {
  min-width: 0;
  padding: 20px 22px;
  background: var(--activity-paper);
  border: 1px solid #c7c1b1;
  border-radius: 14px;
}
.stateHeading, .panelHeading { display: flex; justify-content: space-between; align-items: start; gap: 14px; }
.index { margin: 0; color: var(--activity-blue); }
.stateHeading h3, .panelHeading h3 {
  margin: 7px 0 0;
  font-size: clamp(22px, 2.7vw, 30px);
  line-height: 1.05;
  letter-spacing: -.055em;
}
.stateBadge, .panelHeading > span { flex: none; color: var(--activity-muted); text-align: right; }
.stateDescription { max-width: 680px; margin: 14px 0 0; color: #49473f; font-size: 12px; line-height: 1.6; }
.panelHeading > span { max-width: 180px; }
.activityFacts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 18px 0 0; border-top: 1px solid var(--activity-rule); }
.activityFacts > div { min-width: 0; display: grid; align-content: start; gap: 8px; padding: 13px 14px 4px 0; }
.activityFacts dd { font-size: 12px; }
.signatureFact { grid-column: 1 / -1; border-top: 1px solid var(--activity-rule); }
.signatureFact code { font: 10px/1.55 monospace; overflow-wrap: anywhere; }
.empty { margin: 14px 0 0; padding-top: 13px; border-top: 1px solid var(--activity-rule); color: var(--activity-muted); font-size: 11px; line-height: 1.6; }
.note { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--activity-rule); color: var(--activity-muted); font-size: 10px; line-height: 1.6; }

@media (max-width: 760px) {
  .sourceFacts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sourceFacts > div:nth-child(2) { border-right: 0; }
  .sourceFacts > div:nth-child(3), .sourceFacts > div:nth-child(4) { border-top: 1px solid var(--activity-line); }
  .sourceFacts > div:nth-child(3) { padding-left: 0; }
  .sourceFacts > div:last-child { border-right: 0; }
}

@media (max-width: 520px) {
  .root { gap: 15px; }
  .header { flex-direction: column; align-items: flex-start; gap: 14px; }
  .sourceBadge { white-space: normal; }
  .sourceFacts > div { padding: 11px; }
  .statePanel, .auctionPanel, .transitionPanel { padding: 18px 16px; }
  .stateHeading, .panelHeading { gap: 9px; }
  .stateBadge, .panelHeading > span { max-width: 118px; font-size: 9px; }
  .activityFacts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (prefers-reduced-motion: reduce) {
  .root *, .root *::before, .root *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
