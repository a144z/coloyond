<file path="packages/coloyond-client/test/instructions.test.ts">
import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import test from "node:test";
import {
  base58Decode,
  encodeInitializeVault,
  INITIALIZE_VAULT_ACCOUNT_ORDER,
  INITIALIZE_VAULT_DISCRIMINATOR,
  type VaultInitArgs,
} from "../src/instructions.js";

const idlPath = new URL("../../../idl/coloyond_vault.json", import.meta.url);
type JsonValue = JsonValue[] | { [key: string]: JsonValue } | string | number | boolean | null;
type JsonRecord = { [key: string]: JsonValue };
const idl = JSON.parse(await readFile(idlPath, "utf-8")) as JsonRecord;

const instructions = idl.instructions as JsonRecord[];
const initializeInstruction = instructions.find((instruction) => instruction.name === "initialize_vault");
assert.ok(initializeInstruction, "initialize_vault is published in the IDL");
const types = new Map((idl.types as JsonRecord[]).map((entry) => [entry.name as string, entry.type as JsonRecord]));

const sample: VaultInitArgs = {
  configurationRevision: 7n,
  targetBps: [6000, 4000],
  seedAmounts: [1000n, 2000n],
  reserveContributions: [10n, 20n],
  minimumLockedShares: 1n,
  governanceAuthority: "FN7uGX34qyijmVX69gqEkMugWjE5Sjso8Pe7gWU6B2N6",
  emergencyAuthority: "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA",
  minDelaySlots: 100n,
  maximumAgeSeconds: 600n,
  maximumConfidenceBps: 100,
  maximumUsdcDeviationBps: 250,
};

test("encoder discriminator and account order match the published IDL", () => {
  assert.deepEqual([...INITIALIZE_VAULT_DISCRIMINATOR], initializeInstruction!.discriminator as number[]);
  assert.deepEqual(
    INITIALIZE_VAULT_ACCOUNT_ORDER,
    (initializeInstruction!.accounts as JsonRecord[]).map((account) => account.name as string),
  );
  assert.deepEqual(initializeInstruction!.args, [{ name: "init", type: { defined: { name: "VaultInit" } } }]);
});

test("encoded length equals the IDL VaultInit field sizes", () => {
  const sizeOf = (type: JsonValue): number => {
    if (typeof type === "string") {
      const sizes: Record<string, number> = { u8: 1, u16: 2, u64: 8, pubkey: 32 };
      assert.ok(sizes[type] !== undefined, `unsupported non-fixed IDL type ${type}`);
      return sizes[type]!;
    }
    assert.ok(type && typeof type === "object" && !Array.isArray(type));
    const record = type as JsonRecord;
    if (record.array) {
      const [inner, length] = record.array as [JsonValue, number];
      return sizeOf(inner) * length;
    }
    assert.ok(record.defined, `unexpected non-fixed IDL type ${JSON.stringify(type)}`);
    const name = (record.defined as JsonRecord).name as string;
    const fields = (types.get(name) as JsonRecord).fields as JsonRecord[];
    return fields.reduce((total, field) => total + sizeOf(field.type as JsonValue), 0);
  };
  assert.ok(types.has("VaultInit"), "VaultInit type is published in the IDL");
  const fields = (types.get("VaultInit") as JsonRecord).fields as JsonRecord[];
  assert.equal(fields.length, 11);
  const expectedLength = 8 + fields.reduce((total, field) => total + sizeOf(field.type as JsonValue), 0);
  assert.equal(encodeInitializeVault(sample).byteLength, expectedLength);
});

test("encodeInitializeVault writes little endian fields in IDL order", () => {
  const bytes = encodeInitializeVault(sample);
  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  assert.deepEqual([...bytes.subarray(0, 8)], [...INITIALIZE_VAULT_DISCRIMINATOR]);
  assert.equal(view.getBigUint64(8, true), 7n);
  assert.equal(view.getUint16(16, true), 6000);
  assert.equal(view.getUint16(18, true), 4000);
  assert.equal(view.getBigUint64(20, true), 1000n);
  assert.equal(view.getBigUint64(52, true), 1n);
  assert.deepEqual([...bytes.subarray(60, 92)], [...base58Decode(sample.governanceAuthority)]);
  assert.deepEqual([...bytes.subarray(92, 124)], [...base58Decode(sample.emergencyAuthority)]);
  assert.equal(view.getUint16(140, true), 100);
  assert.equal(view.getUint16(142, true), 250);
  assert.equal(bytes.byteLength, 144);
});

test("base58Decode rejects invalid characters and oversized values", () => {
  assert.throws(() => base58Decode("0!"), /base58/);
  assert.equal(base58Decode("1".repeat(32)).length, 32);
  assert.throws(() => base58Decode("1".repeat(45)), /pubkey/);
});
</file>

<file path="packages/coloyond-client/test/vaultDecoder.test.ts">
import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import test from "node:test";
import { decodeVaultAccount, PROGRAM_ID, VAULT_ACCOUNT_SIZE } from "../src/vaultDecoder.js";

const fixturePath = new URL("../fixtures/vault-account-v1.hex", import.meta.url);
const vectorsPath = new URL("../fixtures/vault-v1-vectors.json", import.meta.url);
const idlPath = new URL("../../../idl/coloyond_vault.json", import.meta.url);
const bytes = Uint8Array.from(Buffer.from((await readFile(fixturePath, "utf8")).trim(), "hex"));
const vectors = JSON.parse(await readFile(vectorsPath, "utf8")) as {
  fixtureOnly: boolean;
  programId: string;
  accountFixture: { length: number; accountedAmounts: string[]; bountyLiabilities: string[]; sequence: string };
  u64LittleEndianVectors: { decimal: string; littleEndianHex: string }[];
};
const idl = JSON.parse(await readFile(idlPath, "utf8")) as {
  address: string;
  accounts: { name: string; discriminator: number[] }[];
  types: { name: string; type: { kind: string; fields?: { name: string; type: unknown }[] } }[];
};

test("decoder discriminator is generated from the published IDL", () => {
  assert.deepEqual([...bytes.subarray(0, 8)], idl.accounts.find((account) => account.name === "Vault")?.discriminator);
  assert.equal(PROGRAM_ID, idl.address);
  assert.equal(vectors.fixtureOnly, true);
  assert.equal(vectors.programId, idl.address);
  assert.equal(bytes.byteLength, vectors.accountFixture.length);
});

test("fixed decoder size matches the generated Anchor Vault type", () => {
  const types = new Map(idl.types.map((type) => [type.name, type.type]));
  const vaultType = types.get("Vault");
  assert.ok(vaultType?.fields);
  const sizeOf = (type: unknown): number => {
    if (typeof type === "string") {
      const sizes: Record<string, number> = { u8: 1, u16: 2, u64: 8, pubkey: 32 };
      assert.ok(sizes[type] !== undefined, `unsupported non-fixed IDL type ${type}`);
      return sizes[type]!;
    }
    assert.ok(type && typeof type === "object");
    const value = type as { array?: [unknown, number]; defined?: { name: string } };
    if (value.array) return sizeOf(value.array[0]) * value.array[1];
    if (value.defined) {
      const defined = types.get(value.defined.name);
      assert.ok(defined?.fields);
      return defined.fields.reduce((sum, field) => sum + sizeOf(field.type), 0);
    }
    throw new Error(`unsupported IDL type ${JSON.stringify(type)}`);
  };
  const bytes = 8 + vaultType.fields.reduce((sum, field) => sum + sizeOf(field.type), 0);
  assert.equal(bytes, VAULT_ACCOUNT_SIZE);
});

test("decodes fixed-width account fields and preserves u64 precision", () => {
  const vault = decodeVaultAccount(bytes, PROGRAM_ID);
  assert.equal(vault.status, "paused");
  assert.equal(vault.configurationRevision, "7");
  assert.deepEqual(vault.assets.map(({ decimals, targetBps }) => ({ decimals, targetBps })), [
    { decimals: 9, targetBps: 5500 },
    { decimals: 6, targetBps: 4500 },
  ]);
  assert.deepEqual(vault.accountedAmounts, vectors.accountFixture.accountedAmounts);
  assert.deepEqual(vault.bountyLiabilities, vectors.accountFixture.bountyLiabilities);
  assert.equal(vault.sequence, vectors.accountFixture.sequence);
  for (const amount of vectors.u64LittleEndianVectors) {
    const value = BigInt(amount.decimal);
    const littleEndianHex = Array.from({ length: 8 }, (_, index) =>
      ((value >> BigInt(index * 8)) & 0xffn).toString(16).padStart(2, "0"),
    ).join("");
    assert.equal(littleEndianHex, amount.littleEndianHex);
  }
  assert.equal(vault.shareMint, "11111111111111111111111111111111");
});

test("rejects truncated bytes, wrong discriminators and unknown status", () => {
  assert.throws(() => decodeVaultAccount(bytes.subarray(0, bytes.length - 1), PROGRAM_ID), /exactly 353 bytes/);
  assert.throws(() => decodeVaultAccount(bytes, "11111111111111111111111111111111"), /owner/);
  const wrongDiscriminator = bytes.slice();
  wrongDiscriminator[0] ^= 0xff;
  assert.throws(() => decodeVaultAccount(wrongDiscriminator, PROGRAM_ID), /discriminator/);
  const wrongVersion = bytes.slice();
  wrongVersion[8] = 2;
  assert.throws(() => decodeVaultAccount(wrongVersion, PROGRAM_ID), /version/);
  const wrongStatus = bytes.slice();
  wrongStatus[10] = 9;
  assert.throws(() => decodeVaultAccount(wrongStatus, PROGRAM_ID), /status/);
});
