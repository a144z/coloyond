<file path="src/ui/RoutingPanel.tsx">
import { Fragment } from "react";
import { Route, RouteStep } from "../types.js";
import { fmtTime, chainName } from "./data.js";
import { tokenLogo } from "../logos.js";
import { Logo } from "./Logo.js";

export interface Venue {
  name: string;
  pct: number;
}

export interface FlowHop {
  token: string;
  venues: Venue[];
  chain: number;
  chain2: number;
  eta: number;
}

export interface FlowRow {
  pct: number;
  label: string;
  hops: FlowHop[];
}

interface FlowData {
  from: { token: string; color: string; chain: number };
  to: { token: string; color: string; chain: number };
  rows: FlowRow[];
}

const ROW_H = 104;
const GAP = 10;
const CONN_W = 72;

const TOKEN_COLORS: Record<string, string> = {
  ETH: "#627eea",
  WETH: "#627eea",
  WBTC: "#f7931a",
  aWBTC: "#b6509e",
  USDC: "#2775ca",
  USDT: "#26a17b",
  crvUSD: "#2d2f36",
  DAI: "#f5ac37",
};

const TOKEN_GLYPHS: Record<string, string> = {
  WBTC: "₿",
  aWBTC: "A",
};

const MAX_ROWS = 4;

function colorOf(token: string): string {
  return TOKEN_COLORS[token] ?? "#8e8ea3";
}

function hopFromStep(s: RouteStep): FlowHop {
  const venues = s.venues?.length ? s.venues : [{ name: s.protocol, pct: 100 }];
  return {
    token: s.toSymbol,
    venues,
    chain: s.fromChainId,
    chain2: s.toChainId,
    eta: s.etaSeconds,
  };
}

export function buildFlow(routes: Route[]): FlowData | null {
  if (routes.length === 0) return null;
  const sorted = [...routes].sort((a, b) => b.outputAmountNum - a.outputAmountNum);
  const best = sorted[0];
  const from = best.steps[0];
  const to = best.steps[best.steps.length - 1];
  const rows = sorted.slice(0, MAX_ROWS).map((r) => ({
    pct: Math.round((r.outputAmountNum / best.outputAmountNum) * 1000) / 10,
    label: `${r.provider} · ${r.outputAmount} ${to.toSymbol} · ${fmtTime(r.totalTimeSeconds)}`,
    hops: r.steps.map(hopFromStep),
  }));
  return {
    from: { token: from.fromSymbol, color: colorOf(from.fromSymbol), chain: from.fromChainId },
    to: { token: to.toSymbol, color: colorOf(to.toSymbol), chain: to.toChainId },
    rows,
  };
}

function HopCard({ hop }: { hop: FlowHop }) {
  const glyph = TOKEN_GLYPHS[hop.token] ?? hop.token.charAt(0);
  return (
    <div className="hop-node">
      <div className="hop-head">
        <Logo src={tokenLogo(hop.token, hop.chain2 || hop.chain)} fallback={glyph} size={20} />
        <span className="hop-ticker">{hop.token}</span>
        <span className="hop-chain">
          {chainName(hop.chain)}
          {hop.chain2 !== hop.chain && <> → {chainName(hop.chain2)}</>}
        </span>
      </div>
      <div className="node-protos">
        {hop.venues.map((v, i) => (
          <div className="proto-row" key={i}>
            <span>{v.name}</span>
            <span className="proto-pct">{v.pct}%</span>
          </div>
        ))}
      </div>
      <div className="hop-eta">{fmtTime(hop.eta)}</div>
    </div>
  );
}

export function RoutingPanel({ routes }: { routes: Route[] }) {
  const data = buildFlow(routes);
  if (!data) return null;
  const totalH = data.rows.length * ROW_H + (data.rows.length - 1) * GAP;
  const midY = totalH / 2;
  const rowCenters = data.rows.map((_, i) => i * (ROW_H + GAP) + ROW_H / 2);

  const Connector = ({ flip }: { flip: boolean }) => {
    const paths = rowCenters.map((y) =>
      flip
        ? `M0 ${y} C ${CONN_W * 0.45} ${y}, ${CONN_W * 0.55} ${midY}, ${CONN_W} ${midY}`
        : `M0 ${midY} C ${CONN_W * 0.45} ${midY}, ${CONN_W * 0.55} ${y}, ${CONN_W} ${y}`,
    );
    return (
      <div className="connector">
        <svg
          className="connector-svg"
          viewBox={`0 0 ${CONN_W} ${totalH}`}
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {paths.map((d, i) => (
            <path key={i} d={d} vectorEffect="non-scaling-stroke" />
          ))}
          {paths.map((d, i) => {
            const y = flip ? midY : rowCenters[i];
            const x = flip ? CONN_W : 0;
            return <circle key={`d${i}`} cx={x} cy={y} r="2.5" className="conn-dot" />;
          })}
        </svg>
        {!flip &&
          rowCenters.map((y, i) => (
            <span className="split-pill" key={i} style={{ top: `${(y / totalH) * 100}%` }}>
              {data.rows[i].pct}%
            </span>
          ))}
      </div>
    );
  };

  return (
    <div className="routing-card">
      <div className="routing-head">
        <span className="routing-title">Routing</span>
        <span className="routing-meta">
          {data.from.token} → {data.to.token} · {data.rows.length} real routes · live quotes
        </span>
      </div>

      <div className="routing-scroll">
        <div className="routing-flow">
          <div className="endpoint">
            <div className="token-orb glow" style={{ background: data.from.color }}>
              <Logo src={tokenLogo(data.from.token, data.from.chain)} fallback={data.from.token} size={30} />
            </div>
          </div>

          <Connector flip={false} />

          <div className="routes-col">
            {data.rows.map((row, i) => (
              <div className="route-row" key={i}>
                <div className="route-row-label">{row.label}</div>
                <div className="hop-strip">
                  {row.hops.map((hop, j) => (
                    <Fragment key={j}>
                      {j > 0 && <span className="hop-arrow">&gt;</span>}
                      <HopCard hop={hop} />
                    </Fragment>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <Connector flip />

          <div className="endpoint">
            <div className="token-orb" style={{ background: data.to.color }}>
              <Logo src={tokenLogo(data.to.token, data.to.chain)} fallback={data.to.token} size={30} />
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/ui/SwapCard.tsx">
import { useState } from "react";
import { CHAINS, BALANCES } from "./data.js";
import { symbolsOn } from "../tokenmap.js";
import { tokenLogo, chainLogo } from "../logos.js";
import { Logo } from "./Logo.js";

type Side = "from" | "to";

const SLIPPAGE_PRESETS = [0.1, 0.5, 1, 3];

interface Props {
  fromChain: number;
  setFromChain: (v: number) => void;
  fromToken: string;
  setFromToken: (v: string) => void;
  toChain: number;
  setToChain: (v: number) => void;
  toToken: string;
  setToToken: (v: string) => void;
  amount: string;
  setAmount: (v: string) => void;
  atomic: boolean;
  setAtomic: (v: boolean) => void;
  receive: string | null;
  fee: number | null;
  slippage: number;
  setSlippage: (v: number) => void;
  onSwap: () => void;
  onFind: () => void;
}

export function SwapCard(p: Props) {
  const [loading, setLoading] = useState(false);
  const [picker, setPicker] = useState<Side | null>(null);
  const [settings, setSettings] = useState(false);
  const [invertRate, setInvertRate] = useState(false);

  const balance = BALANCES[p.fromToken] ?? "0";
  const fromOptions = symbolsOn(p.fromChain);
  const toOptions = symbolsOn(p.toChain);

  const num = parseFloat(p.amount) || 0;
  const numReceive = p.receive ? Number(p.receive.replace(/,/g, "")) : 0;
  const rate = num > 0 && numReceive > 0 ? numReceive / num : null;

  const handleChain = (side: Side, chain: number) => {
    const opts = symbolsOn(chain);
    if (side === "from") {
      p.setFromChain(chain);
      if (!opts.includes(p.fromToken)) p.setFromToken(opts[0] ?? "ETH");
    } else {
      p.setToChain(chain);
      if (!opts.includes(p.toToken)) p.setToToken(opts[0] ?? "ETH");
    }
  };

  const handleFind = async () => {
    setLoading(true);
    try {
      await p.onFind();
    } finally {
      setLoading(false);
    }
  };

  const disabled =
    loading || !(num > 0) || fromOptions.length === 0 || toOptions.length === 0;

  const ChainSelect = ({ side }: { side: Side }) => {
    const chain = side === "from" ? p.fromChain : p.toChain;
    const set = side === "from" ? p.setFromChain : p.setToChain;
    return (
      <div className="chain-select-wrap">
        <Logo src={chainLogo(chain)} fallback="net" size={18} />
        <select
          className="chain-select"
          value={chain}
          onChange={(e) => handleChain(side, Number(e.target.value))}
        >
          {CHAINS.filter((c) => c.id !== 0).map((c) => (
            <option key={c.id} value={c.id}>
              {c.name}
            </option>
          ))}
        </select>
      </div>
    );
  };

  const TokenBtn = ({ side }: { side: Side }) => {
    const chain = side === "from" ? p.fromChain : p.toChain;
    const sym = side === "from" ? p.fromToken : p.toToken;
    return (
      <button className="token-btn" onClick={() => setPicker(side)}>
        <Logo src={tokenLogo(sym, chain)} fallback={sym} size={24} />
        <span className="token-sym">{sym}</span>
        <span className="caret">▾</span>
      </button>
    );
  };

  return (
    <div className="card">
      <div className="field-label">
        <span>From</span>
        <span className="bal">Balance: {balance}</span>
      </div>
      <div className="field">
        <div className="pick-row">
          <ChainSelect side="from" />
          <TokenBtn side="from" />
        </div>
        <div className="amount-row">
          <input
            className="amount"
            inputMode="decimal"
            value={p.amount}
            onChange={(e) => p.setAmount(e.target.value.replace(/[^0-9.]/g, ""))}
            placeholder="0.0"
          />
          <button className="btn btn-mini" onClick={() => p.setAmount(balance.replace(/,/g, ""))}>
            MAX
          </button>
        </div>
      </div>

      <div className="swap-mid">
        <button className="swap-btn" onClick={p.onSwap} title="Switch direction">
          ⇅
        </button>
        <button
          className="rate-line"
          onClick={() => setInvertRate((v) => !v)}
          title="Reverse rate"
        >
          {rate
            ? invertRate
              ? `1 ${p.toToken} ≈ ${(1 / rate).toLocaleString("en-US", { maximumFractionDigits: 6 })} ${p.fromToken}`
              : `1 ${p.fromToken} ≈ ${rate.toLocaleString("en-US", { maximumFractionDigits: 4 })} ${p.toToken}`
            : "Enter an amount to see the rate"}
        </button>
      </div>

      <div className="field-label">
        <span>To</span>
        <span className="bal">Network fee {p.fee !== null ? `≈ $${p.fee.toFixed(2)}` : "—"}</span>
      </div>
      <div className="field">
        <div className="pick-row">
          <ChainSelect side="to" />
          <TokenBtn side="to" />
        </div>
        <div className="amount-row">
          <div className="amount receive-amount">{p.receive ? `~${p.receive}` : "—"}</div>
          <span className="receive-token">{p.toToken}</span>
        </div>
      </div>

      <div className="settings-row">
        <div className="setting">
          <button className="gear" onClick={() => setSettings((v) => !v)} title="Settings">
            ⚙
          </button>
          <span>
            Slippage: <b>{p.slippage}%</b>
          </span>
        </div>
        <label className="toggle">
          <input
            type="checkbox"
            className="switch"
            checked={p.atomic}
            onChange={(e) => p.setAtomic(e.target.checked)}
          />
          <span>⚡ Atomic Execution</span>
        </label>
      </div>

      {settings && (
        <div className="popover">
          <div className="popover-title">Swap settings</div>
          <div className="pop-label">Max slippage</div>
          <div className="slippage-row">
            {SLIPPAGE_PRESETS.map((s) => (
              <button
                key={s}
                className={`btn btn-mini ${p.slippage === s ? "active" : ""}`}
                onClick={() => p.setSlippage(s)}
              >
                {s === 0.1 ? "Auto" : `${s}%`}
              </button>
            ))}
          </div>
          <label className="pop-label">
            Custom
            <input
              className="amount slippage-input"
              inputMode="decimal"
              value={p.slippage}
              onChange={(e) =>
                p.setSlippage(Math.max(0, Math.min(50, Number(e.target.value) || 0)))
              }
            />
            %
          </label>
          <div className="pop-note">
            {p.atomic
              ? "Atomic lock ON: failure rolls back to source wallet."
              : "Non-atomic: failed steps are refunded one by one."}
          </div>
        </div>
      )}

      <button className="btn btn-primary" disabled={disabled} onClick={handleFind}>
        {loading ? (
          <>
            <span className="spin" /> Finding routes…
          </>
        ) : (
          "Find Best Route →"
        )}
      </button>

      <div className="from-note">Quotes from LI.FI + deBridge in real time</div>

      {picker && (
        <div className="overlay" onClick={() => setPicker(null)}>
          <div className="token-pop" onClick={(e) => e.stopPropagation()}>
            <div className="popover-title">
              Select token · {CHAINS.find((c) => c.id === (picker === "from" ? p.fromChain : p.toChain))?.name}
            </div>
            {(picker === "from" ? fromOptions : toOptions).map((t) => {
              const chain = picker === "from" ? p.fromChain : p.toChain;
              const set = picker === "from" ? p.setFromToken : p.setToToken;
              const active = (picker === "from" ? p.fromToken : p.toToken) === t;
              return (
                <button
                  key={t}
                  className={`token-row ${active ? "active" : ""}`}
                  onClick={() => {
                    set(t);
                    setPicker(null);
                  }}
                >
                  <Logo src={tokenLogo(t, chain)} fallback={t} size={26} />
                  <span className="token-row-sym">{t}</span>
                  <span className="token-row-bal">{BALANCES[t] ?? "—"}</span>
                  {active && <span className="token-check">✓</span>}
                </button>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/ui/ui.css">
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #0d0d13;
  --panel: #17171f;
  --panel-2: #20202c;
  --border: #2b2b3a;
  --text: #f0f0f5;
  --muted: #8e8ea3;
  --accent1: #ff007a;
  --accent2: #9945ff;
  --green: #2ecc71;
  --yellow: #f0b429;
  --blue: #3b82f6;
  --orange: #ff8a3d;
}

html,
body,
#root {
  height: 100%;
}

body {
  background:
    radial-gradient(1200px 600px at 70% -10%, rgba(153, 69, 255, 0.16), transparent 60%),
    radial-gradient(900px 500px at 10% 110%, rgba(255, 0, 122, 0.1), transparent 55%),
    var(--bg);
  color: var(--text);
  font-family: Inter, "Segoe UI", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.app {
  max-width: 640px;
  margin: 0 auto;
  padding: 20px 16px 64px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.logo {
  font-size: 20px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo-mark {
  background: linear-gradient(135deg, var(--accent1), var(--accent2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-size: 22px;
}

.logo-text {
  letter-spacing: 0.2px;
}

.btn {
  border: 0;
  border-radius: 14px;
  padding: 10px 18px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  font-family: inherit;
}

.btn-ghost {
  background: var(--panel-2);
  color: var(--text);
  border: 1px solid var(--border);
}

.btn-ghost:hover {
  border-color: var(--accent2);
}

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 16px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

.card + .card {
  margin-top: 14px;
}

.card.center {
  text-align: center;
  color: var(--muted);
}

.field-label {
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 14px 4px 8px;
  font-weight: 700;
}

.field-label:first-child {
  margin-top: 0;
}

.field {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 14px 16px;
  transition: border-color 0.15s;
}

.field:focus-within {
  border-color: var(--accent2);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

select,
input {
  background: transparent;
  border: 0;
  color: var(--text);
  font-weight: 700;
  outline: none;
  font-family: inherit;
}

select {
  appearance: none;
  cursor: pointer;
  padding-right: 16px;
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6'%3E%3Cpath d='M0 0l5 6 5-6z' fill='%238e8ea3'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right center;
}

option {
  background: var(--panel-2);
  color: var(--text);
}

.chain-select {
  width: 100%;
  font-size: 13px;
  color: var(--muted);
  font-weight: 600;
  margin-bottom: 8px;
}

.token-select {
  font-size: 22px;
}

.balance {
  font-size: 13px;
  color: var(--muted);
  text-align: right;
}

.amount {
  width: 100%;
  font-size: 34px;
  font-weight: 700;
  margin-top: 8px;
}

.amount::placeholder {
  color: #4a4a5c;
}

.swap-mid {
  display: flex;
  justify-content: center;
  margin: -12px 0;
  position: relative;
  z-index: 2;
}

.swap-btn {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: var(--panel-2);
  border: 3px solid var(--bg);
  font-size: 18px;
  cursor: pointer;
  color: var(--text);
  transition: transform 0.15s;
}

.swap-btn:hover {
  transform: rotate(180deg);
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16px 4px 14px;
  color: var(--muted);
  font-size: 13.5px;
}

.toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.switch {
  appearance: none;
  width: 40px;
  height: 22px;
  background: #3a3a4a;
  border-radius: 22px;
  position: relative;
  cursor: pointer;
  transition: background 0.2s;
  flex-shrink: 0;
}

.switch::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  transition: left 0.2s;
}

.switch:checked {
  background: linear-gradient(90deg, var(--accent1), var(--accent2));
}

.switch:checked::after {
  left: 21px;
}

.btn-primary {
  width: 100%;
  padding: 16px;
  font-size: 16px;
  border-radius: 16px;
  background: linear-gradient(90deg, var(--accent1), var(--accent2));
  color: #fff;
}

.btn-primary:hover:not(:disabled) {
  filter: brightness(1.1);
}

.btn-primary:disabled {
  opacity: 0.75;
  cursor: default;
}

.view-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 16px;
}

.view-title {
  font-weight: 800;
  font-size: 15.5px;
}

.link-btn {
  background: none;
  border: 0;
  color: var(--muted);
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  padding: 6px 0;
}

.link-btn:hover:not(:disabled) {
  color: var(--text);
}

.link-btn:disabled {
  opacity: 0.4;
  cursor: default;
}

.route-card {
  transition: border-color 0.15s, transform 0.15s;
}

.route-card:hover {
  border-color: rgba(153, 69, 255, 0.55);
  transform: translateY(-2px);
}

.route-top {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.badge {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 4px 10px;
  border-radius: 999px;
}

.badge-best {
  background: rgba(46, 204, 113, 0.15);
  color: var(--green);
}

.badge-fast {
  background: rgba(240, 180, 41, 0.15);
  color: var(--yellow);
}

.badge-atomic {
  background: rgba(59, 130, 246, 0.15);
