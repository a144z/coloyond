<file path="crates/etf-identity/src/lib.rs">
//! Canonical ETF v1 pool-configuration wire encoding and content identity.
//!
//! This crate owns only protocol-neutral encoding primitives. Policy payloads
//! remain opaque until their separate S5C/S5D2 amendments define strict inner
//! schemas; the checked-in vector is synthetic and fixture-only.

use borsh::{BorshDeserialize, BorshSerialize};
use sha2::{Digest, Sha256};

pub const CONFIG_DOMAIN: &[u8] = b"coloyond:etf:config:v1";
pub const CONFIG_VERSION_V1: u8 = 1;
pub const CONFIG_HASH_BYTES: usize = 32;
/// Matches the minimum allocation supported by `etf-math`'s weighted math.
const MIN_TARGET_WEIGHT_BPS: u16 = 100;

#[derive(Clone, Debug, BorshDeserialize, BorshSerialize, PartialEq, Eq)]
pub struct EtfPoolConfigV1 {
    pub protocol_version: u8,
    pub assets: Vec<EtfAssetConfigV1>,
    pub math_version: u16,
    pub fee_policy_id: [u8; 32],
    pub fee_policy_params: Vec<u8>,
    pub risk_policy_id: [u8; 32],
    pub risk_policy_params: Vec<u8>,
    /// Initial authorities are immutable pool-identity inputs. Current pool
    /// authorities may later change only through the delayed handoff flow.
    pub initial_governance_authority: [u8; 32],
    pub initial_emergency_guardian: [u8; 32],
    pub governance_delay_seconds: u64,
}

#[derive(Clone, Debug, BorshDeserialize, BorshSerialize, PartialEq, Eq)]
pub struct EtfAssetConfigV1 {
    pub mint: [u8; 32],
    pub token_program: [u8; 32],
    pub decimals: u8,
    pub oracle_mode: OracleModeV1,
    pub oracle_program: [u8; 32],
    pub oracle_account: [u8; 32],
    pub feed_id: [u8; 32],
    pub target_weight_bps: u16,
}

/// Borsh enum discriminants are the protocol tags: 0 is fixed Push Feed and
/// 1 is Receiver Full. Never reorder these variants.
#[derive(Clone, Copy, Debug, BorshDeserialize, BorshSerialize, PartialEq, Eq)]
pub enum OracleModeV1 {
    PushFeed,
    ReceiverFull,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum IdentityError {
    UnsupportedVersion,
    InvalidAssetCount,
    DuplicateMint,
    InvalidWeights,
    InvalidAuthorities,
    Serialization,
}

impl EtfPoolConfigV1 {
    pub fn validate(&self) -> Result<(), IdentityError> {
        if self.protocol_version != CONFIG_VERSION_V1 {
            return Err(IdentityError::UnsupportedVersion);
        }
        if !(2..=4).contains(&self.assets.len()) {
            return Err(IdentityError::InvalidAssetCount);
        }
        if self
            .assets
            .iter()
            .any(|asset| asset.target_weight_bps < MIN_TARGET_WEIGHT_BPS)
        {
            return Err(IdentityError::InvalidWeights);
        }
        for index in 0..self.assets.len() {
            if self.assets[index + 1..]
                .iter()
                .any(|asset| asset.mint == self.assets[index].mint)
            {
                return Err(IdentityError::DuplicateMint);
            }
        }
        let weight_sum = self
            .assets
            .iter()
            .try_fold(0_u32, |sum, asset| {
                sum.checked_add(u32::from(asset.target_weight_bps))
            })
            .ok_or(IdentityError::InvalidWeights)?;
        if weight_sum != 10_000 {
            return Err(IdentityError::InvalidWeights);
        }
        if self.initial_governance_authority == [0; 32]
            || self.initial_emergency_guardian == [0; 32]
            || self.initial_governance_authority == self.initial_emergency_guardian
        {
            return Err(IdentityError::InvalidAuthorities);
        }
        Ok(())
    }

    pub fn canonical_bytes(&self) -> Result<Vec<u8>, IdentityError> {
        self.validate()?;
        borsh::to_vec(self).map_err(|_| IdentityError::Serialization)
    }

    /// `maximum_bytes` must come from the caller's reviewed account/input-size
    /// limit. S5A has not frozen a production config-size ceiling.
    pub fn from_canonical_bytes(bytes: &[u8], maximum_bytes: usize) -> Result<Self, IdentityError> {
        if bytes.len() > maximum_bytes {
            return Err(IdentityError::Serialization);
        }
        preflight_vector_lengths(bytes)?;
        let config = Self::try_from_slice(bytes).map_err(|_| IdentityError::Serialization)?;
        config.validate()?;
        Ok(config)
    }

    pub fn config_hash(&self) -> Result<[u8; CONFIG_HASH_BYTES], IdentityError> {
        let bytes = self.canonical_bytes()?;
        let mut hasher = Sha256::new();
        hasher.update(CONFIG_DOMAIN);
        hasher.update(bytes);
        Ok(hasher.finalize().into())
    }

    pub fn strategy_id(&self) -> Result<String, IdentityError> {
        let hash = self.config_hash()?;
        let mut output = String::with_capacity(5 + hash.len() * 2);
        output.push_str("etf1:");
        for byte in hash {
            use std::fmt::Write;
            write!(&mut output, "{byte:02x}").expect("String writing is infallible");
        }
        Ok(output)
    }

    /// PDA seeds without a program ID. An address cannot be derived until the
    /// deployment's program ID is pinned; callers must not invent one here.
    pub fn pool_pda_seeds(&self) -> Result<[Vec<u8>; 2], IdentityError> {
        Ok([b"etf_pool_v1".to_vec(), self.config_hash()?.to_vec()])
    }
}

/// Reject impossible vector prefixes before Borsh allocates from attacker- or
/// network-supplied lengths. The fixed asset record is 164 bytes in v1.
fn preflight_vector_lengths(bytes: &[u8]) -> Result<(), IdentityError> {
    let mut offset = 0_usize;
    let version = *bytes.get(offset).ok_or(IdentityError::Serialization)?;
    if version != CONFIG_VERSION_V1 {
        return Err(IdentityError::UnsupportedVersion);
    }
    offset += 1;
    let asset_count = read_u32(bytes, &mut offset)? as usize;
    if !(2..=4).contains(&asset_count) {
        return Err(IdentityError::InvalidAssetCount);
    }
    advance(bytes, &mut offset, asset_count * 164)?;
    advance(bytes, &mut offset, 2 + 32)?;
    let fee_length = read_u32(bytes, &mut offset)? as usize;
    advance(bytes, &mut offset, fee_length)?;
    advance(bytes, &mut offset, 32)?;
    let risk_length = read_u32(bytes, &mut offset)? as usize;
    let risk_section_length = risk_length
        .checked_add(32 + 32 + 8)
        .ok_or(IdentityError::Serialization)?;
    advance(bytes, &mut offset, risk_section_length)?;
    if offset != bytes.len() {
        return Err(IdentityError::Serialization);
    }
    Ok(())
}

fn read_u32(bytes: &[u8], offset: &mut usize) -> Result<u32, IdentityError> {
    let end = offset.checked_add(4).ok_or(IdentityError::Serialization)?;
    let value = bytes
        .get(*offset..end)
        .ok_or(IdentityError::Serialization)?;
    *offset = end;
    Ok(u32::from_le_bytes(
        value.try_into().map_err(|_| IdentityError::Serialization)?,
    ))
}

fn advance(bytes: &[u8], offset: &mut usize, count: usize) -> Result<(), IdentityError> {
    let end = offset
        .checked_add(count)
        .ok_or(IdentityError::Serialization)?;
    if end > bytes.len() {
        return Err(IdentityError::Serialization);
    }
    *offset = end;
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    fn asset(seed: u8, weight: u16, oracle_mode: OracleModeV1) -> EtfAssetConfigV1 {
        EtfAssetConfigV1 {
            mint: [seed; 32],
            token_program: [seed + 1; 32],
            decimals: 6,
            oracle_mode,
            oracle_program: [seed + 2; 32],
            oracle_account: [seed + 3; 32],
            feed_id: [seed + 4; 32],
            target_weight_bps: weight,
        }
    }

    fn sample_config() -> EtfPoolConfigV1 {
        EtfPoolConfigV1 {
            protocol_version: 1,
            assets: vec![
                asset(1, 4_000, OracleModeV1::PushFeed),
                asset(11, 6_000, OracleModeV1::ReceiverFull),
            ],
            math_version: 7,
            fee_policy_id: [21; 32],
            fee_policy_params: vec![0xaa, 0xbb, 0xcc],
            risk_policy_id: [31; 32],
            risk_policy_params: vec![0x10, 0x20, 0x30, 0x40],
            initial_governance_authority: [41; 32],
            initial_emergency_guardian: [42; 32],
            governance_delay_seconds: 86_400,
        }
    }

    #[test]
    fn canonical_borsh_bytes_and_domain_hash_match_golden_vector() {
        let config = sample_config();
        let bytes = config.canonical_bytes().unwrap();
        assert_eq!(bytes.len(), 486);
        assert_eq!(hex(&bytes), GOLDEN_CONFIG_BYTES_HEX);
        assert_eq!(hex(&config.config_hash().unwrap()), GOLDEN_CONFIG_HASH_HEX);
        assert_eq!(
            config.strategy_id().unwrap(),
            format!("etf1:{GOLDEN_CONFIG_HASH_HEX}")
        );
        assert_eq!(
            EtfPoolConfigV1::from_canonical_bytes(&bytes, 1_024).unwrap(),
            config
        );
    }

    #[test]
    fn parser_rejects_trailing_bytes_and_invalid_weight_or_version() {
        let config = sample_config();
        let mut bytes = config.canonical_bytes().unwrap();
        bytes.push(0);
        assert_eq!(
            EtfPoolConfigV1::from_canonical_bytes(&bytes, 1_024),
            Err(IdentityError::Serialization)
        );

        let mut invalid = sample_config();
        invalid.protocol_version = 2;
        assert_eq!(invalid.validate(), Err(IdentityError::UnsupportedVersion));
        invalid = sample_config();
        invalid.assets[1].target_weight_bps = 5_999;
        assert_eq!(invalid.validate(), Err(IdentityError::InvalidWeights));

        invalid = sample_config();
        invalid.assets[1].mint = invalid.assets[0].mint;
        assert_eq!(invalid.validate(), Err(IdentityError::DuplicateMint));

        invalid = sample_config();
        invalid.initial_governance_authority = [0; 32];
        assert_eq!(invalid.validate(), Err(IdentityError::InvalidAuthorities));
        invalid = sample_config();
        invalid.initial_emergency_guardian = invalid.initial_governance_authority;
        assert_eq!(invalid.validate(), Err(IdentityError::InvalidAuthorities));
    }

    #[test]
    fn parser_bounds_vector_allocations_and_rejects_unknown_oracle_tags() {
        let mut bytes = sample_config().canonical_bytes().unwrap();
        bytes[70] = 2;
        assert_eq!(
            EtfPoolConfigV1::from_canonical_bytes(&bytes, 1_024),
            Err(IdentityError::Serialization)
        );

        let mut bytes = sample_config().canonical_bytes().unwrap();
        let fee_length_offset = 5 + 2 * 164 + 2 + 32;
        bytes[fee_length_offset..fee_length_offset + 4].copy_from_slice(&u32::MAX.to_le_bytes());
        assert_eq!(
            EtfPoolConfigV1::from_canonical_bytes(&bytes, 1_024),
            Err(IdentityError::Serialization)
        );
    }

    #[test]
    fn decoder_requires_an_explicit_size_ceiling_and_enforces_minimum_weight() {
        let bytes = sample_config().canonical_bytes().unwrap();
        assert_eq!(
            EtfPoolConfigV1::from_canonical_bytes(&bytes, bytes.len() - 1),
            Err(IdentityError::Serialization)
        );
        for weight in [0, 1, 99] {
            for asset_index in 0..2 {
                let mut below_floor = sample_config();
                below_floor.assets[asset_index].target_weight_bps = weight;
                below_floor.assets[1 - asset_index].target_weight_bps = 10_000 - weight;
                assert_eq!(
                    below_floor.validate(),
                    Err(IdentityError::InvalidWeights),
                    "asset {asset_index} weight {weight} bps must be rejected"
                );
                assert_eq!(
                    below_floor.canonical_bytes(),
                    Err(IdentityError::InvalidWeights),
                    "asset {asset_index} weight {weight} bps must not be canonically encoded"
                );
            }
        }

        let mut at_floor = sample_config();
        at_floor.assets[0].target_weight_bps = 100;
        at_floor.assets[1].target_weight_bps = 9_900;
        assert_eq!(at_floor.validate(), Ok(()));
        assert!(at_floor.canonical_bytes().is_ok());
    }

    #[test]
    fn pool_seed_vector_needs_no_unassigned_program_id() {
        let seeds = sample_config().pool_pda_seeds().unwrap();
        assert_eq!(seeds[0], b"etf_pool_v1");
        assert_eq!(hex(&seeds[1]), GOLDEN_CONFIG_HASH_HEX);
    }

    #[test]
    fn changing_either_initial_authority_changes_all_content_identities() {
        let baseline = sample_config();
        let baseline_hash = baseline.config_hash().unwrap();
        let baseline_strategy = baseline.strategy_id().unwrap();
        let baseline_pool_seeds = baseline.pool_pda_seeds().unwrap();

        let mutations: [fn(&mut EtfPoolConfigV1); 2] = [
            |config: &mut EtfPoolConfigV1| config.initial_governance_authority = [43; 32],
            |config: &mut EtfPoolConfigV1| config.initial_emergency_guardian = [44; 32],
        ];
        for mutate_authority in mutations {
            let mut changed = baseline.clone();
            mutate_authority(&mut changed);

            assert_ne!(
                changed.canonical_bytes().unwrap(),
                baseline.canonical_bytes().unwrap()
            );
            assert_ne!(changed.config_hash().unwrap(), baseline_hash);
            assert_ne!(changed.strategy_id().unwrap(), baseline_strategy);
            let changed_pool_seeds = changed.pool_pda_seeds().unwrap();
            assert_eq!(changed_pool_seeds[0], baseline_pool_seeds[0]);
            assert_ne!(changed_pool_seeds[1], baseline_pool_seeds[1]);
        }
    }

    fn hex(bytes: &[u8]) -> String {
        bytes.iter().map(|byte| format!("{byte:02x}")).collect()
    }

    const GOLDEN_CONFIG_BYTES_HEX: &str = "";
    const GOLDEN_CONFIG_HASH_HEX: &str =
        "f652f2378df696a731c4124ea4b33f439aae0c3b6fb3624dd21885a3e9edea67";
}
</file>

<file path="crates/etf-oracle/src/lib.rs">
//! Pyth account-mode parsing and validation for ETF v1.
//!
//! Fixed sponsored Push Feed PDAs are updated by Pyth's Push Oracle, which
//! posts into the Receiver account format. This adapter deliberately uses the
//! official Receiver SDK parser; it does not hand-parse account bytes.

use anchor_lang::prelude::*;
use anchor_lang::AccountDeserialize;
use pyth_solana_receiver_sdk::price_update::{
    get_feed_id_from_hex, PriceUpdateV2, VerificationLevel,
};

pub const PYTH_RECEIVER_PROGRAM_ID: Pubkey = pubkey!("rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ");
pub const SOL_USD_FEED_ACCOUNT: Pubkey = pubkey!("7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE");
pub const BTC_USD_FEED_ACCOUNT: Pubkey = pubkey!("4cSM2e6rvbGQUFiJbqytoVMi5GgghSMr8LwVrT9VPSPo");
pub const USDC_USD_FEED_ACCOUNT: Pubkey = pubkey!("Dpw1EAVrSB1ibxiDQyTAW6Zip3J4Btk2x4SgApQCeFbX");
pub const ETH_USD_FEED_ACCOUNT: Pubkey = pubkey!("4C3PyjeYu3pLxfWdQCczQ24tDc1KbxT6fbPgWncC8WZp");

pub const SOL_USD_FEED_ID: &str =
    "0xef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d";
pub const BTC_USD_FEED_ID: &str =
    "0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43";
pub const USDC_USD_FEED_ID: &str =
    "0xeaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a";
pub const ETH_USD_FEED_ID: &str =
    "0xff614c390706451d097053042206f6440a71793677011587f0f56f47d0a06303";

/// Representation scale used for prices. It is not an oracle confidence or
/// freshness policy; those limits are explicitly supplied by the caller.
pub const USD_FIXED_DECIMALS: u8 = 18;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum PinnedFeed {
    SolUsd,
    BtcUsd,
    UsdcUsd,
    EthUsd,
}

impl PinnedFeed {
    pub const fn address(self) -> Pubkey {
        match self {
            Self::SolUsd => SOL_USD_FEED_ACCOUNT,
            Self::BtcUsd => BTC_USD_FEED_ACCOUNT,
            Self::UsdcUsd => USDC_USD_FEED_ACCOUNT,
            Self::EthUsd => ETH_USD_FEED_ACCOUNT,
        }
    }

    pub const fn id_hex(self) -> &'static str {
        match self {
            Self::SolUsd => SOL_USD_FEED_ID,
            Self::BtcUsd => BTC_USD_FEED_ID,
            Self::UsdcUsd => USDC_USD_FEED_ID,
            Self::EthUsd => ETH_USD_FEED_ID,
        }
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct OracleLimits {
    pub maximum_age_seconds: u64,
    pub maximum_confidence_bps: u16,
    pub minimum_exponent: i32,
    pub maximum_exponent: i32,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct ValidatedPrice {
    pub mantissa: u64,
    pub confidence: u64,
    pub exponent: i32,
    pub publish_time: i64,
    /// Confidence / price, rounded upward, in basis points.
    pub confidence_bps: u128,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct FixedPriceInterval {
    pub lower: u128,
    pub midpoint: u128,
    pub upper: u128,
}

impl ValidatedPrice {
    /// Convert to an unsigned fixed-point value exactly. Reject unsupported
    /// exponents, overflow, or any conversion that would discard precision.
    pub fn to_fixed(self, decimals: u8) -> Result<u128> {
        raw_to_fixed(u128::from(self.mantissa), self.exponent, decimals)
    }

    pub fn to_usd_fixed(self) -> Result<u128> {
        self.to_fixed(USD_FIXED_DECIMALS)
    }

    /// Return the exact fixed-point Pyth `price ± conf` interval. The lower
    /// endpoint must remain positive; all endpoints must convert without loss.
    pub fn confidence_interval(self, decimals: u8) -> Result<FixedPriceInterval> {
        let lower = self
            .mantissa
            .checked_sub(self.confidence)
            .filter(|value| *value > 0)
            .ok_or_else(|| error!(OracleError::NonPositivePrice))?;
        let upper = u128::from(self.mantissa)
            .checked_add(u128::from(self.confidence))
            .ok_or_else(|| error!(OracleError::ArithmeticOverflow))?;

        Ok(FixedPriceInterval {
            lower: raw_to_fixed(u128::from(lower), self.exponent, decimals)?,
            midpoint: self.to_fixed(decimals)?,
            upper: raw_to_fixed(upper, self.exponent, decimals)?,
        })
    }
}

fn raw_to_fixed(mantissa: u128, exponent: i32, decimals: u8) -> Result<u128> {
    let shift = exponent
        .checked_add(i32::from(decimals))
        .ok_or_else(|| error!(OracleError::ArithmeticOverflow))?;
    if shift >= 0 {
        let scale =
            ten_to(u32::try_from(shift).map_err(|_| error!(OracleError::UnsupportedExponent))?)?;
        mantissa
            .checked_mul(scale)
            .ok_or_else(|| error!(OracleError::ArithmeticOverflow))
    } else {
        let divisor = ten_to(
            u32::try_from(
                shift
                    .checked_neg()
                    .ok_or_else(|| error!(OracleError::UnsupportedExponent))?,
            )
            .map_err(|_| error!(OracleError::UnsupportedExponent))?,
        )?;
        require!(mantissa % divisor == 0, OracleError::PrecisionLoss);
        Ok(mantissa / divisor)
    }
}

/// Decode one manifest-pinned fixed-feed PDA with the official SDK's account
/// parser. Live owner/address/state still must be established from Devnet.
pub fn decode_fixed_feed_account(
    feed: PinnedFeed,
    account_key: Pubkey,
    account_owner: Pubkey,
    data: &[u8],
) -> Result<PriceUpdateV2> {
    require_keys_eq!(account_key, feed.address(), OracleError::WrongFeedAccount);
    require_keys_eq!(
        account_owner,
        PYTH_RECEIVER_PROGRAM_ID,
        OracleError::WrongOracleOwner
    );
    // `PriceUpdateV2::LEN` reserves the maximum Borsh enum width for Partial
    // verification. Full serializes one byte shorter. Accept exactly those
    // two SDK-defined account lengths, without assuming how the final
    // allocation byte is initialized.
    require!(
        (PriceUpdateV2::LEN - 1..=PriceUpdateV2::LEN).contains(&data.len()),
        OracleError::InvalidAccountData
    );
    let mut bytes = data;
    PriceUpdateV2::try_deserialize(&mut bytes).map_err(|_| error!(OracleError::InvalidAccountData))
}

/// Validate the SDK-decoded fixed PDA against the selected feed and explicit
/// policy. The Push Oracle mode's update path is documented separately; this
/// function does not treat Full verification as a Push-specific guarantee.
pub fn validate_fixed_feed(
    feed: PinnedFeed,
    account_key: Pubkey,
    account_owner: Pubkey,
    update: &PriceUpdateV2,
    clock: &Clock,
    limits: OracleLimits,
) -> Result<ValidatedPrice> {
    require_keys_eq!(account_key, feed.address(), OracleError::WrongFeedAccount);
    require_keys_eq!(
        account_owner,
        PYTH_RECEIVER_PROGRAM_ID,
        OracleError::WrongOracleOwner
    );
    require!(
        limits.maximum_age_seconds <= i64::MAX as u64
            && limits.minimum_exponent <= limits.maximum_exponent,
        OracleError::InvalidPolicy
    );

    let feed_id = get_feed_id_from_hex(feed.id_hex())
        .map_err(|_| error!(OracleError::InvalidConfiguredFeedId))?;
    let price = update
        .get_price_no_older_than_with_custom_verification_level(
            clock,
            limits.maximum_age_seconds,
            &feed_id,
            VerificationLevel::Full,
        )
        .map_err(|_| error!(OracleError::InvalidPrice))?;
    require!(price.price > 0, OracleError::NonPositivePrice);
    require!(
        (limits.minimum_exponent..=limits.maximum_exponent).contains(&price.exponent),
        OracleError::UnsupportedExponent
    );
    require!(
        price.publish_time <= clock.unix_timestamp,
        OracleError::FuturePublishTime
    );

    let denominator =
        u128::try_from(price.price).map_err(|_| error!(OracleError::NonPositivePrice))?;
    let numerator = u128::from(price.conf)
        .checked_mul(10_000)
        .ok_or_else(|| error!(OracleError::ArithmeticOverflow))?;
    let confidence_bps = numerator
        .checked_add(denominator - 1)
        .ok_or_else(|| error!(OracleError::ArithmeticOverflow))?
        / denominator;
    require!(
        confidence_bps <= u128::from(limits.maximum_confidence_bps),
        OracleError::ConfidenceTooWide
    );

    let validated = ValidatedPrice {
        mantissa: u64::try_from(price.price).map_err(|_| error!(OracleError::NonPositivePrice))?,
        confidence: price.conf,
        exponent: price.exponent,
        publish_time: price.publish_time,
        confidence_bps,
    };
    // Keep a validated observation safe to consume as an executable interval:
    // a positive midpoint is insufficient when its lower confidence bound is
    // zero or negative, or when any endpoint cannot be represented exactly.
    validated.confidence_interval(USD_FIXED_DECIMALS)?;
    Ok(validated)
}

fn ten_to(power: u32) -> Result<u128> {
    let mut value = 1u128;
    for _ in 0..power {
        value = value
            .checked_mul(10)
            .ok_or_else(|| error!(OracleError::ArithmeticOverflow))?;
    }
    Ok(value)
}

#[error_code]
pub enum OracleError {
    #[msg("Oracle account key does not match the pinned feed")]
    WrongFeedAccount,
    #[msg("Oracle account owner does not match the Receiver program")]
    WrongOracleOwner,
    #[msg("Oracle account data could not be decoded by the pinned SDK")]
    InvalidAccountData,
    #[msg("Oracle policy is invalid")]
    InvalidPolicy,
    #[msg("Configured Pyth feed ID is invalid")]
    InvalidConfiguredFeedId,
    #[msg("Price is unavailable, stale, has the wrong feed, or is not Fully verified")]
    InvalidPrice,
    #[msg("Price must be positive")]
    NonPositivePrice,
    #[msg("Publish time is in the future")]
    FuturePublishTime,
    #[msg("Oracle confidence exceeds the configured limit")]
    ConfidenceTooWide,
    #[msg("Arithmetic overflow")]
    ArithmeticOverflow,
    #[msg("Price exponent is unsupported")]
    UnsupportedExponent,
    #[msg("Fixed-point conversion would lose precision")]
    PrecisionLoss,
}

