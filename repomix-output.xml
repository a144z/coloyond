.cr-desk-target-tools { display: flex; justify-content: flex-end; gap: 10px; margin: 8px 0 0; }
.cr-desk-lock[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
.cr-desk-lock:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
@media (width <= 720px) {
  .cr-desk-allocation .cr-desk-target { grid-template-columns: auto minmax(0, 1fr) auto; }
  .cr-desk-allocation .cr-desk-target .cr-desk-slider-input { grid-column: 1 / -1; }
  .cr-desk-allocation .cr-desk-target .cr-desk-target-delta { grid-column: 2; }
  .cr-desk-allocation .cr-desk-target .cr-input-suffix { grid-column: 3; grid-row: 1; }
  .cr-desk-allocation .cr-desk-target .cr-desk-lock { grid-column: 3; grid-row: 2; }
