      align-items: center;
      gap: 1rem;
    }

    .asset-color-block {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      border: 1px solid var(--rule-hairline);
    }

    .asset-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
    }

    .asset-sub {
      font-size: 10px;
      color: var(--lacquer-slate);
      display: block;
    }

    .target-slider-wrap {
      display: flex;
      align-items: center;
      gap: 1rem;
      max-width: 220px;
    }

    input[type=range] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 6px;
      background: var(--pulp-shade);
      border: 1px solid var(--rule-hairline);
      outline: none;
    }

    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px;
      height: 24px;
      background: var(--lacquer-ink);
      border: 1px solid var(--pulp-canvas);
      cursor: ew-resize;
    }

    input[type=range]::-moz-range-thumb {
      width: 16px;
      height: 24px;
      background: var(--lacquer-ink);
      border: 1px solid var(--pulp-canvas);
      cursor: ew-resize;
    }

    .val-pill {
      font-weight: 700;
      min-width: 48px;
      text-align: right;
    }

    .status-text-cell {
      font-size: 11px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* CRANK & BOUNDED LIMITS MATRIX */
    .limits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .limit-box {
      border: 1px solid var(--rule-hairline);
      padding: 1.25rem;
      background: #FFF;
    }

    .limit-label {
      font-size: 10px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--lacquer-slate);
      margin-bottom: 0.5rem;
      display: block;
    }

    .limit-value {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .limit-state {
      font-size: 11px;
      margin-top: 0.4rem;
      color: var(--lacquer-slate);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* PROOF LOG ACCORDION / STREAM */
    .proof-log-list {
      list-style: none;
      display: flex;
      flex-direction: column;
    }

    .proof-entry {
      border-bottom: 1px solid var(--rule-faint);
      padding: 1rem 0;
      display: grid;
      grid-template-columns: 100px 180px 1fr 140px;
      align-items: center;
      font-size: 12px;
      gap: 1rem;
    }

    .proof-entry:last-child {
      border-bottom: none;
    }

    .proof-slot {
      color: var(--lacquer-slate);
    }

    .proof-hash {
      font-weight: 700;
      text-decoration: underline;
      cursor: pointer;
    }

    .proof-bounds {
      font-size: 11px;
      color: var(--lacquer-slate);
    }

    .proof-verdict {
      text-align: right;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
    }

    /* DELEGATION ACTION FOOTER */
    .delegation-bar {
      margin-top: 1.5rem;
      padding: 1.25rem;
      background: var(--pulp-shade);
      border: 1px solid var(--rule-hairline);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }

    .delegation-meta-text {
      font-size: 11px;
      color: var(--lacquer-slate);
      max-width: 500px;
    }

    .delegation-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .btn-secondary {
      background: transparent;
      border: 1.5px solid var(--rule-hairline);
      color: var(--lacquer-ink);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0 1.25rem;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .btn-secondary:hover {
      background: rgba(20, 23, 26, 0.07);
    }

    /* FOOTER STRIP */
    footer.coloyond-footer {
      border-top: 2px solid var(--rule-hairline);
      padding: 2rem 2.5rem;
      background: var(--pulp-canvas);
      margin-top: auto;
    }

    .footer-inner {
      max-width: 1520px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: var(--lacquer-slate);
    }

    /* RESPONSIVENESS */
    @media (max-width: 1180px) {
      main.canvas-layout {
        grid-template-columns: 1fr;
        gap: 3rem;
      }

      .monument-column {
        order: 2;
      }

      .data-column {
        order: 1;
      }
    }

    @media (max-width: 768px) {
      header.system-bar {
        padding: 0 1rem;
      }

      .bar-inner {
        flex-direction: column;
        padding: 1rem 0;
        gap: 1rem;
      }

      nav.spine-nav {
        padding-left: 0;
        overflow-x: auto;
        width: 100%;
      }

      .vault-session {
        padding-left: 0;
        justify-content: space-between;
        width: 100%;
      }

      main.canvas-layout {
        padding: 1.5rem 1rem 3rem;
      }

      .limits-grid {
        grid-template-columns: 1fr;
      }

      .proof-entry {
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
      }
    }
  </style>
</head>
