    .lacquer-art-frame {
      width: 100%;
      height: 360px;
      background: #DDD5BF;
      border: 1px solid var(--rule-hairline);
      position: relative;
      overflow: hidden;
      display: grid;
      place-items: center;
    }

    .stencil-svg {
      width: 100%;
      height: 100%;
    }

    .art-caption {
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--rule-faint);
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .art-caption p {
      font-size: 12px;
      color: var(--lacquer-slate);
      line-height: 1.45;
    }

    .caption-meta {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--lacquer-ink);
    }

    /* RIGHT COLUMN: FINANCIAL FACTS & STRUCTURED PANELS */
    .data-column {
      display: flex;
      flex-direction: column;
      gap: 2.75rem;
    }

    .section-spine-heading {
      display: flex;
      align-items: baseline;
      gap: 1.5rem;
      border-bottom: 2px solid var(--rule-hairline);
      padding-bottom: 0.75rem;
    }

    .spine-large-num {
      font-family: var(--font-display);
      font-size: 3rem;
      font-weight: 700;
      line-height: 0.9;
      color: var(--lacquer-petrol);
    }

