/* --- Rebalance desk (Portfolio section C) --- */
.cr-desk { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(340px, .9fr); grid-template-areas: "drift plan" "targets run" "reserve reserve"; margin-top: 24px; background: var(--paper); border: 1px solid #c7c1b1; border-radius: 18px; overflow: hidden; box-shadow: 0 12px 28px #33301e08; }
.cr-desk-drift { grid-area: drift; }
.cr-desk-plan { grid-area: plan; }
.cr-desk-targets-block { grid-area: targets; }
.cr-desk-run { grid-area: run; }
.cr-desk-reserve { grid-area: reserve; }
.cr-desk-section { padding: 30px 31px 26px; }
.cr-desk-drift, .cr-desk-targets-block { border-right: 1px solid var(--rule); }
.cr-desk-drift, .cr-desk-plan { border-bottom: 1px solid var(--rule); }
.cr-desk-reserve { border-top: 1px solid var(--rule); }
.cr-desk-section p { max-width: 470px; margin: 14px 0 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
.cr-desk-number { margin: 18px 0 6px; font-size: 68px; letter-spacing: -.09em; line-height: .92; }
.cr-desk-number span { color: var(--muted); font-size: 15px; letter-spacing: -.04em; }
.cr-desk-section .cr-health-rule { margin: 22px 0 20px; }
.cr-desk-trigger { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); font: 10px/1.5 monospace; text-transform: uppercase; }
.cr-desk input[type="number"], .cr-desk .cr-input-suffix input { width: 90px; min-height: 40px; padding: 0 32px 0 10px; border: 1px solid #bbb5a5; border-radius: 6px; background: var(--field); color: var(--ink); font: 14px/1 Arial, Helvetica, sans-serif; text-align: right; }
.cr-desk .cr-input-suffix span { top: 11px; right: 10px; font-size: 11px; }
.cr-desk-note { margin: 14px 0 0; color: var(--muted); font: 10px/1.6 monospace; }
.cr-desk-targets { display: grid; gap: 8px; margin-top: 16px; }
.cr-desk-target { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--rule); }
.cr-desk-target-name strong { display: block; font-size: 16px; letter-spacing: -.04em; }
.cr-desk-target-name small { display: block; margin-top: 2px; color: var(--muted); font-size: 10px; }
.cr-desk .cr-error button { margin-left: 10px; }
.cr-desk-quiet { margin: 18px 0 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
.cr-desk-legs { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
.cr-desk-legs thead th { padding: 0 0 8px; border-bottom: 1px solid var(--rule); color: var(--muted); font: 10px/1.4 monospace; font-weight: 400; text-align: right; }
.cr-desk-legs thead th:first-child { text-align: left; }
.cr-desk-legs tbody th, .cr-desk-legs td { padding: 12px 0; border-bottom: 1px solid var(--rule); text-align: right; font-size: 14px; }
.cr-desk-legs tbody th { text-align: left; font-weight: 400; font-size: 15px; letter-spacing: -.03em; }
.cr-desk-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 18px; }
.cr-desk-steps { margin: 18px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
.cr-desk-steps li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--rule); color: #8c897f; font: 10px/1.4 monospace; text-transform: uppercase; }
