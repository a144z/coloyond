<file path="coloyond-beta/src/components/ui/AssetPickerSheet.tsx">
import { useEffect, useMemo, useState } from 'react';
import { MagnifyingGlass } from '@phosphor-icons/react';
import { useStore } from '../../lib/store';
import { assetList, assetSpec } from '../../lib/solana/assets';
import { ALIASED_COINBASE_IDS } from '../../lib/solana/coinbase';
import { priceOf } from '../../lib/solana/price';
import { fmtUsd } from '../../lib/format';
import { Sheet } from './Sheet';
import { inputClass } from './Field';
import { AssetSwatch, Notice } from './primitives';

/** Hard cap on rendered universe rows — refine the search to see more. */
const MAX_ROWS = 60;

/**
 * Discover Coinbase-listed assets while only enabling mints supported by the
 * deployed vault program.
 */
export function AssetPickerSheet({
  open,
  onClose,
  onSelect,
  exclude,
}: {
  open: boolean;
  onClose: () => void;
  onSelect: (assetId: string) => void;
  exclude: string[];
}) {
  const universe = useStore((s) => s.universe);
  const universeError = useStore((s) => s.universeError);
  const refreshUniverse = useStore((s) => s.refreshUniverse);
  const price = useStore((s) => s.price);
  const [query, setQuery] = useState('');

  useEffect(() => {
    if (open && universe.length === 0) void refreshUniverse();
  }, [open, universe.length, refreshUniverse]);

  const q = query.trim().toLowerCase();
  const core = assetList();
  const results = useMemo(() => {
    return universe
      .filter((a) => !exclude.includes(a.id) && !ALIASED_COINBASE_IDS.includes(a.id))
      .filter((a) => !q || a.symbol.toLowerCase().includes(q) || a.name.toLowerCase().includes(q));
  }, [universe, exclude, q]);
  const shown = results.slice(0, MAX_ROWS);

  function pick(id: string) {
    onSelect(id);
    setQuery('');
    onClose();
  }

  return (
    <Sheet open={open} onClose={onClose} micro="Devnet assets · executable set" title="Add an asset">
      <div className="relative">
        <MagnifyingGlass size={16} weight="bold" className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-iron" aria-hidden />
        <input
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          className={`${inputClass} pl-9`}
          placeholder="Search the Coinbase list…"
          aria-label="Search assets by symbol or name"
          autoComplete="off"
        />
      </div>

      <div className="mt-4">
        <p className="font-mono text-[10px] font-medium uppercase tracking-[0.08em] text-iron">Vault-program assets</p>
        <ul className="mt-1">
          {core
            .filter((s) => !exclude.includes(s.id))
            .map((s) => (
              <li key={s.id}>
                <PickRow id={s.id} symbol={s.symbol} name={`${s.name}${s.synthetic ? ' · Devnet test asset' : ''}`} price={priceOf(price, s.id)} onPick={pick} />
              </li>
            ))}
        </ul>
      </div>

      <div className="mt-4">
        <p className="font-mono text-[10px] font-medium uppercase tracking-[0.08em] text-iron">
          Coinbase discovery · {results.length} listed with USD markets
        </p>
        <ul className="mt-1">
          {shown.map((a) => (
            <li key={a.id}>
              <PickRow
                id={a.id}
                symbol={a.symbol}
                name={a.name}
                price={priceOf(price, a.id)}
                onPick={pick}
                disabled
              />
            </li>
          ))}
        </ul>
        {results.length > shown.length ? (
          <p className="py-2.5 text-[11px] text-iron">
            {results.length - shown.length} more — refine the search to narrow the list.
          </p>
        ) : null}
        {universe.length === 0 && !universeError ? (
          <p className="py-2.5 text-[12px] text-iron">Reading the Coinbase list…</p>
        ) : null}
        {universeError ? (
          <div className="mt-2">
            <Notice tone="brass" title="Coinbase list unavailable">
              {universeError} The executable Devnet assets above still work; the list retries on the
              next scheduler tick.
            </Notice>
          </div>
        ) : null}
      </div>
    </Sheet>
  );
}

function PickRow({
  id,
  symbol,
  name,
  price,
  onPick,
  disabled = false,
}: {
  id: string;
  symbol: string;
  name: string;
  price: number | null;
  onPick: (id: string) => void;
  disabled?: boolean;
}) {
  return (
    <button
      type="button"
      disabled={disabled}
      onClick={() => onPick(id)}
      className="flex w-full items-center justify-between gap-3 border-b border-hairline py-2.5 text-left last:border-b-0 hover:bg-ink/5 disabled:cursor-not-allowed disabled:opacity-55"
    >
      <span className="flex min-w-0 items-center gap-2 text-[12px] font-bold">
        <AssetSwatch color={assetSpec(id).color} />
        {symbol}
        <span className="truncate font-normal text-iron">· {name}</span>
      </span>
      <span className="shrink-0 text-right font-mono text-[11px] text-iron">
        {price !== null ? fmtUsd(price) : '—'}{disabled ? <span className="block text-[9px] uppercase">not executable</span> : null}
      </span>
    </button>
  );
}
</file>

<file path="coloyond-beta/src/components/ui/Button.tsx">
import { forwardRef, type ButtonHTMLAttributes, type ReactNode } from 'react';

type Variant = 'primary' | 'secondary' | 'danger' | 'ghost';

interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: Variant;
  full?: boolean;
  loading?: boolean;
  leading?: ReactNode;
}

const variantClasses: Record<Variant, string> = {
  primary:
    'bg-ink text-ledger border-2 border-ink hover:shadow-btn active:shadow-none active:translate-x-[1px] active:translate-y-[1px]',
  secondary:
    'bg-transparent text-ink border-2 border-ink hover:bg-ink/5 active:translate-x-[1px] active:translate-y-[1px]',
  danger:
    'bg-transparent text-danger border-2 border-danger hover:bg-danger/5 active:translate-x-[1px] active:translate-y-[1px]',
  ghost:
    'bg-transparent text-petrol border-0 px-1 underline underline-offset-4 hover:text-ink active:translate-y-[1px]',
};

/**
 * Ledger button: sharp corners, ink rules, 48px hit target, uppercase mono.
 * The primary variant carries the attention spectrum as a 3px top edge,
 * exactly like the flash-ui reference's btn-attention.
 */
export const Button = forwardRef<HTMLButtonElement, ButtonProps>(function Button(
  { variant = 'secondary', full = false, loading = false, leading, className = '', children, disabled, ...rest },
  ref,
) {
  return (
    <button
      ref={ref}
      disabled={disabled || loading}
      className={`relative inline-flex min-h-12 select-none items-center justify-center gap-2 px-4 font-mono text-[12px] font-bold uppercase tracking-[0.06em] transition-all duration-150 disabled:pointer-events-none disabled:opacity-50 ${
        variantClasses[variant]
      } ${full ? 'w-full' : ''} ${className}`}
      {...rest}
    >
      {variant === 'primary' && (
        <span aria-hidden className="band-attention absolute inset-x-0 top-0 h-[3px]" />
      )}
      {loading ? (
        <span
          aria-hidden
          className="h-2.5 w-2.5 animate-[coloyond-pulse_0.9s_ease-in-out_infinite] bg-current"
        />
      ) : (
        leading
      )}
      {children}
    </button>
  );
});
