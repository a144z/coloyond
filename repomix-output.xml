        PriceUpdateV2 {
            write_authority: Pubkey::new_unique(),
            verification_level,
            price_message: PriceFeedMessage {
                feed_id: get_feed_id_from_hex(feed.id_hex()).unwrap(),
                price,
                conf,
                exponent: -8,
                publish_time,
                prev_publish_time: publish_time.saturating_sub(1),
                ema_price: price,
                ema_conf: conf,
            },
            posted_slot: 1,
        }
    }

    fn clock() -> Clock {
        Clock {
            unix_timestamp: NOW,
