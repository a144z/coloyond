    .section-title-wrap h2 {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      text-transform: uppercase;
    }

    .section-subtext {
      font-size: 12px;
      color: var(--lacquer-slate);
      margin-top: 0.25rem;
    }

    /* LEDGER PANELS */
    .ledger-panel {
      background: var(--ledger-white);
      border: 2px solid var(--rule-hairline);
      box-shadow: 6px 6px 0px rgba(20, 23, 26, 0.1);
      position: relative;
