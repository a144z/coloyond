.cr-desk-slider-input { appearance: none; flex: 1 1 140px; width: 100%; min-height: 44px; margin: 0; background: transparent; cursor: pointer; }
.cr-desk-slider-input::-webkit-slider-runnable-track { height: 10px; border: 1px solid var(--rule); border-radius: 5px; background: var(--cr-split-track, var(--field)); }
.cr-desk-slider-input::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 22px; height: 22px; margin-top: -6px; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); }
.cr-desk-slider-input::-moz-range-track { height: 10px; border: 1px solid var(--rule); border-radius: 5px; background: var(--cr-split-track, var(--field)); }
.cr-desk-slider-input::-moz-range-thumb { border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); height: 20px; width: 20px; }
.cr-desk-slider-input:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
