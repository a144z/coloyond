.cr-sym-table { width: 100%; margin-top: 22px; border-collapse: collapse; font-variant-numeric: tabular-nums; }
.cr-sym-table th { padding: 0 0 8px; border-bottom: 1px solid var(--rule); color: var(--muted); font: 10px/1.4 monospace; font-weight: 400; text-transform: uppercase; text-align: right; }
.cr-sym-table th:first-child { text-align: left; }
.cr-sym-table td { padding: 10px 0; border-bottom: 1px solid var(--rule); text-align: right; font-size: 14px; }
.cr-sym-table td:first-child { text-align: left; }
.cr-sym-actions { display: grid; gap: 16px; margin-top: 22px; }
.cr-sym-action { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 14px 0; border-top: 1px solid var(--rule); }
.cr-sym-action p { flex: 1 1 260px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
.cr-sym-action button { min-height: 40px; padding: 0 16px; border: 1px solid var(--ink); border-radius: 8px; background: var(--ink); color: var(--paper); font: 11px/1 monospace; text-transform: uppercase; cursor: pointer; }
