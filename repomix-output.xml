import { lazy, Suspense, useState } from "react";
import "./AuctionWorkbench.css";
import "./LocalnetWorkbench.css";

const LocalnetWorkbench = lazy(() => import("./LocalnetWorkbench.js").then((module) => ({ default: module.LocalnetWorkbench })));
import {
  applyWorkbenchAction,
  createWorkbenchState,
  portfolioWeights,
  setWorkbenchScenario,
  type WorkbenchAction,
  type WorkbenchScenario,
  type WorkbenchState,
} from "./workbenchController.js";

const SCENARIOS: Array<{ id: WorkbenchScenario; title: string; description: string }> = [
  { id: "eligible", title: "Fresh / eligible", description: "A scripted 56 / 44 portfolio can open and take two partial-fill steps." },
  { id: "stale-oracle", title: "Stale oracle", description: "The start attempt should be rejected without changing custody balances." },
  { id: "paused", title: "Risk paused", description: "The start attempt should be rejected while risk is paused." },
];

const ACTIONS: Array<{ id: WorkbenchAction; label: string }> = [
  { id: "replay", label: "Replay previous fill" },
  { id: "wrong-feed", label: "Try wrong feed" },
  { id: "adverse-price", label: "Try adverse price" },
  { id: "oversize", label: "Try oversize fill" },
];

function amount(value: number, decimals = 2): string {
  return value.toLocaleString("en-US", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
}

function phaseLabel(phase: WorkbenchState["phase"]): string {
  return ({ ready: "Ready to simulate", open: "Auction open", partial: "Partially filled", complete: "Fill complete", expired: "Expired", closed: "Closed" })[phase];
}

function AssetRow({ label, target, actual, amountText }: { label: string; target: number; actual: number; amountText: string }) {
  const bounded = Math.max(0, Math.min(actual, 100));
  return (
    <div className="aw-asset-row">
      <div className="aw-asset-heading"><strong>{label}</strong><span>{amountText}</span></div>
      <div className="aw-track" aria-label={`${label}: target ${target.toFixed(0)} percent, fixture actual ${bounded.toFixed(1)} percent`}>
        <span className="aw-target-mark" style={{ left: `${target}%` }} />
        <span className="aw-actual-fill" style={{ width: `${bounded}%` }} />
      </div>
      <div className="aw-asset-facts"><span>Target <b>{target.toFixed(0)}%</b></span><span>Fixture actual <b>{bounded.toFixed(1)}%</b></span></div>
    </div>
  );
}

export function AuctionWorkbench() {
  const [mode, setMode] = useState<"localnet" | "fixture">("localnet");
  if (mode === "fixture") return <FixtureWorkbench onLocalnetMode={() => setMode("localnet")} />;
  return (
    <div className="cr-app aw-app">
      <div className="cr-shell">
        <header className="cr-topbar aw-topbar">
          <a className="cr-brand" href="/" aria-label="Return to Coloyond home">coloyond<span className="cr-brand-mark" aria-hidden="true">✳</span></a>
          <div className="cr-topbar-right"><span className="cr-demo-label">Localnet SBF workbench</span><a className="cr-reference-link" href="/">Back to app <span aria-hidden="true">↗</span></a></div>
        </header>
        <main className="aw-main"><Suspense fallback={<p className="aw-empty-state">Loading the Localnet workbench…</p>}><LocalnetWorkbench onFixtureMode={() => setMode("fixture")} /></Suspense></main>
      </div>
    </div>
  );
}

function FixtureWorkbench({ onLocalnetMode }: { onLocalnetMode(): void }) {
  const [state, setState] = useState(() => createWorkbenchState());
  const weights = portfolioWeights(state.balances);
  const active = state.phase === "open" || state.phase === "partial";
  const run = (action: WorkbenchAction) => setState((current) => applyWorkbenchAction(current, action));

  return (
    <div className="cr-app aw-app">
      <div className="cr-shell">
        <header className="cr-topbar aw-topbar">
          <a className="cr-brand" href="/" aria-label="Return to Coloyond home">coloyond<span className="cr-brand-mark" aria-hidden="true">✳</span></a>
          <div className="cr-topbar-right"><span className="cr-demo-label">CP2a browser fixture</span><button className="cr-reference-link aw-mode-top-button" type="button" onClick={onLocalnetMode}>Switch to Localnet SBF <span aria-hidden="true">↗</span></button><a className="cr-reference-link" href="/">Back to app <span aria-hidden="true">↗</span></a></div>
        </header>

        <main className="aw-main">
          <div className="aw-eyebrow">S2 / CP2a · Browser fixture mode</div>
          <section className="aw-intro">
            <div><p className="cr-eyebrow">coloyond / rebalancing lab</p><h1>Auction, in sequence.</h1><p className="aw-lede">Walk through an eligible auction, a partial fill, a rejected replay, and terminal close. This page rehearses the interaction and state presentation only.</p></div>
            <div className="aw-intro-index"><span>INTERACTIVE FIXTURE</span><strong>01—04</strong><small>No wallet · No RPC · No transaction</small></div>
          </section>

          <section className="aw-truth-banner" aria-label="Simulation notice">
            <span className="aw-truth-mark" aria-hidden="true">!</span>
            <div><strong>SYNTHETIC FIXTURE — NOT ON-CHAIN</strong><p>All balances, oracle states, fills, and results below are scripted in this browser. No Solana cluster is contacted; fixture playback is not evidence that the Anchor program executed.</p></div>
            <span className="aw-network-chip">NO NETWORK</span>
          </section>

          <section className="aw-control-row" aria-label="Fixture controls">
            <label className="aw-scenario-select"><span>01 / Scenario</span><select value={state.scenario} onChange={(event) => setState((current) => setWorkbenchScenario(current, event.target.value as WorkbenchScenario))}>{SCENARIOS.map((scenario) => <option key={scenario.id} value={scenario.id}>{scenario.title}</option>)}</select></label>
            <p>{SCENARIOS.find((scenario) => scenario.id === state.scenario)?.description}</p>
            <button className="aw-reset-button" type="button" onClick={() => setState(createWorkbenchState(state.scenario))}>Reset scenario <span aria-hidden="true">↺</span></button>
          </section>

          <section className="aw-overview" aria-label="Fixture status">
            <article><span>Environment</span><strong>Local fixture</strong><small>synthetic / static</small></article>
            <article><span>Oracle</span><strong>{state.scenario === "stale-oracle" ? "Stale" : "Fixture fresh"}</strong><small>{state.scenario === "stale-oracle" ? "age check fails" : "age is illustrative"}</small></article>
            <article><span>Risk state</span><strong>{state.scenario === "paused" ? "Paused" : "Enabled in fixture"}</strong><small>not read from a vault</small></article>
            <article><span>Auction</span><strong>{phaseLabel(state.phase)}</strong><small>{state.sequence === null ? "no fixture intent" : `sequence ${state.sequence}`}</small></article>
          </section>

          <section className="aw-grid">
            <div className="aw-panel aw-portfolio-panel">
              <div className="aw-panel-heading"><div><span className="aw-index">02 / Fixture portfolio</span><h2>Target and actual</h2></div><span className="aw-sample-tag">SCRIPTED</span></div>
              <p className="aw-panel-copy">Static scenario values show how a fill changes the displayed mix. USD marks and weights are illustrative; no oracle math runs here.</p>
              <div className="aw-assets">
                <AssetRow label="WSOL" target={50} actual={weights.wsol} amountText={`${amount(state.balances.wsol, 1)} WSOL`} />
                <AssetRow label="USDC" target={50} actual={weights.usdc} amountText={`${amount(state.balances.usdc, 0)} USDC`} />
              </div>
              <div className="aw-summary-row"><span>Fixture NAV at $100 / WSOL</span><strong>${amount(state.balances.wsol * 100 + state.balances.usdc, 0)}</strong></div>
              <div className="aw-direction-note"><span aria-hidden="true">↗</span><p>The fixture sells WSOL and receives USDC. Fees, bounty liabilities, confidence intervals, and conservative NAV-loss math are intentionally not modelled in this UI rehearsal.</p></div>
            </div>

            <div className="aw-panel aw-actions-panel">
              <div className="aw-panel-heading"><div><span className="aw-index">03 / Walk the lifecycle</span><h2>Try each step</h2></div><span className="aw-step-count">{state.events.length.toString().padStart(2, "0")} actions</span></div>
              <div className="aw-lifecycle-actions">
                <button type="button" onClick={() => run("start")}>Attempt start <span>01</span></button>
                <button type="button" disabled={!active || state.scenario !== "eligible"} onClick={() => run("partial-fill")}>Apply partial fill <span>02</span></button>
                <button type="button" disabled={state.phase !== "partial" || state.scenario !== "eligible"} onClick={() => run("fill-remaining")}>Fill remaining amount <span>03</span></button>
                <button type="button" disabled={!active} onClick={() => run("expire")}>Force expiry scenario <span>04</span></button>
                <button type="button" disabled={state.phase !== "complete" && state.phase !== "expired"} onClick={() => run("close")}>Close terminal intent <span>05</span></button>
              </div>
              <div className="aw-script-note"><strong>Expected path</strong><span>Ready → open → partial → complete → closed</span></div>
            </div>
          </section>

          <section className="aw-adversarial-panel">
            <div><span className="aw-index">04 / Failure cases</span><h2>Rejected attempts</h2><p>Each control appends a scripted rejection and must preserve the displayed token amounts.</p></div>
            <div className="aw-adversarial-actions">{ACTIONS.map((action) => <button key={action.id} type="button" onClick={() => run(action.id)}>{action.label}<span aria-hidden="true">↗</span></button>)}</div>
          </section>

          <section className="aw-event-panel" aria-labelledby="aw-event-title">
            <div className="aw-panel-heading"><div><span className="aw-index">05 / Local interaction log</span><h2 id="aw-event-title">What happened</h2></div><span className="aw-sample-tag">NOT TRANSACTION LOGS</span></div>
            {state.events.length === 0 ? <p className="aw-empty-state">Choose a scenario and try an action. Synthetic results will appear here; this log has no signatures or slots.</p> : <ol className="aw-events" aria-live="polite">{state.events.map((event) => <li key={event.id} className={event.result === "rejected in fixture" ? "aw-event-rejected" : "aw-event-accepted"}><span className="aw-event-number">{event.id.toString().padStart(2, "0")}</span><div><strong>{event.action}</strong><p>{event.detail}</p></div><span className="aw-event-result">{event.result}</span></li>)}</ol>}
          </section>

          <footer className="aw-footer"><span>CP2a tests interaction and presentation only.</span><span>CP2b requires a Localnet UI connected to the SBF program.</span><a href="/">Return to the sample app ↗</a></footer>
        </main>
      </div>
    </div>
  );
}
</file>

<file path="src/ui/rebalancing/cardMapping.test.ts">
import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import test from "node:test";
import { PublicKey } from "@solana/web3.js";
import { mapCardToPublishedVault, type PublishedVaultSnapshot, type StrategyRecord } from "./cardMapping.js";
import type { ReadModelV1 } from "./types.js";

const TOKENS = [
  { mint: "So11111111111111111111111111111111111111112", tokenProgram: "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA", decimals: 9, targetBps: 6000 },
  { mint: "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v", tokenProgram: "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA", decimals: 6, targetBps: 4000 },
].sort((left, right) => compareBytes(new PublicKey(left.mint).toBytes(), new PublicKey(right.mint).toBytes()));

function canonicalize(value: unknown): string {
  if (value === null || typeof value === "string" || typeof value === "boolean" || typeof value === "number") return JSON.stringify(value)!;
  if (Array.isArray(value)) return `[${value.map(canonicalize).join(",")}]`;
  const object = value as Record<string, unknown>;
  return `{${Object.keys(object).sort().map((key) => `${JSON.stringify(key)}:${canonicalize(object[key])}`).join(",")}}`;
}

function managedStrategy(changes: Record<string, unknown> = {}): StrategyRecord {
  const value = {
    schema: "coloyond/ColoyondManagedStrategy/v1",
    cluster: "devnet",
    genesisHash: "a".repeat(64),
    programId: "BASKT7aKd8n7ibpUbwLP3Wiyxyi3yoiXsxBk4Hpumate",
    vaultAddress: "CBmmqkqszmEzHJqRx6ExKqq6TWLaDg3wpFcGhVm63HGW",
    shareMint: "69F1mz9iPdTJwPX8aUmx94HeiTncVuzRue3C8FU6u3bv",
    configurationRevision: "5",
    tokens: TOKENS,
    policyDigest: "b".repeat(64),
    sourceManifestRevision: "1",
    ...changes,
  };
  const canonical = canonicalize(value);
  const id = `cb3:${createHash("sha256").update("coloyond/ColoyondManagedStrategy/v1\0").update(canonical).digest("hex")}`;
  return { id, value };
}

function readModel(changes: Partial<ReadModelV1> = {}, record: StrategyRecord = managedStrategy()): ReadModelV1 {
  const strategy = record.value as Record<string, unknown>;
  const tokens = strategy.tokens as typeof TOKENS;
  return {
    schema: "coloyond/ReadModel/v1",
    network: { cluster: "devnet", genesisHash: strategy.genesisHash as string },
    source: { kind: "rpc", providerLabel: "Local RPC", observedAt: "2026-10-10T04:00:00.000Z", slot: "900" },
    program: { programId: strategy.programId as string, binaryHash: "c".repeat(64), verified: true },
    vault: {
      address: strategy.vaultAddress as string,
      shareMint: strategy.shareMint as string,
      configRevision: strategy.configurationRevision as string,
      phase: "active",
      target: tokens.map(({ mint, targetBps }) => ({ mint, symbol: "TEST", weightBps: targetBps })),
      actual: null,
      totalSupply: null,
      estimatedNavUsd: null,
      exit: { available: null, mode: "in_kind" },
    },
    oracle: [],
    auction: null,
    reserve: null,
    lastConfirmedTransition: null,
    ...changes,
  };
}

function snapshot(changes: Partial<PublishedVaultSnapshot> = {}): PublishedVaultSnapshot {
  return {
    strategy: managedStrategy(),
    publication: "published",
    verification: "verified-on-chain",
    freshness: "current",
    readModel: readModel(),
    ...changes,
  };
}

function compareBytes(left: Uint8Array, right: Uint8Array): number {
  for (let index = 0; index < left.length; index += 1) {
    if (left[index] !== right[index]) return left[index]! - right[index]!;
  }
  return 0;
}

test("only a local, current, explicitly published exact revision matches", async () => {
  const result = await mapCardToPublishedVault(managedStrategy(), "local", snapshot());
  assert.deepEqual(result, { state: "matched-published-revision", reason: "exact-match", vaultPhase: "active" });
  assert.equal("deposit" in result, false);
  assert.equal("authorize" in result, false);
});

test("imported records never become a published match", async () => {
  assert.deepEqual(
    await mapCardToPublishedVault(managedStrategy(), "imported", snapshot()),
    { state: "view-only", reason: "imported-record" },
  );
});

test("draft and historical card versions remain nonfinancial", async () => {
  assert.deepEqual(
    await mapCardToPublishedVault({ id: `cbd1:${"d".repeat(64)}`, value: { kind: "allocation-draft" } }, "local", snapshot()),
    { state: "draft", reason: "draft" },
  );
  for (const prefix of ["cb1", "cb2"]) {
    assert.deepEqual(
      await mapCardToPublishedVault({ id: `${prefix}:${"e".repeat(64)}`, value: {} }, "local", snapshot()),
      { state: "view-only", reason: "legacy-or-symmetry-record" },
    );
  }
});

test("missing, unpublished, unverified and stale snapshots fail closed", async () => {
  const candidate = managedStrategy();
  assert.equal((await mapCardToPublishedVault(candidate, "local", null)).reason, "no-published-vault");
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ publication: "unpublished" }))).reason, "not-published");
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ verification: "unverified" }))).reason, "unverified-on-chain");
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ freshness: "stale" }))).reason, "stale-configuration");
});

test("fixtures and incomplete read models cannot be presented as live matches", async () => {
  const candidate = managedStrategy();
  const fixture = readModel({ source: { ...readModel().source, kind: "fixture" } });
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ readModel: fixture }))).reason, "unverified-on-chain");
  const missingSlot = readModel({ source: { ...readModel().source, slot: null } });
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ readModel: missingSlot }))).reason, "unverified-on-chain");
  const oversizedSlot = readModel({ source: { ...readModel().source, slot: "18446744073709551616" } });
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ readModel: oversizedSlot }))).reason, "unverified-on-chain");
  const malformed = null as unknown as ReadModelV1;
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ readModel: malformed }))).reason, "unverified-on-chain");
});

test("read model must match the strategy's network, program, vault and target", async () => {
  const candidate = managedStrategy();
  const badProgram = readModel({ program: { ...readModel().program, programId: "11111111111111111111111111111111" } });
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ readModel: badProgram }))).reason, "unverified-on-chain");
  const badTarget = readModel({ vault: { ...readModel().vault, target: [{ mint: TOKENS[0]!.mint, symbol: "TEST", weightBps: 5_999 }, { mint: TOKENS[1]!.mint, symbol: "TEST", weightBps: 4_001 }] } });
  assert.equal((await mapCardToPublishedVault(candidate, "local", snapshot({ readModel: badTarget }))).reason, "unverified-on-chain");
});

test("a changed strategy revision never maps to the old published revision", async () => {
  const old = managedStrategy();
  const newer = managedStrategy({ configurationRevision: "6" });
  assert.notEqual(old.id, newer.id);
  assert.equal((await mapCardToPublishedVault(old, "local", snapshot({ strategy: newer, readModel: readModel({}, newer) }))).reason, "configuration-revision-mismatch");
});

test("tampered identity and malformed records fail closed", async () => {
  const original = managedStrategy();
  assert.equal((await mapCardToPublishedVault({ ...original, id: `cb3:${"0".repeat(64)}` }, "local", snapshot())).reason, "invalid-record");
  assert.equal((await mapCardToPublishedVault({ ...original, value: { ...(original.value as object), unexpected: true } }, "local", snapshot())).reason, "invalid-record");
  assert.equal((await mapCardToPublishedVault({ id: "not-an-id", value: {} }, "local", snapshot())).reason, "unsupported-strategy");
});

test("identity changes when the strategy target changes", async () => {
  const previous = managedStrategy();
  const changedTokens = TOKENS.map((token, index) => ({ ...token, targetBps: index === 0 ? 6100 : 3900 }));
  const next = managedStrategy({ tokens: changedTokens });
  assert.notEqual(previous.id, next.id);
  assert.equal((await mapCardToPublishedVault(previous, "local", snapshot({ strategy: next, readModel: readModel({}, next) }))).reason, "target-mints-or-weights-mismatch");
});
</file>

<file path="src/ui/rebalancing/cardMapping.ts">
import { PublicKey } from "@solana/web3.js";
import type { ReadModelV1 } from "./types.js";

const STRATEGY_SCHEMA = "coloyond/ColoyondManagedStrategy/v1";
const STRATEGY_DOMAIN = "coloyond/ColoyondManagedStrategy/v1\0";
const U64_MAX = (1n << 64n) - 1n;
const HEX_32 = /^[0-9a-f]{64}$/;
const ID = /^(cb1|cbd1|cb2|cb3):[0-9a-f]{64}$/;

export interface StrategyRecord {
  id: string;
  value: unknown;
}

export type RecordOrigin = "local" | "imported";
export type PublicationState = "published" | "unpublished";
export type VerificationState = "verified-on-chain" | "unverified";
export type FreshnessState = "current" | "stale";

/**
 * A chain/catalog adapter supplies this only after it has independently checked
 * publication, finalized account state and manifest data. It is evidence for a
 * UI classification, never a transaction capability.
 */
export interface PublishedVaultSnapshot {
  strategy: StrategyRecord;
  publication: PublicationState;
  verification: VerificationState;
  freshness: FreshnessState;
  readModel: ReadModelV1;
}

export type CardMappingReason =
  | "exact-match"
  | "imported-record"
  | "draft"
  | "legacy-or-symmetry-record"
  | "unsupported-strategy"
  | "invalid-record"
  | "no-published-vault"
  | "not-published"
  | "unverified-on-chain"
  | "stale-configuration"
  | "network-mismatch"
  | "program-mismatch"
  | "vault-mismatch"
  | "share-mint-mismatch"
  | "configuration-revision-mismatch"
  | "target-mints-or-weights-mismatch"
  | "policy-mismatch"
  | "manifest-revision-mismatch";

export type CardMappingResult =
  | { state: "matched-published-revision"; reason: "exact-match"; vaultPhase: ReadModelV1["vault"]["phase"] }
  | { state: "draft"; reason: "draft" }
  | { state: "view-only"; reason: Exclude<CardMappingReason, "exact-match" | "draft"> };

interface ManagedStrategyV1 {
  schema: typeof STRATEGY_SCHEMA;
  cluster: ReadModelV1["network"]["cluster"];
  genesisHash: string;
  programId: string;
  vaultAddress: string;
  shareMint: string;
  configurationRevision: string;
  tokens: Array<{ mint: string; tokenProgram: string; decimals: number; targetBps: number }>;
  policyDigest: string;
  sourceManifestRevision: "1";
}

interface CheckedStrategy {
  record: ManagedStrategyV1;
  canonicalJson: string;
}

/**
 * Maps an immutable card snapshot to a separately published and verified
 * strategy snapshot. A match is display-only. Any funded action must re-read
 * the current accounts and independently build and review a transaction.
 */
export async function mapCardToPublishedVault(
  record: StrategyRecord,
  origin: RecordOrigin,
  published: PublishedVaultSnapshot | null,
): Promise<CardMappingResult> {
  if (origin === "imported") return viewOnly("imported-record");

  const schema = isObject(record.value) ? record.value.schema : undefined;
  const kind = isObject(record.value) ? record.value.kind : undefined;
  if (record.id.startsWith("cbd1:") || kind === "allocation-draft") return { state: "draft", reason: "draft" };
  if (record.id.startsWith("cb1:") || record.id.startsWith("cb2:")) {
    return viewOnly("legacy-or-symmetry-record");
  }
  if (!record.id.startsWith("cb3:") || schema !== STRATEGY_SCHEMA) return viewOnly("unsupported-strategy");

  const candidate = await validateColoyondStrategy(record);
  if (!candidate) return viewOnly("invalid-record");
  if (published === null) return viewOnly("no-published-vault");
  if (published.publication !== "published") return viewOnly("not-published");
  if (published.verification !== "verified-on-chain") return viewOnly("unverified-on-chain");
  if (published.freshness !== "current") return viewOnly("stale-configuration");

  const live = await validateColoyondStrategy(published.strategy);
  if (!live || !readModelMatchesStrategy(published.readModel, live.record)) {
    return viewOnly("unverified-on-chain");
  }

  const mismatch = compareStrategies(candidate.record, live.record);
  if (mismatch !== null) return viewOnly(mismatch);
  return {
    state: "matched-published-revision",
    reason: "exact-match",
    vaultPhase: published.readModel.vault.phase,
  };
}

async function validateColoyondStrategy(input: StrategyRecord): Promise<CheckedStrategy | null> {
  try {
    if (!ID.test(input.id) || !input.id.startsWith("cb3:")) return null;
    if (!isObject(input.value) || !hasExactKeys(input.value, [
      "schema", "cluster", "genesisHash", "programId", "vaultAddress", "shareMint",
      "configurationRevision", "tokens", "policyDigest", "sourceManifestRevision",
    ])) return null;

    const value = input.value;
    if (value.schema !== STRATEGY_SCHEMA || !isCluster(value.cluster)) return null;
    if (!isHex32(value.genesisHash) || !isHex32(value.policyDigest)) return null;
    if (!isCanonicalPublicKey(value.programId) || !isCanonicalPublicKey(value.vaultAddress) || !isCanonicalPublicKey(value.shareMint)) return null;
    if (!isCanonicalU64(value.configurationRevision) || value.configurationRevision === "0") return null;
    if (value.sourceManifestRevision !== "1" || !Array.isArray(value.tokens) || value.tokens.length !== 2) return null;

    const tokens: ManagedStrategyV1["tokens"] = [];
    let totalBps = 0;
    let previousMint: Uint8Array | null = null;
    for (const item of value.tokens) {
      if (!isObject(item) || !hasExactKeys(item, ["mint", "tokenProgram", "decimals", "targetBps"])) return null;
      if (!isCanonicalPublicKey(item.mint) || !isCanonicalPublicKey(item.tokenProgram)) return null;
      if (item.mint === value.shareMint || !Number.isSafeInteger(item.decimals) || (item.decimals as number) < 0 || (item.decimals as number) > 18) return null;
      if (!Number.isSafeInteger(item.targetBps) || (item.targetBps as number) < 1 || (item.targetBps as number) > 10_000) return null;
      const mintBytes = new PublicKey(item.mint).toBytes();
      if (previousMint !== null && compareBytes(previousMint, mintBytes) >= 0) return null;
      previousMint = mintBytes;
      totalBps += item.targetBps as number;
      tokens.push({
        mint: item.mint,
        tokenProgram: item.tokenProgram,
        decimals: item.decimals as number,
        targetBps: item.targetBps as number,
      });
    }
    if (totalBps !== 10_000) return null;

    const record: ManagedStrategyV1 = {
      schema: STRATEGY_SCHEMA,
      cluster: value.cluster,
      genesisHash: value.genesisHash,
      programId: value.programId,
      vaultAddress: value.vaultAddress,
      shareMint: value.shareMint,
      configurationRevision: value.configurationRevision,
      tokens,
      policyDigest: value.policyDigest,
      sourceManifestRevision: "1",
    };
    const canonicalJson = canonicalize(record);
    const digest = await sha256Hex(`${STRATEGY_DOMAIN}${canonicalJson}`);
    if (input.id !== `cb3:${digest}`) return null;
    return { record, canonicalJson };
  } catch {
    return null;
  }
}

function readModelMatchesStrategy(model: ReadModelV1, strategy: ManagedStrategyV1): boolean {
  if (!isObject(model) || model.schema !== "coloyond/ReadModel/v1") return false;
  const network = model.network;
  const source = model.source;
  const program = model.program;
  const vault = model.vault;
  if (!isObject(network) || !isObject(source) || !isObject(program) || !isObject(vault)) return false;
  if (source.kind !== "rpc" || !isCanonicalU64(source.slot) || source.observedAt === null) return false;
  if (typeof source.observedAt !== "string" || !Number.isFinite(Date.parse(source.observedAt))) return false;
  if (network.cluster !== strategy.cluster || network.genesisHash !== strategy.genesisHash) return false;
  if (program.verified !== true || !isHex32(program.binaryHash) || program.programId !== strategy.programId) return false;
  if (vault.address !== strategy.vaultAddress || vault.shareMint !== strategy.shareMint) return false;
  if (vault.configRevision !== strategy.configurationRevision || !Array.isArray(vault.target)) return false;
  if (vault.target.length !== strategy.tokens.length || !vault.target.every((target) =>
    isObject(target) && typeof target.mint === "string" && Number.isSafeInteger(target.weightBps),
  )) return false;
  return strategy.tokens.every((token) => (vault.target as Array<Record<string, unknown>>).some((target) =>
    target.mint === token.mint && target.weightBps === token.targetBps,
  ));
}

function compareStrategies(candidate: ManagedStrategyV1, live: ManagedStrategyV1): Exclude<CardMappingReason, "exact-match" | "draft" | "imported-record" | "legacy-or-symmetry-record" | "unsupported-strategy" | "invalid-record" | "no-published-vault" | "not-published" | "unverified-on-chain" | "stale-configuration" | "read-model-unavailable"> | null {
  if (candidate.cluster !== live.cluster || candidate.genesisHash !== live.genesisHash) return "network-mismatch";
  if (candidate.programId !== live.programId) return "program-mismatch";
  if (candidate.vaultAddress !== live.vaultAddress) return "vault-mismatch";
  if (candidate.shareMint !== live.shareMint) return "share-mint-mismatch";
  if (candidate.configurationRevision !== live.configurationRevision) return "configuration-revision-mismatch";
  if (canonicalize(candidate.tokens) !== canonicalize(live.tokens)) return "target-mints-or-weights-mismatch";
  if (candidate.policyDigest !== live.policyDigest) return "policy-mismatch";
  if (candidate.sourceManifestRevision !== live.sourceManifestRevision) return "manifest-revision-mismatch";
  return null;
}

function isObject(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function hasExactKeys(value: Record<string, unknown>, expected: string[]): boolean {
  const keys = Object.keys(value);
  return keys.length === expected.length && expected.every((key) => Object.hasOwn(value, key));
}

function isCluster(value: unknown): value is ManagedStrategyV1["cluster"] {
  return value === "mainnet-beta" || value === "devnet" || value === "localnet";
}

function isHex32(value: unknown): value is string {
  return typeof value === "string" && HEX_32.test(value);
}

function isCanonicalPublicKey(value: unknown): value is string {
  if (typeof value !== "string") return false;
  try {
    return new PublicKey(value).toBase58() === value;
  } catch {
    return false;
  }
}

function isCanonicalU64(value: unknown): value is string {
  if (typeof value !== "string" || !/^(0|[1-9][0-9]*)$/.test(value)) return false;
  try {
    return BigInt(value) <= U64_MAX;
  } catch {
    return false;
  }
}

function compareBytes(left: Uint8Array, right: Uint8Array): number {
  for (let index = 0; index < left.length; index += 1) {
    if (left[index] !== right[index]) return left[index]! - right[index]!;
  }
  return 0;
}

/** The supported record contains only strings, booleans, arrays and bounded integers. */
function canonicalize(value: unknown): string {
  if (value === null || typeof value === "string" || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (Array.isArray(value)) return `[${value.map(canonicalize).join(",")}]`;
  if (isObject(value)) {
    return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${canonicalize(value[key])}`).join(",")}}`;
  }
  throw new TypeError("Unsupported canonical JSON value");
}

async function sha256Hex(value: string): Promise<string> {
  const digest = await globalThis.crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
}

function viewOnly(reason: Exclude<CardMappingReason, "exact-match" | "draft">): CardMappingResult {
  return { state: "view-only", reason };
}
</file>

