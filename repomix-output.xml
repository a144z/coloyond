.condition-status {
  margin-top: 82px;
  padding: 30px;
  background: var(--paper);
  border: 1px solid #c7c1b1;
  border-radius: 18px;
}
.condition-status-header,
.condition-status-rule-head,
.condition-status-history > div:first-child {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}
.condition-status-header h2 {
  margin: 13px 0 8px;
  font-size: clamp(30px, 3.5vw, 46px);
  line-height: 1;
  letter-spacing: -.065em;
}
.condition-status-header p:not(.cr-index) {
  max-width: 600px;
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}
.condition-status-header .cr-index,
.condition-status-rule .cr-index,
.condition-status-history .cr-index { color: var(--blue); }
.condition-status-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 14px; }
.condition-status-live-tag,
.condition-status-state {
  padding: 6px 9px;
  border: 1px solid var(--rule);
  border-radius: 20px;
  font: 9px/1.4 monospace;
  letter-spacing: .45px;
  text-transform: uppercase;
}
.condition-status-actions button {
  min-height: 37px;
  padding: 8px 13px;
  border: 1px solid var(--ink);
  border-radius: 5px;
  background: transparent;
  color: var(--ink);
  font-size: 11px;
}
.condition-status-actions button:hover:not(:disabled) { background: var(--ink); color: var(--paper); }
.condition-status-source {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 28px;
  border-top: 1px solid var(--rule);
  border-left: 1px solid var(--rule);
}
.condition-status-source > div { min-width: 0; padding: 13px 15px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
.condition-status-source dt,
.condition-status-observation span { color: var(--muted); font: 9px/1.4 monospace; text-transform: uppercase; letter-spacing: .4px; }
.condition-status-source dd { overflow-wrap: anywhere; margin: 7px 0 0; font: 11px/1.45 monospace; }
.condition-status-rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 20px; }
.condition-status-rule { min-width: 0; padding: 21px; border: 1px solid #c7c1b1; border-radius: 12px; background: var(--field); }
.condition-status-rule h3,
.condition-status-history h3 { margin: 8px 0 0; font-size: 20px; line-height: 1.15; letter-spacing: -.045em; }
.condition-status-state { display: inline-flex; flex: 0 0 auto; max-width: 190px; text-align: center; }
.condition-status-eligible { border-color: var(--blue); color: var(--blue); }
.condition-status-activated { border-color: #24743e; color: #24743e; }
.condition-status-expired,
.condition-status-stale,
.condition-status-paused { border-color: var(--coral); color: #a12c20; }
.condition-status-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; margin: 18px 0 0; border-top: 1px solid var(--rule); }
.condition-status-facts > div { min-width: 0; padding: 11px 0 8px; border-bottom: 1px solid var(--rule); }
.condition-status-facts dt { color: var(--muted); font: 9px/1.4 monospace; text-transform: uppercase; }
.condition-status-facts dd { overflow-wrap: anywhere; margin: 5px 0 0; font-size: 11px; line-height: 1.5; }
.condition-status-observation { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 15px; }
.condition-status-observation > div { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.condition-status-observation strong { overflow-wrap: anywhere; font-size: 10px; font-weight: 500; line-height: 1.45; }
.condition-status-observation code,
.condition-status-history code { grid-column: 1 / -1; overflow-wrap: anywhere; color: var(--muted); font: 10px/1.5 monospace; }
.condition-status-note,
.condition-status-empty,
.condition-status-empty-block,
.condition-status-message,
.condition-status-error {
  margin: 16px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
}
.condition-status-note { padding: 11px 13px; border-left: 2px solid var(--blue); background: #1249ed09; }
.condition-status-empty-block { display: flex; flex-direction: column; gap: 4px; padding: 17px; border: 1px dashed #c7c1b1; border-radius: 9px; }
.condition-status-empty-block strong { color: var(--ink); }
.condition-status-history { display: flex; justify-content: space-between; gap: 30px; margin-top: 19px; padding: 17px 0 0; border-top: 1px solid var(--rule); }
.condition-status-history p { max-width: 620px; margin: 0; color: var(--muted); font-size: 10px; line-height: 1.6; }
.condition-status-history a { color: var(--blue); }
.condition-status-history code { display: block; margin-top: 6px; }
.condition-status-error { padding: 12px 14px; border-left: 3px solid var(--coral); background: #ff513b11; color: var(--ink); }
.condition-status-account { margin: 15px 0 0; color: var(--muted); font: 9px/1.6 monospace; overflow-wrap: anywhere; }
.condition-status-account code { color: var(--ink); }
@media (max-width: 850px) {
  .condition-status { padding: 22px; }
  .condition-status-source { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 600px) {
  .condition-status { margin-top: 54px; padding: 18px; }
  .condition-status-header,
  .condition-status-rule-head,
  .condition-status-history { flex-direction: column; }
  .condition-status-actions { justify-content: space-between; width: 100%; }
  .condition-status-rules { grid-template-columns: 1fr; }
  .condition-status-facts,
  .condition-status-observation { grid-template-columns: 1fr; }
  .condition-status-observation code { grid-column: auto; }
}
