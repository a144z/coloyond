                feed_id: get_feed_id_from_hex(account_feed.id_hex()).unwrap(),
                price,
                conf: confidence,
                exponent: -8,
                publish_time,
                prev_publish_time: publish_time - 1,
                ema_price: price,
                ema_conf: confidence,
