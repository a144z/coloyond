    (1_000_000_000, 1_000_000_000, 1_000_000_000),
    (1_000_000_000_000, 1_000_000_000, 1_000_000_000_000),
)


def vectors():
    cases = set()
    for balances, weights in product(RESERVES, WEIGHT_PROFILES):
        for asset_in, asset_out in product(range(3), repeat=2):
