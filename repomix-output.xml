export type AtomicLevel = "full" | "partial" | "intent";

export type StepKind = "swap" | "bridge";

export interface Token {
  chainId: number;
  address: string;
  symbol: string;
  decimals: number;
}

export interface SwapRequest {
  fromToken: Token;
  toToken: Token;
