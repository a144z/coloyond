  <dialog id="shareDialog" aria-labelledby="dialogTitle">
    <h2 id="dialogTitle">Share card layout</h2>
    <div id="dialogCard"></div>
    <p>Illustrative export layout. The product renders a 1080 × 1350 PNG locally and exports the validated strategy separately.</p>
    <form method="dialog"><button class="button">Close preview</button></form>
  </dialog>
  <script>
    const study = document.getElementById('study');
    const captionChoice = document.getElementById('captionChoice');
    const captionVisible = document.getElementById('captionVisible');
    const allocation = document.getElementById('allocation');
    let remixVariation = 1;
    const parentStudy = 0;
    let savedExpression = { study: 0, caption: captionChoice.value, captionVisible: true };
    const illustrativeIds = {
      50: 'cbd1:9de257…af63d9', 60: 'cb2:7c4a91…e912b7', 70: 'cb2:a18f32…03c47e'
    };
    function art(kind, suffix, remix = false) {
      const blue = '#1249ed', yellow = '#ffd523', violet = '#8d25d9', coral = '#ff513b';
      const rotation = remix ? 9 : 0;
      const defs = `<defs>
        <linearGradient id="warm-${suffix}" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${coral}"/><stop offset="1" stop-color="${yellow}"/></linearGradient>
        <linearGradient id="cool-${suffix}" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${blue}"/><stop offset="1" stop-color="${violet}"/></linearGradient>
        <linearGradient id="ink-${suffix}" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#c3bdad"/><stop offset="1" stop-color="#171715"/></linearGradient>
        <filter id="grain-${suffix}" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".7" numOctaves="3" seed="17"/><feColorMatrix type="saturate" values="0"/><feComponentTransfer><feFuncA type="linear" slope=".10"/></feComponentTransfer></filter>
      </defs>`;
      let geometry = '';
      if (kind === 0) {
        geometry = `<g transform="rotate(${rotation} 180 170)">
          <path d="M48 120 180 48 250 88 119 162Z" fill="url(#ink-${suffix})"/>
          <path d="M48 120 119 162 119 250 48 209Z" fill="#999487"/>
          <path d="M119 162 180 129 180 216 119 250Z" fill="#171715"/>
          <path d="M180 48 250 88 250 165 180 129Z" fill="url(#warm-${suffix})"/>
          <path d="M180 129 250 165 180 216Z" fill="url(#cool-${suffix})"/>
          <path d="M157 207 360 115 360 172Z" fill="${coral}"/>
          <path d="M157 207 360 172 360 213Z" fill="${blue}"/>
          <path d="M157 207 360 213 360 262Z" fill="${yellow}"/>
          <path d="M157 207 360 262 360 318Z" fill="${violet}"/>
          <path d="M119 162 257 242 257 298 119 218Z" fill="url(#ink-${suffix})"/>
          <path d="M48 209 119 218 257 298 185 315Z" fill="#171715"/>
        </g>`;
      } else if (kind === 1) {
        geometry = `<g transform="rotate(${rotation-16} 180 180)">
          <circle cx="176" cy="176" r="98" fill="none" stroke="#171715" stroke-width="39" stroke-dasharray="440 176" transform="rotate(34 176 176)"/>
          <path d="M164 52 259 84 236 153 142 120Z" fill="url(#cool-${suffix})"/>
          <path d="M150 167 340 98 324 151 185 188Z" fill="${yellow}"/>
          <path d="M164 201 336 194 306 238 165 222Z" fill="${coral}"/>
          <path d="M151 235 270 283 234 312 139 255Z" fill="${violet}"/>
          <circle cx="176" cy="176" r="46" fill="#f7f2e5"/>
        </g>`;
      } else {
        geometry = `<g transform="rotate(${rotation} 180 180)">
          <path d="M43 85 158 43 158 245 43 286Z" fill="#171715"/>
          <path d="M43 85 102 113 216 72 158 43Z" fill="url(#ink-${suffix})"/>
          <path d="M102 113 216 72 216 175 102 216Z" fill="url(#cool-${suffix})"/>
          <path d="M178 212 300 169 300 261 178 307Z" fill="url(#warm-${suffix})"/>
          <path d="M178 212 208 227 329 184 300 169Z" fill="${yellow}"/>
          <path d="M300 169 329 184 329 277 300 261Z" fill="#171715"/>
          <path d="M32 315 144 275 157 283 47 324Z" fill="${violet}"/>
        </g>`;
      }
      const descriptions = [
        'Illustrative folded planes with cobalt, coral, yellow, and violet beams',
        'Illustrative interrupted black ring with saturated colored planes',
        'Illustrative offset slabs with an opening between blue and yellow forms'
      ];
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 360" role="img" aria-label="${descriptions[kind]}">${defs}${geometry}<rect width="360" height="360" filter="url(#grain-${suffix})" opacity=".7"/></svg>`;
    }
    function render() {
      const kind = Number(study.value);
      document.getElementById('createArt').innerHTML = art(kind, 'create');
      document.getElementById('shareArt').innerHTML = art(kind, 'share');
      document.getElementById('parentArt').innerHTML = art(parentStudy, 'parent');
      document.getElementById('remixArt').innerHTML = art((parentStudy + remixVariation) % 3, 'remix', true);
      document.getElementById('captionText').textContent = captionChoice.value;
      document.getElementById('captionText').classList.toggle('hidden', !captionVisible.checked);
      document.getElementById('remixCaption').style.visibility = captionVisible.checked ? 'visible' : 'hidden';
      const value = Number(allocation.value);
      document.getElementById('lstValue').textContent = `${value}%`;
      document.getElementById('usdcValue').textContent = `${100-value}%`;
      document.getElementById('remixId').textContent = illustrativeIds[value];
      document.getElementById('remixStatus').textContent = value === 60 ? 'Same saved strategy' : value === 50 ? 'Allocation draft · no vault' : 'Another sample vault';
      document.getElementById('remixExplanation').textContent = value === 50 ? 'Desired weights only. No matching vault or share mint is implied.' : value === 60 ? 'Another expression for the same saved strategy.' : 'Select another existing vault; the parent stays intact.';
      const dirty = kind !== savedExpression.study || captionChoice.value !== savedExpression.caption || captionVisible.checked !== savedExpression.captionVisible;
      document.getElementById('expressionState').textContent = dirty ? 'Unsaved expression' : 'Saved expression';
      document.getElementById('saveExpression').disabled = !dirty;
      document.getElementById('share').disabled = dirty;
    }
    function nextStudy() { study.value = String((Number(study.value) + 1) % 3); render(); document.getElementById('notice').textContent = 'Showing another authored visual study. The strategy ID stays the same.'; }
    [study, captionChoice, captionVisible].forEach(control => control.addEventListener('change', render));
    allocation.addEventListener('change', render);
    document.getElementById('generate').addEventListener('click', nextStudy);
    document.getElementById('anotherImage').addEventListener('click', nextStudy);
    document.getElementById('anotherCaption').addEventListener('click', () => { captionChoice.selectedIndex = (captionChoice.selectedIndex + 1) % captionChoice.options.length; render(); });
    document.getElementById('remix').addEventListener('click', () => { remixVariation = remixVariation === 1 ? 2 : 1; render(); document.getElementById('notice').textContent = 'Showing a sample remix expression. No financial action was performed.'; });
    document.getElementById('saveExpression').addEventListener('click', () => {
      savedExpression = { study: Number(study.value), caption: captionChoice.value, captionVisible: captionVisible.checked };
      render();
      document.getElementById('notice').textContent = 'Saved this illustrative expression for sharing. The imported remix parent stays intact.';
    });
    document.getElementById('share').addEventListener('click', () => {
      document.getElementById('dialogCard').innerHTML = document.getElementById('savedCard').outerHTML;
      document.querySelectorAll('#dialogCard [id]').forEach(element => element.removeAttribute('id'));
      document.querySelectorAll('#dialogCard svg').forEach(element => {
        element.innerHTML = art(savedExpression.study, 'dialog').replace(/^<svg[^>]*>/, '').replace(/<\/svg>$/, '');
      });
      document.getElementById('shareDialog').showModal();
    });
    render();
  </script>
</body>
</html>
