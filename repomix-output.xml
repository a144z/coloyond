      padding-left: 1rem;
    }

    /* NUMBERED SPINAL NAVIGATION (01 - 04) */
    nav.spine-nav {
      display: flex;
      align-items: stretch;
      flex-grow: 1;
      padding-left: 2rem;
    }

    .spine-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0 1.5rem;
      text-decoration: none;
      color: var(--lacquer-slate);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      border-right: 1px solid var(--rule-faint);
      transition: background-color 0.2s var(--ease-lacquer), color 0.2s var(--ease-lacquer);
      position: relative;
    }

    .spine-item:hover {
      background-color: var(--pulp-shade);
      color: var(--lacquer-ink);
    }

    .spine-item.is-active {
      color: var(--lacquer-ink);
      font-weight: 700;
      background-color: var(--pulp-shade);
    }

    .spine-item.is-active::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--lacquer-ink);
    }

    .spine-digit {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 700;
      color: var(--lacquer-petrol);
    }

    .vault-session {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding-left: 2rem;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 6px 12px;
      background: var(--ledger-white);
      border: 1px solid var(--rule-hairline);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .status-swatch {
      width: 8px;
      height: 8px;
      display: inline-block;
    }

    .swatch-petrol { background: var(--lacquer-petrol); }
    .swatch-amber { background: var(--lacquer-amber); }
    .swatch-slate { background: var(--lacquer-slate); }

    /* ATTENTION GRADIENT ACCENT / BUTTON */
    .rainbow-indicator {
      height: 4px;
      width: 100%;
      background: var(--rainbow-band);
    }

    .btn-attention {
      position: relative;
      background: var(--lacquer-ink);
      color: #FFF;
      border: 1.5px solid var(--lacquer-ink);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0 1.5rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      overflow: hidden;
    }

    .btn-attention::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--rainbow-band);
    }

