      padding: 0.75rem 1.75rem;
      border-bottom: 1px solid var(--rule-hairline);
      background: var(--ledger-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .ledger-body {
      padding: 1.75rem;
    }

