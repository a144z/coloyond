            PinnedFeed::UsdcUsd,
            PinnedFeed::EthUsd,
        ] {
            let feed_id = get_feed_id_from_hex(feed.id_hex()).unwrap();
            let (derived, _) = Pubkey::find_program_address(
                &[&shard_zero, feed_id.as_ref()],
                &push_oracle_program,
            );
            assert_eq!(derived, feed.address(), "{}", feed.id_hex());
        }
    }

