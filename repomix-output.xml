<file path="packages/etf-client/src/receipt.ts">
import {
  type Commitment,
  type Connection,
  type PublicKey,
  type SignatureStatus,
  type VersionedTransactionResponse,
} from "@solana/web3.js";

export type TrackedTokenAccount = { address: string; mint: string };

export type TokenAccountDelta = {
  account: string | null;
  accountIndex: number;
  mint: string;
  decimals: number;
  preAmount: string;
  postAmount: string;
  delta: string;
};

export type AccountLamportDelta = Readonly<{
  account: string;
  preLamports: string;
  postLamports: string;
  deltaLamports: string;
}>;

export type ReceiptState = "confirmed" | "rejected" | "unknown";
export type ChainOutcome = "succeeded" | "rejected" | "unresolved";

export type RpcTransactionReceipt = {
  signature: string;
  state: ReceiptState;
  chainOutcome: ChainOutcome;
  confirmationStatus: "confirmed" | "finalized" | null;
  confirmationSlot: string | null;
  networkFeeLamports: string | null;
  accountLamportDeltas: readonly AccountLamportDelta[] | null;
  tokenDeltas: TokenAccountDelta[] | null;
  tokenBalancesUnchanged: boolean | null;
  automaticResendAllowed: false;
  manualRetryAllowed: boolean;
  reason: string | null;
  limitation: "pool_state_shares_and_fee_counters_require_the_frozen_s5e_idl";
};

type RpcTokenBalance = {
  accountIndex: number;
  mint: string;
  uiTokenAmount: { amount: string; decimals: number };
};

type RpcMeta = NonNullable<VersionedTransactionResponse["meta"]> & {
  preTokenBalances?: RpcTokenBalance[] | null;
  postTokenBalances?: RpcTokenBalance[] | null;
  loadedAddresses?: { writable: PublicKey[]; readonly: PublicKey[] } | null;
};

const limitation = "pool_state_shares_and_fee_counters_require_the_frozen_s5e_idl" as const;

function unknownReceipt(
  signature: string,
  reason: string,
  chainOutcome: ChainOutcome = "unresolved",
  confirmationStatus: "confirmed" | "finalized" | null = null,
  confirmationSlot: number | null = null,
  networkFeeLamports: string | null = null,
  tokenDeltas: TokenAccountDelta[] | null = null,
  tokenBalancesUnchanged: boolean | null = null,
  accountLamportDeltas: readonly AccountLamportDelta[] | null = null,
): RpcTransactionReceipt {
  return {
    signature,
    state: "unknown",
    chainOutcome,
    confirmationStatus,
    confirmationSlot: confirmationSlot?.toString() ?? null,
    networkFeeLamports,
    accountLamportDeltas,
    tokenDeltas,
    tokenBalancesUnchanged,
    automaticResendAllowed: false,
    manualRetryAllowed: false,
    reason,
    limitation,
  };
}

function keyText(key: PublicKey | string): string {
  return typeof key === "string" ? key : key.toBase58();
}

function transactionKeys(response: VersionedTransactionResponse): string[] | null {
  const message = response.transaction.message as VersionedTransactionResponse["transaction"]["message"] & {
    accountKeys?: PublicKey[];
    staticAccountKeys?: PublicKey[];
  };
  const staticKeys = message.staticAccountKeys ?? message.accountKeys;
  if (staticKeys === undefined) return null;
  const loaded = (response.meta as RpcMeta | null)?.loadedAddresses;
  return [
    ...staticKeys.map(keyText),
    ...(loaded?.writable ?? []).map(keyText),
    ...(loaded?.readonly ?? []).map(keyText),
  ];
}

function tokenBalanceMap(
  balances: RpcTokenBalance[] | null | undefined,
): Map<number, RpcTokenBalance> | null {
  if (!Array.isArray(balances)) return null;
  const entries = new Map<number, RpcTokenBalance>();
  for (const item of balances) {
    if (
      !Number.isSafeInteger(item.accountIndex) || item.accountIndex < 0 ||
      typeof item.mint !== "string" ||
      !Number.isInteger(item.uiTokenAmount?.decimals) ||
      !/^\d+$/.test(item.uiTokenAmount?.amount ?? "")
    ) return null;
    if (entries.has(item.accountIndex)) return null;
    entries.set(item.accountIndex, item);
  }
  return entries;
}

function calculateTokenDeltas(
  response: VersionedTransactionResponse,
  tracked: readonly TrackedTokenAccount[],
  allowEmptyTracked: boolean,
): { deltas: TokenAccountDelta[]; unchanged: boolean } | null {
  const meta = response.meta as RpcMeta | null;
  if (meta === null) return null;
  const keys = transactionKeys(response);
  const pre = tokenBalanceMap(meta.preTokenBalances);
  const post = tokenBalanceMap(meta.postTokenBalances);
  if (keys === null || pre === null || post === null || (tracked.length === 0 && !allowEmptyTracked)) return null;
  if ([...pre.keys(), ...post.keys()].some((index) => index >= keys.length)) return null;

  const trackedIndices = new Map<number, string>();
  for (const tokenAccount of tracked) {
    const index = keys.indexOf(tokenAccount.address);
    if (index < 0 || trackedIndices.has(index)) return null;
    trackedIndices.set(index, tokenAccount.mint);
  }

  const indices = new Set([...pre.keys(), ...post.keys()]);
  for (const [index, expectedMint] of trackedIndices) {
    const before = pre.get(index);
    const after = post.get(index);
    if (before === undefined || after === undefined || before.mint !== expectedMint || after.mint !== expectedMint) return null;
    indices.add(index);
  }

  const deltas: TokenAccountDelta[] = [];
  for (const index of [...indices].sort((a, b) => a - b)) {
    const before = pre.get(index);
    const after = post.get(index);
    if (before !== undefined && after !== undefined && (before.mint !== after.mint || before.uiTokenAmount.decimals !== after.uiTokenAmount.decimals)) return null;
    const balance = after ?? before;
    if (balance === undefined) return null;
    if (tracked.length > 0 && (before === undefined || after === undefined)) return null;
    const preAmount = BigInt(before?.uiTokenAmount.amount ?? "0");
    const postAmount = BigInt(after?.uiTokenAmount.amount ?? "0");
    deltas.push({
      account: keys[index] ?? null,
      accountIndex: index,
      mint: balance.mint,
      decimals: balance.uiTokenAmount.decimals,
      preAmount: preAmount.toString(),
      postAmount: postAmount.toString(),
      delta: (postAmount - preAmount).toString(),
    });
  }
  return { deltas, unchanged: deltas.every((delta) => delta.delta === "0") };
}

function calculateLamportDeltas(response: VersionedTransactionResponse): AccountLamportDelta[] | null {
  const meta = response.meta as RpcMeta | null;
  if (meta === null) return null;
  const keys = transactionKeys(response);
  const pre = meta.preBalances;
  const post = meta.postBalances;
  if (keys === null || !Array.isArray(pre) || !Array.isArray(post) || pre.length !== keys.length || post.length !== keys.length) return null;
  if (keys.some((key, index) => key === undefined || keys.indexOf(key) !== index || !Number.isSafeInteger(pre[index]) || pre[index]! < 0 || !Number.isSafeInteger(post[index]) || post[index]! < 0)) return null;
  return keys.map((account, index) => ({
    account,
    preLamports: String(pre[index]),
    postLamports: String(post[index]),
    deltaLamports: String(post[index]! - pre[index]!),
  }));
}

function confirmedStatus(status: SignatureStatus): status is SignatureStatus & { confirmationStatus: "confirmed" | "finalized" } {
  return status.confirmationStatus === "confirmed" || status.confirmationStatus === "finalized";
}

/** Reconcile one previously returned signature. This function never submits or resends a transaction. */
export async function reconcileRpcTransactionReceipt(
  connection: Connection,
  signature: string,
  trackedTokenAccounts: readonly TrackedTokenAccount[],
  commitment: Extract<Commitment, "confirmed" | "finalized"> = "confirmed",
  allowEmptyTrackedTokenAccounts = false,
): Promise<RpcTransactionReceipt> {
  let status: SignatureStatus | null;
  try {
    const statuses = await connection.getSignatureStatuses([signature], { searchTransactionHistory: true });
    status = statuses.value[0] ?? null;
  } catch {
    return unknownReceipt(signature, "signature_status_rpc_unavailable");
  }
  if (status === null) return unknownReceipt(signature, "signature_status_unresolved");
  if (!confirmedStatus(status)) {
    return unknownReceipt(signature, "signature_not_confirmed", "unresolved", null, status.slot);
  }

  let response: VersionedTransactionResponse | null;
  try {
    response = await connection.getTransaction(signature, { commitment, maxSupportedTransactionVersion: 0 });
  } catch {
    return unknownReceipt(signature, "transaction_metadata_rpc_unavailable", status.err === null ? "succeeded" : "rejected", status.confirmationStatus, status.slot);
  }
  if (response === null || response.meta === null) {
    return unknownReceipt(signature, "transaction_metadata_unresolved", status.err === null ? "succeeded" : "rejected", status.confirmationStatus, status.slot);
  }
  if (response.transaction.signatures[0] !== signature || response.slot !== status.slot) {
    return unknownReceipt(signature, "signature_or_slot_mismatch", "unresolved", status.confirmationStatus, status.slot);
  }

  const meta = response.meta as RpcMeta;
  if (!Number.isSafeInteger(meta.fee) || meta.fee < 0) {
    return unknownReceipt(signature, "transaction_fee_metadata_invalid", status.err === null ? "succeeded" : "rejected", status.confirmationStatus, status.slot);
  }
  const chainOutcome: ChainOutcome = status.err === null ? "succeeded" : "rejected";
  if ((status.err === null) !== (meta.err === null)) {
    return unknownReceipt(signature, "signature_and_transaction_outcome_conflict", chainOutcome, status.confirmationStatus, status.slot, String(meta.fee));
  }

  const balanceResult = calculateTokenDeltas(response, trackedTokenAccounts, allowEmptyTrackedTokenAccounts);
  if (balanceResult === null) {
    return unknownReceipt(signature, "token_balance_metadata_incomplete", chainOutcome, status.confirmationStatus, status.slot, String(meta.fee));
  }
  if (allowEmptyTrackedTokenAccounts && !balanceResult.unchanged) {
    return unknownReceipt(signature, "no_token_action_had_token_delta", chainOutcome, status.confirmationStatus, status.slot, String(meta.fee), balanceResult.deltas, false);
  }
  if (chainOutcome === "rejected" && !balanceResult.unchanged) {
    return unknownReceipt(signature, "rejected_transaction_has_token_delta", chainOutcome, status.confirmationStatus, status.slot, String(meta.fee), balanceResult.deltas, false);
  }

  const accountLamportDeltas = calculateLamportDeltas(response);
  if (accountLamportDeltas === null) {
    return unknownReceipt(signature, "lamport_balance_metadata_incomplete", chainOutcome, status.confirmationStatus, status.slot, String(meta.fee), balanceResult.deltas, balanceResult.unchanged);
  }

  return {
    signature,
    state: chainOutcome === "succeeded" ? "confirmed" : "rejected",
    chainOutcome,
    confirmationStatus: status.confirmationStatus,
    confirmationSlot: status.slot.toString(),
    networkFeeLamports: String(meta.fee),
    accountLamportDeltas,
    tokenDeltas: balanceResult.deltas,
    tokenBalancesUnchanged: balanceResult.unchanged,
    automaticResendAllowed: false,
    manualRetryAllowed: chainOutcome === "rejected" && balanceResult.unchanged,
    reason: chainOutcome === "rejected" ? "confirmed_transaction_rejected" : null,
    limitation,
  };
}
</file>

<file path="packages/etf-client/src/shares.ts">
/** Exact-integer mirror of crates/etf-math/src/shares.rs for UI previews. */
const U64_MAX = (1n << 64n) - 1n;
const U128_MAX = (1n << 128n) - 1n;
const USD_VALUE_SCALE = 1_000_000_000_000n;
const INITIAL_SHARE_NAV_DIVISOR = USD_VALUE_SCALE / 1_000_000n;

export type ShareMathError =
  | "UnsupportedAssetCount"
  | "ZeroShareSupply"
  | "ZeroReserve"
  | "ZeroSharesOut"
  | "ZeroConsumedAmount"
  | "InvalidBurnAmount"
  | "ZeroTotalValue"
  | "ArithmeticOverflow";

export type DepositShareQuote = Readonly<{
  assetCount: 2 | 3;
  sharesOut: bigint;
  consumed: readonly [bigint, bigint, bigint];
  refund: readonly [bigint, bigint, bigint];
}>;

export type RedeemShareQuote = Readonly<{
  assetCount: 2 | 3;
  amountsOut: readonly [bigint, bigint, bigint];
}>;

function fail(error: ShareMathError): never { throw new Error(error); }
function u64(value: bigint): bigint {
  if (typeof value !== "bigint" || value < 0n || value > U64_MAX) return fail("ArithmeticOverflow");
  return value;
}
function u128(value: bigint): bigint {
  if (value < 0n || value > U128_MAX) return fail("ArithmeticOverflow");
  return value;
}
function validateAssets(left: readonly bigint[], right?: readonly bigint[]): asserts left is readonly bigint[] {
  if ((left.length !== 2 && left.length !== 3) || (right !== undefined && left.length !== right.length)) fail("UnsupportedAssetCount");
}

/** Six-decimal share output from 1e-12 USD NAV, rounded down exactly as S5B. */
export function initialSharesFromNav(navQ: bigint): bigint {
  if (navQ === 0n) return fail("ZeroTotalValue");
  u128(navQ);
  const shares = navQ / INITIAL_SHARE_NAV_DIVISOR;
  if (shares === 0n) return fail("ZeroSharesOut");
  return u64(shares);
}

/** Minimum per-asset mint capacity, ceil-consumption, refunds, and checked custody. */
export function quoteProportionalDeposit(maxInputs: readonly bigint[], reserves: readonly bigint[], shareSupply: bigint): DepositShareQuote {
  validateAssets(maxInputs, reserves);
  maxInputs.forEach(u64); reserves.forEach(u64); u64(shareSupply);
  if (shareSupply === 0n) return fail("ZeroShareSupply");
  if (reserves.some((reserve) => reserve === 0n)) return fail("ZeroReserve");
  const sharesOut = maxInputs.map((amount, index) => u128(amount * shareSupply) / reserves[index]!).reduce((smallest, shares) => shares < smallest ? shares : smallest);
  if (sharesOut === 0n) return fail("ZeroSharesOut");
  u64(sharesOut);
  u64(shareSupply + sharesOut);
  const consumed: [bigint, bigint, bigint] = [0n, 0n, 0n];
  const refund: [bigint, bigint, bigint] = [0n, 0n, 0n];
  for (let index = 0; index < maxInputs.length; index += 1) {
    const numerator = u128(sharesOut * reserves[index]!);
    const denominator = shareSupply;
    const quotient = numerator / denominator;
    const amount = u64(quotient + (numerator % denominator === 0n ? 0n : 1n));
    if (amount === 0n) return fail("ZeroConsumedAmount");
    if (amount > maxInputs[index]!) return fail("ArithmeticOverflow");
    u64(reserves[index]! + amount);
    consumed[index] = amount;
    refund[index] = maxInputs[index]! - amount;
  }
  return Object.freeze({ assetCount: maxInputs.length as 2 | 3, sharesOut, consumed: Object.freeze(consumed), refund: Object.freeze(refund) });
}

/** Pro-rata redemption rounds down; a full exit receives all remaining base units. */
export function quoteProportionalRedeem(sharesToBurn: bigint, shareSupply: bigint, reserves: readonly bigint[]): RedeemShareQuote {
  validateAssets(reserves, reserves);
  u64(sharesToBurn); u64(shareSupply); reserves.forEach(u64);
  if (shareSupply === 0n) return fail("ZeroShareSupply");
  if (sharesToBurn === 0n || sharesToBurn > shareSupply) return fail("InvalidBurnAmount");
  const amountsOut: [bigint, bigint, bigint] = [0n, 0n, 0n];
  for (let index = 0; index < reserves.length; index += 1) {
    amountsOut[index] = sharesToBurn === shareSupply
      ? reserves[index]!
      : u64(u128(sharesToBurn * reserves[index]!) / shareSupply);
  }
  return Object.freeze({ assetCount: reserves.length as 2 | 3, amountsOut: Object.freeze(amountsOut) });
}
</file>

<file path="packages/etf-client/src/validate.ts">
import type { EtfReadModelFixtureDocument } from "./dto.js";

const U64_MAX = (1n << 64n) - 1n;
const I64_MIN = -(1n << 63n);
const I64_MAX = (1n << 63n) - 1n;
const I32_MIN = -2_147_483_648;
const I32_MAX = 2_147_483_647;
const UNSIGNED = /^(?:0|[1-9][0-9]*)(?![\s\S])/;
const SIGNED = /^(?:0|-?[1-9][0-9]*)(?![\s\S])/;
const UNICODE_WHITESPACE_ONLY = /^[\u0009-\u000D\u0020\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000]*$/u;
const REASON = /^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$/;
const observationStatuses = new Set(["available", "stale", "unavailable", "invalid", "not_configured"]);
const receiptStatuses = new Set(["draft", "awaiting_signature", "submitted", "confirmed", "rejected", "unknown"]);

type UnknownRecord = Record<string, unknown>;
const isRecord = (value: unknown): value is UnknownRecord =>
  typeof value === "object" && value !== null && !Array.isArray(value);

function text(value: unknown, path: string, errors: string[]): value is string {
  if (typeof value !== "string" || UNICODE_WHITESPACE_ONLY.test(value)) {
    errors.push(`${path}: expected non-empty string`);
    return false;
  }
  return true;
}

function integerString(
  value: unknown,
  path: string,
  errors: string[],
  signed = false,
  minimum = 0n,
  maximum = U64_MAX,
): value is string {
  const pattern = signed ? SIGNED : UNSIGNED;
  if (typeof value !== "string" || !pattern.test(value)) {
    errors.push(`${path}: expected base-10 integer string`);
    return false;
  }
  const digitCount = value.length - (value.startsWith("-") ? 1 : 0);
  const maximumDigits = Math.max(
    (minimum < 0n ? -minimum : minimum).toString().length,
    maximum.toString().length,
  );
  if (digitCount > maximumDigits) {
    errors.push(`${path}: integer string is outside the supported wire range`);
    return false;
  }
  const parsed = BigInt(value);
  if (parsed < minimum || parsed > maximum) {
    errors.push(`${path}: integer string is outside the supported wire range`);
    return false;
  }
  return true;
}

function requiredText(record: UnknownRecord, fields: string[], path: string, errors: string[]): void {
  for (const field of fields) text(record[field], `${path}.${field}`, errors);
}

function validateOracle(oracle: UnknownRecord, path: string, errors: string[]): void {
  const mode = oracle.mode;
  if (mode !== "receiver_full" && mode !== "push_feed") {
    errors.push(`${path}.mode: unsupported oracle mode`);
    return;
  }
  requiredText(oracle, ["account", "owner", "feedId"], path, errors);
  integerString(oracle.rawPrice, `${path}.rawPrice`, errors, false, 1n, I64_MAX);
  integerString(oracle.confidence, `${path}.confidence`, errors);
  integerString(oracle.publishTime, `${path}.publishTime`, errors, true, I64_MIN, I64_MAX);
  integerString(oracle.ageSeconds, `${path}.ageSeconds`, errors);
  if (
    typeof oracle.exponent !== "number" || !Number.isInteger(oracle.exponent) ||
    oracle.exponent < I32_MIN || oracle.exponent > I32_MAX
  ) errors.push(`${path}.exponent: expected signed i32 JSON number`);

  if (oracle.verification !== "full") errors.push(`${path}.verification: ${mode} requires full verification`);
}

function validateSnapshot(fixture: UnknownRecord, path: string, errors: string[]): void {
  const network = fixture.network;
  if (!isRecord(network)) {
    errors.push(`${path}.network: expected object`);
    return;
  }
  requiredText(network, ["cluster", "genesisHash", "rpcLabel"], `${path}.network`, errors);
  integerString(network.contextSlot, `${path}.network.contextSlot`, errors);
  if (typeof network.commitment !== "string" || !["processed", "confirmed", "finalized"].includes(network.commitment)) {
    errors.push(`${path}.network.commitment: unsupported commitment`);
  }
  text(fixture.protocolRevision, `${path}.protocolRevision`, errors);
  if (text(fixture.configRevision, `${path}.configRevision`, errors) && !/^[0-9a-f]{64}$/.test(fixture.configRevision)) {
    errors.push(`${path}.configRevision: expected lowercase SHA-256 hex`);
  }
  integerString(fixture.poolSequence, `${path}.poolSequence`, errors);

  if (fixture.oracle !== undefined) {
    if (!isRecord(fixture.oracle)) errors.push(`${path}.oracle: expected object`);
    else validateOracle(fixture.oracle, `${path}.oracle`, errors);
  }
  if (!Array.isArray(fixture.balances)) {
    errors.push(`${path}.balances: expected array`);
  } else {
    const mints = new Set<string>();
    fixture.balances.forEach((balance, index) => {
      const balancePath = `${path}.balances[${index}]`;
      if (!isRecord(balance)) {
        errors.push(`${balancePath}: expected object`);
        return;
      }
      if (text(balance.mint, `${balancePath}.mint`, errors)) {
        if (mints.has(balance.mint)) errors.push(`${balancePath}.mint: duplicate mint in snapshot`);
        mints.add(balance.mint);
      }
      if (typeof balance.decimals !== "number" || !Number.isInteger(balance.decimals) || balance.decimals < 0 || balance.decimals > 255) {
        errors.push(`${balancePath}.decimals: expected u8 JSON number`);
      }
      integerString(balance.rawAmount, `${balancePath}.rawAmount`, errors);
      integerString(balance.contextSlot, `${balancePath}.contextSlot`, errors);
    });
  }
}

function validateObservation(fixture: UnknownRecord, path: string, errors: string[]): void {
  const status = fixture.status;
  if (typeof status !== "string" || !observationStatuses.has(status)) {
    errors.push(`${path}.status: unsupported observation state`);
    return;
  }
  if (status === "available") {
    if (fixture.kind === "observation") {
      validateSnapshot(fixture, path, errors);
      if (!["value", "oracle", "balances", "pool"].some((field) => field in fixture)) {
        errors.push(`${path}: available snapshot needs a value payload`);
      }
    } else if (fixture.kind === "oracle-observation") validateOracle(fixture, path, errors);
    else errors.push(`${path}.kind: unsupported observation kind`);
    return;
  }
  if (text(fixture.reason, `${path}.reason`, errors) && !REASON.test(fixture.reason as string)) {
    errors.push(`${path}.reason: expected stable snake_case reason code`);
  }
  if ("value" in fixture && fixture.value !== null) {
    errors.push(`${path}.value: unavailable observation cannot carry a usable or numeric placeholder`);
  }
  if (fixture.kind === "observation") {
    for (const field of ["oracle", "balances", "pool"]) {
      if (field in fixture) errors.push(`${path}.${field}: failed snapshot cannot carry available payload`);
    }
  }
}

function validateReceipt(fixture: UnknownRecord, path: string, errors: string[]): void {
  const status = fixture.status;
  if (typeof status !== "string" || !receiptStatuses.has(status)) {
    errors.push(`${path}.status: unsupported wallet-action state`);
    return;
  }
  if (status === "draft" || status === "awaiting_signature") {
    if ("confirmationSlot" in fixture) errors.push(`${path}.confirmationSlot: only confirmed receipts carry a confirmation slot`);
    if ("tokenDeltas" in fixture || "shareDelta" in fixture) errors.push(`${path}: unconfirmed receipt cannot assert RPC-derived deltas`);
    return;
  }
  if (status === "confirmed") {
    requiredText(fixture, ["signature", "messageHash", "genesisHash"], path, errors);
    integerString(fixture.confirmationSlot, `${path}.confirmationSlot`, errors);
    if (!Array.isArray(fixture.tokenDeltas) || fixture.tokenDeltas.length === 0) {
      errors.push(`${path}.tokenDeltas: confirmed receipt requires RPC-derived token deltas`);
    } else {
      fixture.tokenDeltas.forEach((delta, index) => {
        const deltaPath = `${path}.tokenDeltas[${index}]`;
        if (!isRecord(delta)) {
          errors.push(`${deltaPath}: expected object`);
          return;
        }
        text(delta.mint, `${deltaPath}.mint`, errors);
        integerString(delta.rawDelta, `${deltaPath}.rawDelta`, errors, true, -U64_MAX, U64_MAX);
      });
    }
    integerString(fixture.shareDelta, `${path}.shareDelta`, errors, true, -U64_MAX, U64_MAX);
    return;
  }
  if ("confirmationSlot" in fixture) errors.push(`${path}.confirmationSlot: only confirmed receipts carry a confirmation slot`);
  if ("tokenDeltas" in fixture || "shareDelta" in fixture) errors.push(`${path}: unconfirmed receipt cannot assert RPC-derived deltas`);
  if (status === "rejected" || status === "unknown") {
    if (text(fixture.reason, `${path}.reason`, errors) && !REASON.test(fixture.reason as string)) {
      errors.push(`${path}.reason: expected stable snake_case reason code`);
    }
  }
  if (status === "unknown" && fixture.automaticResendAllowed !== false) {
    errors.push(`${path}.automaticResendAllowed: unknown actions must not automatically resend`);
  }
}

/** Returns conformance errors without normalizing unknown states or numeric strings. */
export function validateReadModelDocument(input: unknown): string[] {
  const errors: string[] = [];
  if (!isRecord(input)) return ["$: expected object"];
  if (input.schema !== "etf-read-model-v1") errors.push("$.schema: expected etf-read-model-v1");
  if (input.fixtureOnly !== true) errors.push("$.fixtureOnly: must remain true; this validator is not production policy");
  if (!Array.isArray(input.fixtures) || input.fixtures.length === 0) return [...errors, "$.fixtures: expected non-empty array"];
  const ids = new Set<string>();
  const observationStates = new Set<string>();
  const oracleModes = new Set<string>();
  const receiptStates = new Set<string>();
  let hasAvailableSnapshot = false;
  let hasLargeWireInteger = false;
  let hasMaxU64Amount = false;
  input.fixtures.forEach((fixture, index) => {
    const path = `$.fixtures[${index}]`;
    if (!isRecord(fixture)) {
      errors.push(`${path}: expected object`);
      return;
    }
    if (!text(fixture.id, `${path}.id`, errors)) return;
    if (ids.has(fixture.id)) errors.push(`${path}.id: duplicate fixture id ${fixture.id}`);
    ids.add(fixture.id);
    if (fixture.kind === "wallet-action") {
      validateReceipt(fixture, path, errors);
      if (typeof fixture.status === "string") receiptStates.add(fixture.status);
    }
    else if (fixture.kind === "observation" || fixture.kind === "oracle-observation") {
      validateObservation(fixture, path, errors);
      if (typeof fixture.status === "string") observationStates.add(fixture.status);
      const oracle = isRecord(fixture.oracle) ? fixture.oracle : undefined;
      const mode = fixture.kind === "oracle-observation" ? fixture.mode : oracle?.mode;
      if (typeof mode === "string" && (mode === "receiver_full" || mode === "push_feed")) oracleModes.add(mode);
      if (fixture.kind === "observation" && fixture.status === "available") {
        hasAvailableSnapshot = true;
        if (isRecord(fixture.network) && typeof fixture.network.contextSlot === "string" && /^\d+$/.test(fixture.network.contextSlot)) {
          if (BigInt(fixture.network.contextSlot) > BigInt(Number.MAX_SAFE_INTEGER)) hasLargeWireInteger = true;
        }
        if (Array.isArray(fixture.balances) && fixture.balances.some((balance) =>
          isRecord(balance) && balance.rawAmount === U64_MAX.toString()
        )) hasMaxU64Amount = true;
      }
    }
    else errors.push(`${path}.kind: unsupported fixture kind`);
  });

  for (const required of ["stale", "unavailable"]) {
    if (!observationStates.has(required)) errors.push(`$.fixtures: missing ${required} observation example`);
  }
  if (!hasAvailableSnapshot) errors.push("$.fixtures: missing available snapshot with network identity");
  for (const required of ["receiver_full", "push_feed"]) {
    if (!oracleModes.has(required)) errors.push(`$.fixtures: missing ${required} oracle-mode example`);
  }
  for (const required of ["confirmed", "unknown"]) {
    if (!receiptStates.has(required)) errors.push(`$.fixtures: missing ${required} wallet-action example`);
  }
  if (!hasLargeWireInteger || !hasMaxU64Amount) {
    errors.push("$.fixtures: missing integer-precision boundaries (>2^53 slot and max-u64 token amount)");
  }
  return errors;
}

export function parseReadModelDocument(input: unknown): EtfReadModelFixtureDocument {
  const errors = validateReadModelDocument(input);
  if (errors.length > 0) throw new Error(`Invalid ETF read-model fixture:\n${errors.join("\n")}`);
  return input as EtfReadModelFixtureDocument;
}
</file>

<file path="packages/etf-client/src/wallet-submit.ts">
import {
  Connection,
  PublicKey,
  SystemProgram,
  Transaction,
  VersionedTransaction,
  type Commitment,
} from "@solana/web3.js";
import { ETF_DEVNET_GENESIS_HASH } from "./devnet-read.js";
import {
  reconcileRpcTransactionReceipt,
  type ReceiptState,
  type RpcTransactionReceipt,
  type TrackedTokenAccount,
} from "./receipt.js";
import { assertVerifiedEtfManifest, ETF_SHARE_DECIMALS, type VerifiedEtfManifest } from "./manifest.js";
import { ETF_DEVNET_TOKEN_PROGRAM } from "./devnet-read.js";

export type WalletSignableTransaction = Transaction | VersionedTransaction;

export type WalletTransactionSigner = {
  publicKey: PublicKey | null;
  signTransaction(transaction: WalletSignableTransaction): Promise<WalletSignableTransaction>;
};

export type WalletNoTokenBalanceAction = "initialize" | "prepare_accounts" | "pause" | "poke" | "resume_propose" | "resume_execute" | "resume_cancel";

export type WalletAtaPreparationTarget = Readonly<{
  owner: string;
  mint: string;
  associatedAccount: string;
  decimals: number;
}>;

const CLASSIC_TOKEN_PROGRAM_ID = new PublicKey(ETF_DEVNET_TOKEN_PROGRAM);
const ASSOCIATED_TOKEN_PROGRAM_ID = new PublicKey("ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL");
const VERIFIED_ATA_PLANS = new WeakSet<object>();

/** Derives the only ATA preparation targets accepted by the wallet-submit path. */
export function deriveWalletAtaPreparationPlan(
  context: VerifiedEtfManifest,
  owner: PublicKey,
  mints: readonly PublicKey[],
): readonly WalletAtaPreparationTarget[] {
  assertVerifiedEtfManifest(context);
  if (!Array.isArray(mints) || mints.length === 0 || mints.length > context.config.assets.length + 1) {
    fail("wallet_submit_no_token_action_invalid");
  }
  const admitted = new Map<string, number>([
    ...context.config.assets.map((asset) => [asset.mint.toBase58(), asset.decimals] as const),
    [context.addresses.shareMint.toBase58(), ETF_SHARE_DECIMALS],
  ]);
  const seen = new Set<string>();
  const plan = mints.map((mint) => {
    const mintText = mint.toBase58();
    const decimals = admitted.get(mintText);
    if (decimals === undefined || seen.has(mintText) || !context.config.assets.every((asset) => asset.tokenProgram.equals(CLASSIC_TOKEN_PROGRAM_ID))) {
      fail("wallet_submit_no_token_action_invalid");
    }
    seen.add(mintText);
    const [associated] = PublicKey.findProgramAddressSync(
      [owner.toBuffer(), CLASSIC_TOKEN_PROGRAM_ID.toBuffer(), mint.toBuffer()],
      ASSOCIATED_TOKEN_PROGRAM_ID,
    );
    return Object.freeze({ owner: owner.toBase58(), mint: mintText, associatedAccount: associated.toBase58(), decimals });
  });
  Object.freeze(plan);
  VERIFIED_ATA_PLANS.add(plan);
  return plan;
}

export type WalletAttemptRecord = {
  signature: string;
  state: ReceiptState;
  trackedTokenAccounts: TrackedTokenAccount[];
  receipt: RpcTransactionReceipt | null;
  noTokenBalanceAction?: WalletNoTokenBalanceAction;
  requirePostStateReadback?: boolean;
  postStateVerified?: boolean;
};

export type WalletOperationRecord = {
  operationId: string;
  attempts: WalletAttemptRecord[];
};

/** Implement with durable storage and atomic compare-and-swap semantics. */
export interface WalletSubmissionJournal {
  read(operationId: string): Promise<WalletOperationRecord | null>;
  appendIfLatest(
    operationId: string,
    expectedLatestSignature: string | null,
    attempt: WalletAttemptRecord,
  ): Promise<boolean>;
  replaceLatest(
    operationId: string,
    expectedSignature: string,
    attempt: WalletAttemptRecord,
  ): Promise<boolean>;
}

export type WalletSubmissionErrorCode =
  | "wallet_submit_invalid_operation_id"
  | "wallet_submit_genesis_rpc_unavailable"
  | "wallet_submit_wrong_genesis"
  | "wallet_submit_wallet_unavailable"
  | "wallet_submit_fee_payer_mismatch"
  | "wallet_submit_transaction_invalid"
  | "wallet_submit_tracked_accounts_invalid"
  | "wallet_submit_journal_unavailable"
  | "wallet_submit_operation_already_attempted"
  | "wallet_submit_retry_not_authorized"
  | "wallet_submit_signing_failed"
  | "wallet_submit_signed_message_changed"
  | "wallet_submit_signature_missing"
  | "wallet_submit_signature_reused"
  | "wallet_submit_journal_write_failed"
  | "wallet_submit_no_token_action_invalid"
  | "wallet_submit_post_state_verifier_required";

export class WalletSubmissionError extends Error {
  constructor(readonly code: WalletSubmissionErrorCode) {
    super(code);
    this.name = "WalletSubmissionError";
  }
}

export type WalletSubmissionResult = {
  operationId: string;
  signature: string;
  state: ReceiptState;
  receipt: RpcTransactionReceipt | null;
  retryAllowed: boolean;
  automaticResendAllowed: false;
  reason: WalletSubmissionErrorCode | "submission_outcome_unresolved" | "post_state_unresolved" | null;
  postStateVerified: boolean | null;
};

function fail(code: WalletSubmissionErrorCode): never {
  throw new WalletSubmissionError(code);
}

function transactionMessage(transaction: WalletSignableTransaction): Uint8Array {
  return transaction instanceof VersionedTransaction
    ? transaction.message.serialize()
    : transaction.serializeMessage();
}

function feePayer(transaction: WalletSignableTransaction): PublicKey | null {
  return transaction instanceof VersionedTransaction
    ? transaction.message.staticAccountKeys[0] ?? null
    : transaction.feePayer ?? null;
}

function sameBytes(left: Uint8Array, right: Uint8Array): boolean {
  return left.length === right.length && left.every((byte, index) => byte === right[index]);
}

const BASE58_ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";

function encodeBase58(bytes: Uint8Array): string {
  let value = 0n;
  for (const byte of bytes) value = (value << 8n) | BigInt(byte);
  let encoded = "";
  while (value > 0n) {
    const remainder = Number(value % 58n);
    encoded = BASE58_ALPHABET[remainder]! + encoded;
    value /= 58n;
  }
  for (const byte of bytes) {
    if (byte !== 0) break;
    encoded = `1${encoded}`;
  }
  return encoded;
}

function signedBytesAndSignature(transaction: WalletSignableTransaction): { bytes: Uint8Array; signature: string } {
  if (transaction instanceof VersionedTransaction) {
    const signature = transaction.signatures[0];
    if (signature === undefined || signature.length !== 64 || signature.every((byte) => byte === 0)) {
      fail("wallet_submit_signature_missing");
    }
    if (transaction.signatures.some((item) => item.length !== 64 || item.every((byte) => byte === 0))) {
      fail("wallet_submit_signature_missing");
    }
    return { bytes: transaction.serialize(), signature: encodeBase58(signature) };
  }

  try {
    const bytes = transaction.serialize();
    const signature = transaction.signatures.find((item) => item.publicKey.equals(transaction.feePayer!))?.signature;
    if (signature === null || signature === undefined || signature.length !== 64 || signature.every((byte) => byte === 0)) {
      fail("wallet_submit_signature_missing");
    }
    return { bytes, signature: encodeBase58(signature) };
  } catch (error) {
    if (error instanceof WalletSubmissionError) throw error;
    fail("wallet_submit_signature_missing");
  }
}

function retryIsAllowed(attempt: WalletAttemptRecord | undefined): boolean {
  return attempt?.state === "rejected" &&
    attempt.receipt?.state === "rejected" &&
    attempt.receipt.chainOutcome === "rejected" &&
    attempt.receipt.tokenBalancesUnchanged === true &&
    attempt.receipt.manualRetryAllowed === true &&
    (attempt.requirePostStateReadback !== true || attempt.postStateVerified === true);
}

function resultFromAttempt(operationId: string, attempt: WalletAttemptRecord): WalletSubmissionResult {
  return {
    operationId,
    signature: attempt.signature,
    state: attempt.state,
    receipt: attempt.receipt,
    retryAllowed: retryIsAllowed(attempt),
    automaticResendAllowed: false,
    reason: attempt.state === "unknown"
      ? attempt.receipt !== null && attempt.postStateVerified === false ? "post_state_unresolved" : "submission_outcome_unresolved"
      : null,
    postStateVerified: attempt.requirePostStateReadback === true ? attempt.postStateVerified === true : null,
  };
}

function unresolvedResult(operationId: string, signature: string): WalletSubmissionResult {
  return {
    operationId,
    signature,
    state: "unknown",
    receipt: null,
    retryAllowed: false,
    automaticResendAllowed: false,
    reason: "submission_outcome_unresolved",
    postStateVerified: null,
  };
}

async function reconcileAndPersist(
  connection: Connection,
  journal: WalletSubmissionJournal,
  operation: WalletOperationRecord,
  commitment: Extract<Commitment, "confirmed" | "finalized">,
  postStateVerifier?: (result: WalletSubmissionResult) => Promise<boolean>,
): Promise<WalletSubmissionResult> {
  const current = operation.attempts.at(-1);
  if (current === undefined) fail("wallet_submit_journal_unavailable");

  let receipt: RpcTransactionReceipt;
  try {
    receipt = await reconcileRpcTransactionReceipt(
      connection,
      current.signature,
      current.trackedTokenAccounts,
      commitment,
      current.noTokenBalanceAction !== undefined,
    );
  } catch {
    return unresolvedResult(operation.operationId, current.signature);
  }
  if (receipt.state === "unknown") {
    const updated: WalletAttemptRecord = {
      ...current,
      state: "unknown",
      receipt,
      ...(current.requirePostStateReadback === true ? { postStateVerified: false } : {}),
    };
    let persisted = false;
    try {
      persisted = await journal.replaceLatest(operation.operationId, current.signature, updated);
    } catch {
      persisted = false;
    }
    return persisted ? resultFromAttempt(operation.operationId, updated) : unresolvedResult(operation.operationId, current.signature);
  }

  let postStateVerified = current.requirePostStateReadback !== true;
  if (current.requirePostStateReadback === true && postStateVerifier !== undefined) {
    const candidate: WalletAttemptRecord = { ...current, state: receipt.state, receipt, postStateVerified: false };
    try {
      postStateVerified = await postStateVerifier(resultFromAttempt(operation.operationId, candidate));
    } catch {
      postStateVerified = false;
    }
  }
  const verifiedState = current.requirePostStateReadback === true && !postStateVerified ? "unknown" : receipt.state;
  const updated: WalletAttemptRecord = { ...current, state: verifiedState, receipt, ...(current.requirePostStateReadback === true ? { postStateVerified } : {}) };
  let persisted = false;
  try {
    persisted = await journal.replaceLatest(operation.operationId, current.signature, updated);
  } catch {
    persisted = false;
  }
  if (!persisted) {
    return {
      operationId: operation.operationId,
      signature: current.signature,
      state: "unknown",
      receipt: null,
      retryAllowed: false,
      automaticResendAllowed: false,
      reason: "wallet_submit_journal_write_failed",
      postStateVerified: current.requirePostStateReadback === true ? false : null,
    };
  }
  return resultFromAttempt(operation.operationId, updated);
}

const NO_TOKEN_BALANCE_DISCRIMINATORS: Readonly<Record<Exclude<WalletNoTokenBalanceAction, "prepare_accounts">, readonly number[]>> = {
  initialize: [95, 180, 10, 172, 84, 174, 232, 40],
  pause: [221, 2, 34, 100, 217, 178, 42, 15],
  poke: [46, 24, 16, 107, 212, 9, 17, 5],
  resume_propose: [101, 206, 195, 58, 159, 84, 16, 59],
  resume_execute: [62, 120, 18, 234, 169, 77, 91, 35],
  resume_cancel: [214, 159, 34, 123, 49, 111, 127, 76],
};

function isNoTokenBalanceInstruction(transaction: WalletSignableTransaction, action: Exclude<WalletNoTokenBalanceAction, "prepare_accounts">, programId: PublicKey): boolean {
  if (!(transaction instanceof Transaction) || transaction.instructions.length !== 1) return false;
  const [instruction] = transaction.instructions;
  if (!instruction || !instruction.programId.equals(programId)) return false;
  const expected = NO_TOKEN_BALANCE_DISCRIMINATORS[action];
  return instruction.data.length >= expected.length && expected.every((byte, index) => instruction.data[index] === byte);
}

function isIdempotentAtaPreparation(
  transaction: WalletSignableTransaction,
  payer: PublicKey,
  programId: PublicKey,
  plan: readonly WalletAtaPreparationTarget[],
): boolean {
  if (!VERIFIED_ATA_PLANS.has(plan as object) || !(transaction instanceof Transaction) || plan.length === 0 || transaction.instructions.length !== plan.length || !programId.equals(ASSOCIATED_TOKEN_PROGRAM_ID)) return false;
  const seen = new Set<string>();
  for (let index = 0; index < plan.length; index += 1) {
    const target = plan[index]!;
    const instruction = transaction.instructions[index]!;
    let owner: PublicKey;
    let mint: PublicKey;
    let associated: PublicKey;
    try {
      owner = new PublicKey(target.owner);
      mint = new PublicKey(target.mint);
      associated = new PublicKey(target.associatedAccount);
    } catch {
      return false;
    }
    const [derived] = PublicKey.findProgramAddressSync(
      [owner.toBuffer(), CLASSIC_TOKEN_PROGRAM_ID.toBuffer(), mint.toBuffer()],
      ASSOCIATED_TOKEN_PROGRAM_ID,
    );
    if (!owner.equals(payer) || !associated.equals(derived) || seen.has(associated.toBase58()) ||
        !Number.isInteger(target.decimals) || target.decimals < 0 || target.decimals > 9 ||
        !instruction.programId.equals(ASSOCIATED_TOKEN_PROGRAM_ID) ||
        instruction.data.length !== 1 || instruction.data[0] !== 1 || instruction.keys.length !== 6) return false;
    const expected = [
      { pubkey: payer, isSigner: true, isWritable: true },
      { pubkey: derived, isSigner: false, isWritable: true },
      { pubkey: owner, isSigner: false, isWritable: false },
      { pubkey: mint, isSigner: false, isWritable: false },
      { pubkey: SystemProgram.programId, isSigner: false, isWritable: false },
      { pubkey: CLASSIC_TOKEN_PROGRAM_ID, isSigner: false, isWritable: false },
    ];
    if (instruction.keys.some((meta, metaIndex) => {
      const expectedMeta = expected[metaIndex]!;
      return !meta.pubkey.equals(expectedMeta.pubkey) || meta.isSigner !== expectedMeta.isSigner || meta.isWritable !== expectedMeta.isWritable;
    })) return false;
    seen.add(associated.toBase58());
  }
  return true;
}

/** Sign and send once. A durable journal entry is written before the only RPC submission. */
export async function submitWalletTransaction(options: {
  connection: Connection;
  signer: WalletTransactionSigner;
  transaction: WalletSignableTransaction;
  journal: WalletSubmissionJournal;
  operationId: string;
  trackedTokenAccounts: readonly TrackedTokenAccount[];
  retryOfSignature?: string;
  commitment?: Extract<Commitment, "confirmed" | "finalized">;
  noTokenBalanceAction?: WalletNoTokenBalanceAction;
  noTokenProgramId?: PublicKey;
  ataPreparationPlan?: readonly WalletAtaPreparationTarget[];
  requirePostStateReadback?: boolean;
  postStateVerifier?: (result: WalletSubmissionResult) => Promise<boolean>;
}): Promise<WalletSubmissionResult> {
  const { connection, signer, transaction, journal, operationId } = options;
  if (operationId.trim() === "") fail("wallet_submit_invalid_operation_id");
  if (options.trackedTokenAccounts.length === 0) {
    if (options.noTokenBalanceAction === undefined || options.noTokenProgramId === undefined) fail("wallet_submit_tracked_accounts_invalid");
    if (options.noTokenBalanceAction === "prepare_accounts") {
      if (options.ataPreparationPlan === undefined || signer.publicKey === null || !isIdempotentAtaPreparation(transaction, signer.publicKey, options.noTokenProgramId, options.ataPreparationPlan)) fail("wallet_submit_no_token_action_invalid");
    } else if (options.ataPreparationPlan !== undefined || !isNoTokenBalanceInstruction(transaction, options.noTokenBalanceAction, options.noTokenProgramId)) {
      fail("wallet_submit_no_token_action_invalid");
    }
  } else if (options.noTokenBalanceAction !== undefined || options.noTokenProgramId !== undefined || options.ataPreparationPlan !== undefined) {
    fail("wallet_submit_no_token_action_invalid");
  }
  if (options.requirePostStateReadback === true && options.postStateVerifier === undefined) fail("wallet_submit_post_state_verifier_required");
  if (options.noTokenBalanceAction !== undefined && options.requirePostStateReadback !== true) fail("wallet_submit_post_state_verifier_required");
  const trackedAddresses = new Set<string>();
  try {
    for (const account of options.trackedTokenAccounts) {
      new PublicKey(account.address);
      new PublicKey(account.mint);
      if (trackedAddresses.has(account.address)) fail("wallet_submit_tracked_accounts_invalid");
      trackedAddresses.add(account.address);
    }
  } catch (error) {
    if (error instanceof WalletSubmissionError) throw error;
    fail("wallet_submit_tracked_accounts_invalid");
  }

  let genesis: string;
  try {
    genesis = await connection.getGenesisHash();
  } catch {
    fail("wallet_submit_genesis_rpc_unavailable");
  }
  if (genesis !== ETF_DEVNET_GENESIS_HASH) fail("wallet_submit_wrong_genesis");

  const payer = feePayer(transaction);
  if (signer.publicKey === null) fail("wallet_submit_wallet_unavailable");
  if (payer === null || !payer.equals(signer.publicKey)) fail("wallet_submit_fee_payer_mismatch");

  let unsignedMessage: Uint8Array;
  try {
    unsignedMessage = transactionMessage(transaction);
  } catch {
    fail("wallet_submit_transaction_invalid");
  }

  let existing: WalletOperationRecord | null;
  try {
    existing = await journal.read(operationId);
  } catch {
    fail("wallet_submit_journal_unavailable");
  }

  let prior = existing?.attempts.at(-1);
  if (options.retryOfSignature === undefined) {
    if (prior !== undefined) fail("wallet_submit_operation_already_attempted");
  } else {
    if (prior === undefined || prior.signature !== options.retryOfSignature) {
      fail("wallet_submit_retry_not_authorized");
    }
    let verifiedReceipt: RpcTransactionReceipt;
    try {
      verifiedReceipt = await reconcileRpcTransactionReceipt(
        connection,
        prior.signature,
        prior.trackedTokenAccounts,
        options.commitment ?? "confirmed",
        prior.noTokenBalanceAction !== undefined,
      );
    } catch {
      fail("wallet_submit_retry_not_authorized");
    }
    let postStateVerified = prior.requirePostStateReadback !== true;
    const retryCandidate: WalletAttemptRecord = {
      ...prior,
      state: verifiedReceipt.state,
      receipt: verifiedReceipt,
      ...(prior.requirePostStateReadback === true ? { postStateVerified: false } : {}),
    };
    if (verifiedReceipt.state !== "unknown" && prior.requirePostStateReadback === true && options.postStateVerifier !== undefined) {
      try {
        postStateVerified = await options.postStateVerifier(resultFromAttempt(operationId, retryCandidate));
      } catch {
        postStateVerified = false;
      }
    }
    const verifiedPrior: WalletAttemptRecord = {
      ...retryCandidate,
      ...(prior.requirePostStateReadback === true ? { postStateVerified } : {}),
      state: prior.requirePostStateReadback === true && !postStateVerified ? "unknown" : verifiedReceipt.state,
    };
    if (!retryIsAllowed(verifiedPrior)) fail("wallet_submit_retry_not_authorized");
    let persisted = false;
    try {
      persisted = await journal.replaceLatest(operationId, prior.signature, verifiedPrior);
    } catch {
      persisted = false;
    }
    if (!persisted) fail("wallet_submit_journal_write_failed");
    prior = verifiedPrior;
    existing = {
      operationId,
      attempts: [...(existing?.attempts.slice(0, -1) ?? []), verifiedPrior],
    };
  }

  let signed: WalletSignableTransaction;
  try {
    signed = await signer.signTransaction(transaction);
  } catch {
    fail("wallet_submit_signing_failed");
  }
  let signedMessage: Uint8Array;
  try {
    signedMessage = transactionMessage(signed);
  } catch {
    fail("wallet_submit_signed_message_changed");
  }
  if (!feePayer(signed)?.equals(payer) || !sameBytes(signedMessage, unsignedMessage)) {
    fail("wallet_submit_signed_message_changed");
  }
  const signedTransaction = signedBytesAndSignature(signed);
  if (existing?.attempts.some((attempt) => attempt.signature === signedTransaction.signature)) {
    fail("wallet_submit_signature_reused");
  }

  const attempt: WalletAttemptRecord = {
    signature: signedTransaction.signature,
    state: "unknown",
    trackedTokenAccounts: options.trackedTokenAccounts.map((account) => ({ ...account })),
    receipt: null,
    ...(options.noTokenBalanceAction === undefined ? {} : { noTokenBalanceAction: options.noTokenBalanceAction }),
    ...(options.requirePostStateReadback === true ? { requirePostStateReadback: true, postStateVerified: false } : {}),
  };
  let appended = false;
  try {
    appended = await journal.appendIfLatest(operationId, prior?.signature ?? null, attempt);
  } catch {
    fail("wallet_submit_journal_write_failed");
  }
  if (!appended) fail("wallet_submit_operation_already_attempted");

  try {
    await connection.sendRawTransaction(signedTransaction.bytes, {
      maxRetries: 0,
      skipPreflight: false,
    });
  } catch {
    // A timeout does not prove the transaction was not accepted.
  }

  const committedOperation = await journal.read(operationId).catch(() => null);
  if (committedOperation === null) {
    return { ...unresolvedResult(operationId, signedTransaction.signature), reason: "wallet_submit_journal_unavailable" };
  }
  return reconcileAndPersist(connection, journal, committedOperation, options.commitment ?? "confirmed", options.postStateVerifier);
}

/** Reconcile only the signature already stored for this operation; this function never submits. */
export async function reconcileWalletSubmission(options: {
  connection: Connection;
  journal: WalletSubmissionJournal;
  operationId: string;
  commitment?: Extract<Commitment, "confirmed" | "finalized">;
  postStateVerifier?: (result: WalletSubmissionResult) => Promise<boolean>;
}): Promise<WalletSubmissionResult> {
  let operation: WalletOperationRecord | null;
  try {
    operation = await options.journal.read(options.operationId);
  } catch {
    fail("wallet_submit_journal_unavailable");
  }
  if (operation === null || operation.attempts.at(-1) === undefined) fail("wallet_submit_operation_already_attempted");
  return reconcileAndPersist(options.connection, options.journal, operation, options.commitment ?? "confirmed", options.postStateVerifier);
}
