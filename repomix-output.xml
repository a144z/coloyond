  font-weight: 700;
  margin-top: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.atomic-full {
  color: var(--green);
}

.atomic-partial {
  color: var(--yellow);
}

.atomic-intent {
  color: var(--orange);
}

.btn-select {
  width: 100%;
  padding: 12px;
  background: transparent;
  color: var(--text);
  border: 1px solid rgba(255, 255, 255, 0.14);
}

.btn-select:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: var(--accent2);
}

.status-pill {
  font-size: 13px;
  background: var(--panel-2);
  border: 1px solid var(--border);
  padding: 6px 12px;
  border-radius: 999px;
  font-weight: 700;
  white-space: nowrap;
}

.exec-subhead {
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 800;
  margin: 4px 0 10px;
}

.exec-subhead:not(:first-child) {
  margin-top: 18px;
}

.steps {
  display: flex;
  flex-direction: column;
}

.step {
  display: flex;
  gap: 14px;
}

.step-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-icon {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  background: var(--panel-2);
  border: 1px solid var(--border);
  flex-shrink: 0;
}

.step.done .step-icon {
  background: rgba(46, 204, 113, 0.18);
  border-color: rgba(46, 204, 113, 0.45);
}

.step.active .step-icon {
  background: rgba(59, 130, 246, 0.18);
  border-color: rgba(59, 130, 246, 0.5);
}

.step-line {
  width: 2px;
  flex: 1;
  background: var(--border);
  margin: 4px 0;
  min-height: 18px;
}

.step.done .step-line {
  background: rgba(46, 204, 113, 0.45);
}

.step-body {
  flex: 1;
  padding-bottom: 16px;
  min-width: 0;
}

.step-name {
  font-weight: 700;
  font-size: 14.5px;
  line-height: 1.4;
}

.step-sub {
  color: var(--muted);
  font-size: 13px;
  margin-top: 3px;
  line-height: 1.5;
}

.step-tx {
  font-family: Consolas, "JetBrains Mono", monospace;
  font-size: 12px;
  color: var(--muted);
  margin-top: 4px;
}

.step-eta {
  color: var(--yellow);
  font-size: 12.5px;
  margin-top: 4px;
  font-weight: 600;
}

.lock {
  background: rgba(46, 204, 113, 0.08);
  border: 1px solid rgba(46, 204, 113, 0.35);
  border-radius: 14px;
  padding: 12px 14px;
  font-size: 13.5px;
  line-height: 1.6;
  margin-top: 6px;
}

.lock b {
  color: var(--green);
}

.lock-done {
  background: rgba(46, 204, 113, 0.14);
}

.exec-actions {
  display: flex;
  gap: 10px;
  margin-top: 16px;
}

.exec-actions .btn {
  flex: 1;
  padding: 13px;
  text-align: center;
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-danger {
  background: rgba(255, 60, 80, 0.12);
  color: #ff6b81;
  border: 1px solid rgba(255, 60, 80, 0.3);
}

.btn-danger:hover:not(:disabled) {
  background: rgba(255, 60, 80, 0.2);
}

.btn-danger:disabled {
  opacity: 0.4;
  cursor: default;
}

.btn-link2 {
  background: var(--panel-2);
  border: 1px solid var(--border);
  color: var(--text);
}

.btn-link2:hover {
  border-color: var(--accent2);
}

.spin {
  display: inline-block;
  width: 15px;
  height: 15px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  vertical-align: -3px;
  margin-right: 6px;
}

.card .spin {
  border-color: rgba(255, 255, 255, 0.2);
  border-top-color: var(--accent2);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.footer-note {
  text-align: center;
  color: var(--muted);
  font-size: 12.5px;
  margin-top: 26px;
}

@media (max-width: 520px) {
  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .amount {
    font-size: 28px;
  }

  .diagram-cell {
    min-width: 100%;
  }

  .diagram-arrow {
    transform: rotate(90deg);
  }
}

.routing-card {
  background: #0b0e14;
  border: 1px solid #1e2638;
  border-radius: 20px;
  padding: 18px;
  margin-bottom: 14px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.routing-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.routing-title {
  font-size: 15px;
  font-weight: 800;
  color: #f0f0f5;
}

.routing-meta {
  font-size: 11.5px;
  color: #8e8ea3;
  font-weight: 600;
}

.routing-scroll {
  overflow-x: auto;
  padding-bottom: 4px;
}

.routing-flow {
  display: flex;
  align-items: stretch;
  min-width: 1060px;
}

.endpoint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 10px;
}

.token-orb {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 11px;
  letter-spacing: 0.02em;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.18);
}

.orb-eth {
  background: #627eea;
}

.token-orb.glow {
  box-shadow:
    0 0 18px rgba(98, 126, 234, 0.75),
    0 0 44px rgba(98, 126, 234, 0.35);
}

.orb-wbtc {
  background: #f7931a;
  box-shadow:
    0 0 18px rgba(247, 147, 26, 0.6),
    0 0 44px rgba(247, 147, 26, 0.25);
}

.connector {
  position: relative;
  width: 72px;
  flex-shrink: 0;
}

.connector-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.connector-svg path {
  fill: none;
  stroke: #2a3550;
  stroke-width: 1.5;
}

.connector-svg .conn-dot {
  fill: #3b82f6;
}

.split-pill {
  position: absolute;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 10.5px;
  font-weight: 800;
  color: #cfd6e4;
  background: #121722;
  border: 1px solid #1e2638;
  border-radius: 999px;
  padding: 2px 8px;
  white-space: nowrap;
}

.routes-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 0 2px;
}

.route-row {
  min-height: 104px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
}

.route-row-label {
  font-size: 10.5px;
  color: #8e8ea3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 720px;
}

.hop-chain {
  margin-left: auto;
  font-size: 9.5px;
  color: #7c87a0;
  font-weight: 600;
  white-space: nowrap;
}

.hop-eta {
  margin-top: 6px;
  font-size: 10px;
  color: #7c87a0;
  font-weight: 600;
}

.error-text {
  color: #ff6b6b;
  padding: 6px 0 12px;
  word-break: break-word;
}

.hop-strip {
  display: flex;
  align-items: center;
  gap: 8px;
}

.hop-node {
  flex-shrink: 0;
  width: 168px;
  background: #10141f;
  border: 1px solid #1e2638;
  border-radius: 12px;
  padding: 9px 11px;
}

.hop-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 7px;
}

.hop-icon {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 800;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.22);
  flex-shrink: 0;
}

.hop-ticker {
  font-weight: 800;
  font-size: 12.5px;
  color: #fff;
}

.node-protos {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.proto-row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 10.5px;
  color: #9aa6bd;
}

.proto-row.solo {
  justify-content: flex-end;
}

.proto-pct {
  color: #7c87a0;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.hop-arrow {
  color: #4a5468;
  font-weight: 800;
  font-size: 12px;
  flex-shrink: 0;
}

/* ---- logos ---- */
.logo-img {
  border-radius: 50%;
  object-fit: cover;
  background: #17171f;
  flex-shrink: 0;
}

.logo-letter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent1), var(--accent2));
  color: #fff;
  font-weight: 800;
  text-transform: uppercase;
  flex-shrink: 0;
}

.node-proto {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  font-size: 12.5px;
  color: var(--text);
}

.node-route {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11.5px;
  color: var(--muted);
  margin-top: 4px;
}

/* ---- swap card v2 ---- */
.pick-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.chain-select-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 4px 10px;
}

.chain-select {
  width: auto;
  font-size: 12.5px;
  color: var(--muted);
  font-weight: 600;
  margin-bottom: 0;
}

.token-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 8px 12px;
  cursor: pointer;
  color: var(--text);
  font-family: inherit;
  font-weight: 800;
  font-size: 15px;
  transition: border-color 0.15s;
}

.token-btn:hover {
  border-color: var(--accent2);
}

.token-sym {
  font-size: 17px;
}

.caret {
  color: var(--muted);
  font-size: 11px;
}

.amount-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 6px;
}

.amount {
  margin-top: 0;
}

.receive-amount {
  color: #c8c8d6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.receive-token {
  font-size: 13px;
  color: var(--muted);
  font-weight: 600;
  flex-shrink: 0;
}

.btn-mini {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--muted);
  border-radius: 10px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
}

.btn-mini:hover {
  border-color: var(--accent2);
  color: var(--text);
}

.btn-mini.active {
  border-color: var(--accent2);
  color: var(--text);
  background: rgba(153, 69, 255, 0.14);
}

.bal {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.settings-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin: 14px 4px;
  color: var(--muted);
  font-size: 13px;
}

.setting {
  display: flex;
  align-items: center;
  gap: 8px;
}

.gear {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--muted);
  cursor: pointer;
  width: 28px;
  height: 28px;
  font-size: 14px;
  line-height: 1;
  transition: transform 0.4s;
}

.gear:hover {
  transform: rotate(90deg);
}

.popover {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 14px 16px;
  margin: 4px 0 14px;
}

.popover-title {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text);
  margin-bottom: 10px;
}

.pop-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 10px 0 6px;
}

.slippage-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.slippage-input {
  width: 74px;
  font-size: 15px;
  margin-top: 0;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 10px;
}

.pop-note {
  font-size: 12px;
  color: var(--muted);
  margin-top: 10px;
}

.from-note {
  text-align: center;
  font-size: 11.5px;
  color: #5a5a6e;
  margin-top: 10px;
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(8, 8, 12, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  padding: 20px;
}

.token-pop {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 16px;
  width: 100%;
  max-width: 380px;
  max-height: 70vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
}

.token-row {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 12px;
  padding: 10px 12px;
  cursor: pointer;
  color: var(--text);
  font-family: inherit;
  font-size: 14.5px;
  font-weight: 700;
  margin-top: 4px;
}

.token-row:hover {
  background: var(--panel-2);
}

.token-row.active {
  background: var(--panel-2);
  border-color: var(--border);
}

.token-row-sym {
  flex: 1;
  text-align: left;
}

.token-row-bal {
  color: var(--muted);
  font-weight: 600;
  font-size: 12.5px;
}

.token-check {
  color: var(--green);
  font-weight: 800;
}

/* ---- execution steps with logo ---- */
.step-name {
  display: flex;
  align-items: center;
  gap: 7px;
}

.cb-app {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 860px;
  margin: 0 auto;
}

.cb-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 16px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

.cb-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.cb-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 14px;
  font-size: 20px;
  background: linear-gradient(135deg, var(--accent1), var(--accent2));
  color: #fff;
  flex-shrink: 0;
}

.cb-title {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 0.2px;
}

.cb-subtitle {
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.35;
  margin-top: 2px;
}

.cb-wallet {
  text-align: right;
  flex-shrink: 0;
}

.cb-header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.cb-reference-link {
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  padding: 8px 10px;
  text-decoration: none;
  white-space: nowrap;
}

.cb-reference-link:hover,
.cb-reference-link:focus-visible {
  border-color: var(--accent2);
  color: var(--text);
}

.cb-wallet-label {
  color: var(--muted);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cb-wallet-usd {
  font-size: 18px;
  font-weight: 800;
  margin-top: 2px;
}

.cb-hero {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  padding: 18px;
  background:
    radial-gradient(700px 300px at 15% 10%, rgba(255, 0, 122, 0.12), transparent 55%),
    radial-gradient(700px 300px at 85% 5%, rgba(153, 69, 255, 0.14), transparent 55%),
    var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
}

.cb-hero-copy h1 {
  font-size: 28px;
  line-height: 1.1;
}

.cb-hero-copy p {
  color: var(--muted);
  margin-top: 8px;
  font-size: 13.5px;
  line-height: 1.5;
}

.cb-status {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  color: var(--muted);
  font-size: 12.5px;
  font-weight: 700;
}

.cb-status-active {
  color: var(--green);
  background: rgba(46, 204, 113, 0.12);
  border: 1px solid rgba(46, 204, 113, 0.32);
  border-radius: 999px;
  padding: 6px 10px;
}

.cb-health {
  grid-column: 1 / -1;
  display: grid;
  gap: 8px;
}

.cb-health-track {
  height: 10px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border);
  border-radius: 999px;
  overflow: hidden;
}

.cb-health-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent1), var(--accent2));
}

.cb-health-label {
  color: var(--muted);
  font-size: 12.5px;
  font-weight: 800;
}

.cb-stats {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.cb-stat {
  display: grid;
  gap: 5px;
  padding: 11px;
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 14px;
  min-width: 0;
}

.cb-stat span {
  color: var(--muted);
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cb-stat b {
  font-size: 14px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cb-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 4px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
}

.cb-tab {
  flex-shrink: 0;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 13px;
  color: var(--muted);
  cursor: pointer;
  font-family: inherit;
  font-size: 13px;
  font-weight: 800;
  padding: 10px 16px;
  min-height: 44px;
}

.cb-tab.active {
  background: linear-gradient(90deg, var(--accent1), var(--accent2));
  color: #fff;
}

.cb-main {
  min-height: 420px;
}

.cb-panel {
  display: grid;
  gap: 18px;
  padding: 18px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
}

.cb-section-head h2 {
  font-size: 21px;
  line-height: 1.15;
}

.cb-section-head p {
  color: var(--muted);
  margin-top: 7px;
  line-height: 1.55;
  font-size: 13.5px;
}

.cb-alloc {
  display: grid;
  gap: 12px;
}

.cb-alloc-row {
  display: grid;
  gap: 12px;
  padding: 14px;
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.cb-alloc-head {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cb-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

.cb-token {
  font-size: 16px;
  font-weight: 800;
}

.cb-delta {
  margin-left: auto;
  text-align: right;
}

.cb-delta b {
  display: block;
  font-size: 16px;
}

.cb-delta span {
  font-size: 12px;
  font-weight: 800;
}

.good {
  color: var(--green);
}

.watch {
  color: var(--yellow);
}

.risk {
  color: var(--orange);
}

.cb-bars {
  display: grid;
  gap: 8px;
}

.cb-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
}

.cb-bar span {
  display: block;
  height: 8px;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.85), rgba(153, 69, 255, 0.85));
  min-width: 2px;
}

.cb-bar em {
  margin-left: auto;
  font-style: normal;
}

.cb-bar.actual span {
  background: linear-gradient(90deg, rgba(255, 209, 35, 0.9), rgba(255, 81, 59, 0.92));
}

.cb-meta-row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  color: var(--muted);
  font-size: 12.5px;
}

.cb-action-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.cb-action-row button {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 14px;
  color: var(--text);
  cursor: pointer;
  font-family: inherit;
  font-weight: 800;
  min-height: 44px;
  padding: 11px 12px;
}

.cb-action-row button:hover,
.cb-mode:hover {
  border-color: var(--accent2);
}

.cb-shield-grid {
  display: grid;
  gap: 16px;
}

.cb-form-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.cb-field {
  display: grid;
  gap: 7px;
}

.cb-field > span {
  color: var(--muted);
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cb-field select,
.cb-field input {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 12px;
  color: var(--text);
  font-family: inherit;
  font-weight: 700;
  min-height: 42px;
  padding: 9px 10px;
  width: 100%;
}

.cb-amount {
  font-size: 18px;
}

.cb-slippage {
  width: 70px;
}

.cb-suffix {
  display: flex;
  align-items: center;
  gap: 7px;
}

.cb-suffix span {
  color: var(--muted);
  font-weight: 800;
}

.cb-mode-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.cb-mode {
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 13px;
  color: var(--muted);
  cursor: pointer;
  font-family: inherit;
  font-size: 13px;
  font-weight: 800;
  min-height: 44px;
  padding: 10px;
}

.cb-mode.active {
  border-color: var(--accent2);
  background: rgba(153, 69, 255, 0.14);
  color: var(--text);
}

.cb-primary {
  background: linear-gradient(90deg, var(--accent1), var(--accent2));
  border: 0;
  border-radius: 14px;
  color: #fff;
  cursor: pointer;
  font-family: inherit;
  font-size: 15px;
  font-weight: 900;
  min-height: 48px;
}

.cb-primary:disabled {
  opacity: 0.65;
}

.cb-error {
  color: #ff6b6b;
  font-size: 13px;
  line-height: 1.5;
}

.cb-routes {
  display: grid;
  gap: 10px;
}

.cb-route-card {
  display: grid;
  gap: 10px;
  padding: 14px;
  background: var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.cb-route-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.cb-route-top span {
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
}

.cb-flow {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.cb-flow span {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  padding: 5px 8px;
}

.cb-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.cb-metrics span {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  color: var(--muted);
  font-size: 12.5px;
  font-weight: 700;
  min-width: 0;
  overflow: hidden;
  padding: 8px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cb-hook-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.cb-hook {
  display: grid;
  gap: 9px;
  padding: 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  border-radius: 16px;
  min-width: 0;
}

.cb-hook-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.cb-hook-head em {
  color: var(--yellow);
  font-size: 11.5px;
  font-style: normal;
  font-weight: 800;
  text-align: right;
}

.cb-hook p {
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.5;
}

.cb-farm-feature {
  display: grid;
  gap: 14px;
  padding: 16px;
  background:
    radial-gradient(700px 320px at 35% 0%, rgba(59, 130, 246, 0.18), transparent 55%),
    var(--panel-2);
  border: 1px solid var(--border);
  border-radius: 18px;
}

.cb-farm-title {
