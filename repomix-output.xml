                decimals: 6,
                target_bps: 4000,
            },
        ],
        share_mint: Pubkey::new_unique(),
        total_shares: 100,
        minimum_locked_shares: 1,
        accounted_amounts: [90, 40],
        bootstrap_reserve: [5, 10],
