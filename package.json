{
  "name": "coloyond",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cli": "tsx src/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd apps/android && ./gradlew :app:assembleDebug --console=plain",
    "test:mobile": "node scripts/mobile/capture.mjs",
    "video:studio": "remotion studio remotion/index.tsx",
    "video:render": "remotion render remotion/index.tsx MobileShowcase remotion/out/coloyond-mobile.mp4 --codec=h264 --crf=18 --concurrency=2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@remotion/cli": "^4.0.356",
    "@remotion/renderer": "^4.0.356",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "remotion": "^4.0.356",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@magicblock-labs/ephemeral-rollups-sdk": "^0.16.2",
    "@noble/hashes": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solana-mobile/wallet-adapter-mobile": "^3.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "@symmetry-hq/sdk": "^1.0.23",
    "buffer": "^6.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
